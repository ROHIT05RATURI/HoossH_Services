@{
    ViewBag.Title = "Login";
    Layout = null; 
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - HoossH Services</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" rel="stylesheet" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

    <link rel="stylesheet" href="~/css/Login/Login.css" />
</head>
<body>

    <div class="login-card">
        <div class="login-header">
            <img src="~/Images/Login.jpg" alt="Hoossh Logo" class="login-logo">
            <h2> </h2>
        </div>

        <div id="errorMessage" class="alert alert-danger d-none mb-3">
            <i class="fa fa-exclamation-circle me-2"></i> <span id="errorText"></span>
        </div>

        <form id="loginForm">
            <div class="input-group-custom">
                <label for="userName" class="form-label">User Name</label>
                <div class="input-wrapper">
                    <input type="text" name="userName" id="userName" class="form-control" placeholder="Enter username" required />
                </div>
            </div>

            <div class="input-group-custom">
                <label for="password" class="form-label">Password</label>
                <div class="input-wrapper">
                    <input type="password" name="password" id="password" class="form-control" placeholder="Enter password" required />
                    <i class="fas fa-eye-slash toggle-password" id="toggleIcon"></i>
                </div>
                <!-- Added Forgot Password Link -->
                <a href="@Url.Action("ForgotPassword", "Home")" class="forgot-password-link">Forgot Password?</a>
            </div>

            <button type="submit" id="btnSubmit" class="btn-login"> 
                <span id="btnText">Log In</span>
            </button>
            <div class="social-links-container">
                <a href="@Url.Action("homeweb", "Web")" class="social-icon" title="Website">
                    <i class="fas fa-globe"></i>
                </a>
                <a href="#" class="social-icon" title="Instagram">
                    <i class="fab fa-instagram"></i>
                </a>
                <a href="#" class="social-icon" title="Facebook">
                    <i class="fab fa-facebook-f"></i>
                </a>
                <a href="#" class="social-icon" title="Twitter">
                    <i class="fab fa-x-twitter"></i>
                </a>
            </div>
        </form>
    </div>

    <div class="waves-container">
        <svg class="waves" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 24 150 28" preserveAspectRatio="none" shape-rendering="auto">
            <defs>
                <path id="gentle-wave" d="M-160 44c30 0 58-18 88-18s 58 18 88 18 58-18 88-18 58 18 88 18 v44h-352z" />
            </defs>
            <g class="parallax">
                <use xlink:href="#gentle-wave" x="48" y="0" />
                <use xlink:href="#gentle-wave" x="48" y="3" />
                <use xlink:href="#gentle-wave" x="48" y="5" />
                <use xlink:href="#gentle-wave" x="48" y="7" />
            </g>
        </svg>
    </div>

    <!-- Custom Premium Popups for Login -->

    <div id="customSuccessModal" class="custom-success-overlay">
        <div class="success-content-card animate__animated" id="successCard">
            <div class="success-icon-wrapper checkin">
                <i class="fas fa-check" id="successIcon"></i>
            </div>
            <h3 id="successTitle" class="success-title">Welcome Back! 🌟</h3>
            <p id="successTime" class="success-time">Signed in successfully</p>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <script>
        $(document).ready(function() {

            // 1. Password Visibility Logic
            $('#toggleIcon').on('click', function() {
                const passInput = $('#password');
                if (passInput.attr('type') === 'password') {
                    passInput.attr('type', 'text');
                    $(this).removeClass('fa-eye-slash').addClass('fa-eye');
                } else {
                    passInput.attr('type', 'password');
                    $(this).removeClass('fa-eye').addClass('fa-eye-slash');
                }
            });

            // 2. Your AJAX Login Logic
            $("#loginForm").on("submit", function(e) {
                e.preventDefault();

                // Reset UI
                $("#errorMessage").addClass("d-none");
                $("#btnSubmit").prop("disabled", true);
                $("#btnText").text("Authenticating...");

                const loginData = {
                    userName: $("#userName").val(),
                    password: $("#password").val()
                };

                $.ajax({
                    url: '@Url.Action("Login", "Login")',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify(loginData),
                    success: function(response) {
                        if (response.success) {
                            const successModal = document.getElementById("customSuccessModal");
                            const successCard = document.getElementById("successCard");

                            // Reset animations
                            successCard.classList.remove("animate__zoomIn", "animate__zoomOut");

                            // Show Success modal
                            successModal.classList.add("active");
                            successCard.classList.add("animate__zoomIn");

                            setTimeout(() => {
                                successCard.classList.remove("animate__zoomIn");
                                successCard.classList.add("animate__zoomOut");

                                setTimeout(() => {
                                    window.location.href = response.redirect;
                                }, 400);
                            }, 2000);
                        } else {
                            // Show error above credentials
                            $("#errorText").text(response.message);
                            $("#errorMessage").removeClass("d-none");

                            // Reset button
                            $("#btnSubmit").prop("disabled", false);
                            $("#btnText").text("Log In");
                        }
                    },
                    error: function() {
                        $("#errorText").text("An unexpected error occurred. Please try again.");
                        $("#errorMessage").removeClass("d-none");
                        $("#btnSubmit").prop("disabled", false);
                        $("#btnText").text("Log In");
                    }
                });
            });
        });
    </script>
</body>
</html>

