@{
    ViewBag.Title = "Attendance Dashboard";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<link rel="stylesheet" href="/css/HRMS.css">

<link rel="stylesheet" href="/Attendance/Attendance.css">


<div class="attendance-dashboard">

    <!-- =====================================================
         PAGE ACTIONS
         ===================================================== -->

    <div class="attendance-actions">

        <div class="attendance-action-left">

            <a href="/Team/Attendence"
               class="attendance-tab active">

                <i class="fas fa-plus-circle"></i>

                <span>Mark Attendance</span>

            </a>


            <a href="/Team/ViewAttendence"
               class="attendance-tab">

                <i class="fas fa-list-ul"></i>

                <span>Attendance History</span>

            </a>

        </div>


        <div class="attendance-page-status">

            <span class="attendance-status-dot"></span>

            <span>Attendance</span>

        </div>

    </div>



    <!-- =====================================================
         ATTENDANCE HERO
         ===================================================== -->

    <section class="attendance-hero">


        <!-- =================================================
             LEFT : GREETING + CHECK IN
             ================================================= -->

        <div class="hero-greeting">

            <div class="greeting-top">

                <div class="greeting-icon sun-icon">

                    <i class="fa-solid fa-sun"></i>

                </div>


                <div class="greeting-content">

                    <span class="hero-small-label">
                        DAILY ATTENDANCE
                    </span>


                    <h2 id="greetingText">
                        Good Morning!
                    </h2>


                    <p id="subGreeting">

                        <span id="status-desc">
                            Ready to start your day?
                        </span>

                    </p>

                </div>

            </div>



            <!-- CHECK IN / CHECK OUT -->

            <form id="attendanceForm">

                <input type="hidden"
                       name="Location"
                       id="location" />


                <div id="buttonContainer"
                     class="attendance-buttons">


                    <!-- CHECK IN -->
                    <!-- CHECK IN -->
                    <button type="button"
                            class="attendance-checkin-btn"
                            id="submitPresent"
                            onclick="openCustomPopup('Present')">

                        <span class="attendance-checkin-icon">
                            <i class="fas fa-sign-in-alt"></i>
                        </span>

                        <span class="attendance-checkin-text">
                            <strong>Check-In</strong>
                            <small>Start your workday</small>
                        </span>

                        <i class="fas fa-arrow-right attendance-checkin-arrow"></i>

                    </button>


                    <!-- CHECK OUT -->
                    <button type="button"
                            class="attendance-checkout-btn"
                            id="submitAbsent"
                            onclick="openCustomPopup('Checkout')"
                            style="display:none;">

                        <span class="attendance-checkout-icon">
                            <i class="fas fa-sign-out-alt"></i>
                        </span>

                        <span class="attendance-checkout-text">
                            <strong>Check-Out</strong>
                            <small>End your workday</small>
                        </span>

                        <i class="fas fa-arrow-right attendance-checkout-arrow"></i>

                    </button>

                </div>

            </form>

        </div>



        <!-- =================================================
             CENTER : VISUAL BANNER
             ================================================= -->

        <div class="attendance-visual">


            <!-- Decorative circles -->

            <div class="visual-circle visual-circle-one"></div>

            <div class="visual-circle visual-circle-two"></div>



            <!-- Clock -->

            <div class="visual-clock">

                <div class="clock-face">

                    <span class="clock-mark clock-mark-12"></span>
                    <span class="clock-mark clock-mark-3"></span>
                    <span class="clock-mark clock-mark-6"></span>
                    <span class="clock-mark clock-mark-9"></span>

                    <span class="clock-hand hour-hand"></span>

                    <span class="clock-hand minute-hand"></span>

                    <span class="clock-center"></span>

                </div>

            </div>



            <!-- Banner text -->

            <div class="visual-copy">

                <span class="visual-small-text">
                    TRACK YOUR
                </span>


                <strong>
                    Workday
                </strong>


                <strong class="visual-ease-text">
                    with Ease.
                </strong>


                <div class="visual-dots">

                    <span></span>
                    <span></span>
                    <span></span>

                </div>

            </div>



            <!-- Decorative plant -->

            <div class="visual-plant">

                <span class="leaf leaf-one"></span>

                <span class="leaf leaf-two"></span>

                <span class="leaf leaf-three"></span>

                <span class="leaf leaf-four"></span>

                <span class="leaf leaf-five"></span>

                <span class="leaf leaf-six"></span>

                <div class="plant-stem"></div>

                <div class="plant-pot"></div>

            </div>

        </div>



        <!-- =================================================
             RIGHT : TODAY + LIVE SHIFT
             ================================================= -->

        <div class="hero-info">


            <!-- TODAY -->

            <div class="today-card">

                <div class="today-icon calendar-color-icon">

                    <i class="fa-regular fa-calendar"></i>

                </div>


                <div class="today-details">

                    <span class="today-label">
                        TODAY
                    </span>


                    <div class="today-date">

                        @DateTime.Now.ToString("dddd, d MMM")

                    </div>

                </div>

            </div>



            <!-- LIVE SHIFT -->

            <div id="calendarTimerContainer"
                 class="today-card live-card"
                 style="display:none;">

                <div class="today-icon live-color-icon">

                    <i class="fa-solid fa-stopwatch"></i>

                </div>


                <div class="today-details">

                    <span class="today-label live-label">
                        LIVE SHIFT
                    </span>


                    <div id="workTimer"
                         class="today-date timer-value">

                        00:00:00

                    </div>

                </div>

            </div>

        </div>

    </section>



    <!-- =====================================================
         CALENDAR
         ===================================================== -->

    <section class="attendance-calendar-card">


        <!-- CALENDAR HEADER -->

        <div class="calendar-top">


            <div class="calendar-heading">

                <div class="calendar-heading-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>


                <div class="calendar-title">

                    <span class="calendar-overline">
                        ATTENDANCE RECORD
                    </span>


                    <h2 id="monthAndYear"></h2>

                </div>


                <div class="month-navigation">

                    <button type="button"
                            class="month-nav-btn"
                            onclick="previous()">

                        <i class="fas fa-chevron-left"></i>

                    </button>


                    <button type="button"
                            class="month-nav-btn"
                            onclick="next()">

                        <i class="fas fa-chevron-right"></i>

                    </button>

                </div>

            </div>



            <!-- =================================================
                 LEGEND
                 ================================================= -->

            <div class="attendance-legend">


                <div class="legend-item">

                    <span class="legend-dot present-approved"></span>

                    <span>Present / Approved</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot present-not-approved"></span>

                    <span>Present / Not Approved</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot absent"></span>

                    <span>Absent</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot weekend"></span>

                    <span>Weekend</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot leave"></span>

                    <span>Leave</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot working-leave"></span>

                    <span>Working on Leave</span>

                </div>


                <div class="legend-item">

                    <span class="legend-dot not-joined"></span>

                    <span>Not Joined</span>

                </div>

            </div>

        </div>



        <!-- =====================================================
             HIDDEN MONTH / YEAR SELECTS
             REQUIRED BY EXISTING Attendence.js
             ===================================================== -->

        <div style="display:none;" aria-hidden="true">

            <select id="month">

                @for (int i = 0; i < 12; i++)
                {
                    <option value="@i">@System.Globalization.DateTimeFormatInfo.CurrentInfo.GetMonthName(i + 1).Substring(0, 3)</option>
                }

            </select>

            <select id="year"></select>

        </div>



        <!-- =====================================================
             CALENDAR TABLE
             ===================================================== -->

        <div class="attendance-calendar-wrapper">

            <table class="table-calendar"
                   id="calendar">

                <thead id="thead-month"></thead>

                <tbody id="calendar-body"></tbody>

            </table>

        </div>

    </section>

</div>



<!-- =========================================================
     CUSTOM CHECK-IN / CHECK-OUT POPUP
     ========================================================= -->

<div id="customPopupModal"
     style="display:none"
     class="popup-modal-overlay">


    <div class="popup-content-card animate__animated bg-white p-4 rounded-4 shadow text-center"
         style="max-width:400px;width:90%;">


        <button type="button"
                class="btn-close ms-auto mb-2 d-block"
                onclick="closeCustomPopup()">
        </button>


        <div id="dynamicIcon"
             class="mb-3">
        </div>


        <h3 id="popupTitle"
            class="fw-bold">

            Ready to start?

        </h3>


        <p id="popupTime"
           class="text-muted">

            Time: <b>00:00 AM</b>

        </p>


        <p id="popupSubText"
           class="text-secondary small mb-3">

            Confirm to proceed

        </p>


        <button type="button"
                class="btn btn-primary w-100 rounded-pill py-2"
                onclick="confirmPopupAction()">

            Yes, Let's Go

        </button>

    </div>

</div>



<!-- =========================================================
     PAST ATTENDANCE POPUP
     ========================================================= -->

<div id="pastDatePopupModal"
     style="display:none"
     class="popup-modal-overlay">


    <div class="popup-content-card animate__animated bg-white p-4 rounded-4 shadow text-center"
         style="max-width:400px;width:90%;">


        <button type="button"
                class="btn-close ms-auto mb-2 d-block"
                onclick="closePastDatePopup()">
        </button>


        <div class="mb-3">

            <i class="fas fa-calendar-check fs-1 text-primary"></i>

        </div>


        <h3 class="fw-bold fs-5">
            Past Attendance
        </h3>


        <p id="pastDateDisplay"
           class="badge bg-info text-dark p-2 w-100 mb-3">
        </p>


        <div class="text-start mb-3">

            <label class="form-label small fw-bold text-muted">
                CHECK-IN TIME
            </label>


            <input type="time"
                   id="pastCheckInTime"
                   class="form-control form-control-lg font-monospace">

        </div>


        <input type="hidden"
               id="pastDateHiddenValue" />


        <button type="button"
                class="btn btn-primary w-100 rounded-pill py-2"
                onclick="submitPastAttendance()">

            Mark Present

        </button>

    </div>

</div>



<!-- =========================================================
     LOADER
     ========================================================= -->

<div id="customLoader"
     class="custom-loader-overlay"
     style="
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.5);
    z-index:9999;
    justify-content:center;
    align-items:center;
    flex-direction:column;
    ">


    <div class="spinner-border text-light mb-2"
         role="status">
    </div>


    <div class="loader-text text-white fw-semibold">

        Marking Attendance...

    </div>

</div>



<!-- =========================================================
     SUCCESS MODAL
     ========================================================= -->

<div id="customSuccessModal"
     class="custom-success-overlay"
     style="
    display:none;
    position:fixed;
    top:0;
    left:0;
    width:100%;
    height:100%;
    background:rgba(0,0,0,0.5);
    z-index:9999;
    justify-content:center;
    align-items:center;
    ">


    <div class="success-content-card animate__animated bg-white p-4 rounded-4 shadow text-center"
         style="max-width:350px;">


        <h3 id="successTitle"
            class="fw-bold text-success mb-1">

            Checked-In!

        </h3>


        <p id="successTime"
           class="text-muted small mb-0">

            Recorded successfully

        </p>

    </div>

</div>



<!-- =========================================================
     EXISTING ATTENDANCE SCRIPTS
     ========================================================= -->

<script>

    window.attendanceJoinDate = '@ViewBag.JoinDate';

</script>


<script src="/js/Attendence.js"></script>

<script src="/js/geolocation.js"></script>



<script>

    let currentAction = 'Present';

    let timerInterval;



    /* =====================================================
       CHECK-IN / CHECK-OUT POPUP
       ===================================================== */

    function openCustomPopup(action) {

        currentAction = action;

        const now = new Date();

        const currentTime =
            now.toLocaleTimeString([], {
                hour: '2-digit',
                minute: '2-digit'
            });


        document.getElementById("popupTime").innerHTML =
            `Time: <b>${currentTime}</b>`;


        if (action === "Present") {

            document.getElementById("popupTitle").innerText =
                "Ready to start?";

            document.getElementById("popupSubText").innerText =
                "Confirm your check-in.";

            document.getElementById("dynamicIcon").innerHTML =
                '<i class="fas fa-sign-in-alt fa-3x text-success"></i>';

        }
        else {

            document.getElementById("popupTitle").innerText =
                "Ready to finish?";

            document.getElementById("popupSubText").innerText =
                "Confirm your check-out.";

            document.getElementById("dynamicIcon").innerHTML =
                '<i class="fas fa-sign-out-alt fa-3x text-danger"></i>';

        }


        document.getElementById("customPopupModal").style.display =
            "flex";

    }



    function closeCustomPopup() {

        document.getElementById("customPopupModal").style.display =
            "none";

    }



    /* =====================================================
       CONFIRM ATTENDANCE
       ===================================================== */

    async function confirmPopupAction() {

        closeCustomPopup();


        const now = new Date();

        const loader =
            document.getElementById("customLoader");


        loader.style.display = "flex";


        try {

            const location =
                await GeoService.getLocation();


            const latLong =
                location.latitude +
                "," +
                location.longitude;


            const localISO =
                new Date(
                    now -
                    (now.getTimezoneOffset() * 60000)
                )
                    .toISOString()
                    .slice(0, 19);


            $.post(
                "/Team/MarkAttendence",
                {

                    Status: currentAction,

                    AttendenceDate: localISO,

                    location: latLong,

                    description:
                        "User " + currentAction

                },

                function () {

                    loader.style.display =
                        "none";


                    document.getElementById(
                        "customSuccessModal"
                    ).style.display =
                        "flex";


                    setTimeout(
                        () => window.location.reload(),
                        1500
                    );

                }
            );

        }
        catch (err) {

            loader.style.display =
                "none";


            Swal.fire(
                'GPS Required',
                'Please enable location access to mark attendance.',
                'warning'
            );

        }

    }



    /* =====================================================
       CALENDAR CLICK
       ===================================================== */

    document
        .getElementById('calendar-body')
        .addEventListener('click', function (e) {


            const cell =
                e.target.closest('td');


            if (!cell)
                return;


            if (
                cell.classList.contains('not-joined-bg') ||
                cell.classList.contains('empty-cell')
            )
                return;


            const day =
                cell.getAttribute('data-date');


            if (!day)
                return;


            const currentMonth =
                parseInt(
                    document.getElementById("month").value
                );


            const currentYear =
                parseInt(
                    document.getElementById("year").value
                );


            const clickedDate =
                new Date(
                    currentYear,
                    currentMonth,
                    parseInt(day)
                );


            const today =
                new Date();


            today.setHours(
                0,
                0,
                0,
                0
            );


            if (clickedDate < today) {

                openPastDatePopup(
                    clickedDate.toLocaleDateString(
                        'en-CA'
                    )
                );

            }

        });



    /* =====================================================
       PAST ATTENDANCE
       ===================================================== */

    function openPastDatePopup(dateStr) {

        document.getElementById(
            "pastDateDisplay"
        ).innerHTML =
            `Date: <b>${dateStr}</b>`;


        document.getElementById(
            "pastDateHiddenValue"
        ).value =
            dateStr;


        document.getElementById(
            "pastCheckInTime"
        ).value =
            "09:30";


        document.getElementById(
            "pastDatePopupModal"
        ).style.display =
            "flex";

    }



    function closePastDatePopup() {

        document.getElementById(
            "pastDatePopupModal"
        ).style.display =
            "none";

    }



    async function submitPastAttendance() {

        const dateStr =
            document.getElementById(
                "pastDateHiddenValue"
            ).value;


        const timeStr =
            document.getElementById(
                "pastCheckInTime"
            ).value;


        if (!timeStr)
            return;


        closePastDatePopup();


        const localISO =
            `${dateStr}T${timeStr}:00`;


        $.post(
            "/Team/MarkAttendence",
            {

                Status: "Present",

                AttendenceDate: localISO,

                location: "Manual Entry",

                description: "Past Attendance"

            },
            function () {

                window.location.reload();

            }
        );

    }

</script>