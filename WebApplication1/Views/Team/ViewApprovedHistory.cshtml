<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script>
    function toggleDetails(el) {
        const card = $(el).closest('.record-card');
        $('.record-card').not(card).removeClass('open-row').find('.card-body-table').slideUp(200);
        card.toggleClass('open-row');
        card.find('.card-body-table').slideToggle(200);
    }

    $(document).ready(function() {
        // State variables jo toolbar se aayengi
        let activeSearch = '';
        let activeStatus = 'all';
        let activeFromDate = '';
        let activeToDate = '';

        function applyClientSideFilters() {
            var searchText = activeSearch.toLowerCase();
            var statusFilter = activeStatus.toLowerCase();
            var fromDate = activeFromDate;
            var toDate = activeToDate;

            $('.group-card').each(function() {
                var $card = $(this);
                var empName = $card.data('name') || "";
                var hasVisibleRows = false;
                var visibleCount = 0;

                $card.find('.leave-row').each(function() {
                    var $row = $(this);
                    var leaveType = $row.find('td[data-label="Leave Type"]').text().toLowerCase();
                    var status = $row.find('.status-pill').text().toLowerCase().trim();
                    var rowDate = $row.data('date');

                    var matchesSearch = searchText === "" || (empName.indexOf(searchText) > -1) || (leaveType.indexOf(searchText) > -1);
                    var matchesStatus = (statusFilter === 'all' || status === statusFilter);

                    var matchesDate = true;
                    if (fromDate && rowDate < fromDate) matchesDate = false;
                    if (toDate && rowDate > toDate) matchesDate = false;

                    if (matchesSearch && matchesStatus && matchesDate) {
                        $row.show();
                        hasVisibleRows = true;
                        visibleCount++;
                    } else {
                        $row.hide();
                    }
                });

                $card.find('.total-number').text(visibleCount);

                if (hasVisibleRows) {
                    $card.show();
                } else {
                    $card.hide();
                }
            });
        }

        // _DataToolbar2 ke custom event ko listen karna
        $(document).off('onToolbarChange').on('onToolbarChange', function(event, state) {
            if (state) {
                if (state.search !== undefined) activeSearch = state.search;
                if (state.status !== undefined) activeStatus = state.status;

                // Agar toolbar custom date fields ya HTML bhej raha hai toh unhe yahan uthayein
                activeFromDate = $('input[name="fromDate"]').val() || '';
                activeToDate = $('input[name="toDate"]').val() || '';

                applyClientSideFilters();
            }
        });

        // Date fields ke manually change hone par bhi filter chale
        $(document).on('change', 'input[type="date"]', function() {
            activeFromDate = $('input[name="fromDate"]').val() || '';
            activeToDate = $('input[name="toDate"]').val() || '';
            applyClientSideFilters();
        });
    });
</script>