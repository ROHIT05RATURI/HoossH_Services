<script>
    function showDayDetails(dateStr, status, inTime, outTime) {
        if (!status) status = "Not Marked";
        if (!inTime) inTime = "--:--";
        if (!outTime) outTime = "--:--";

        let headerBg = "linear-gradient(to right, #94a3b8, #cbd5e1)";
        let icon = "fa-calendar-day";

        if (status === "Present" || status === "Pending") {
            headerBg = "linear-gradient(to right, #52a762, #68c078)";
            if (status === "Pending") headerBg = "linear-gradient(to right, #eeba75, #facd8a)";
            icon = "fa-check-circle";
        } else if (status === "Absent") {
            headerBg = "linear-gradient(to right, #ef4444, #f87171)";
            icon = "fa-times-circle";
        } else if (status === "Leave" || status === "Week Off") {
            headerBg = "linear-gradient(to right, #8bbbe3, #72aae0)";
            icon = "fa-bed";
        } else if (status === "Working on Leave") {
            headerBg = "linear-gradient(to right, #a855f7, #c084fc)";
            icon = "fa-briefcase";
        }

        let d = new Date(dateStr);
        let displayDate = d.toLocaleDateString('en-US', {
            weekday: 'long', year: 'numeric', month: 'long', day: 'numeric'
        });

        let actionFormHtml = "";
        let today = new Date();
        today.setHours(0, 0, 0, 0);

        let joinDateStr = '@ViewBag.JoinDate';
        let joinDate = new Date(joinDateStr);
        joinDate.setHours(0, 0, 0, 0);

        if ((status === "Absent" || status === "Not Marked" || status === "Leave") && d <= today && d.getDay() !== 0 && d >= joinDate) {
            actionFormHtml = `
                        <div style="padding: 0 20px 20px;">
                            <hr style="border: 0; height: 1px; background: #e2e8f0; margin-bottom: 15px;">
                            <label style="font-size: 0.75rem; font-weight: 800; color: #475569; margin-bottom: 6px; display: block;">CHECK-IN TIME</label>
                            <input type="time" id="manualCheckInTime" value="09:30" style="width: 100%; padding: 12px 15px; border-radius: 8px; border: 1px solid #cbd5e1; font-family: 'Courier New', monospace; font-weight: 700; font-size: 1rem; color: #1e293b; background: #f8fafc; outline: none; margin-bottom: 15px;">
                            <button onclick="submitManualAttendance('${dateStr}')" style="width: 100%; background: #3b5982; color: white; border: none; padding: 12px; border-radius: 8px; font-weight: 700; font-size: 13px; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 8px;">
                                <i class="fas fa-check-circle"></i> MARK PRESENT
                            </button>
                        </div>
                    `;
        }

        let htmlContent = `
                    <div class="premium-day-card">
                        <div class="pdc-header" style="background: ${headerBg}; text-align: left;">
                            <h4 style="margin: 0; font-weight: 800; font-size: 18px;">${displayDate}</h4>
                            <p style="margin: 4px 0 0; opacity: 0.9; font-size: 14px; font-weight: 700;">
                                <i class="fas ${icon} me-1"></i> ${status}
                            </p>
                        </div>
                        <div class="pdc-body" style="padding-top: 15px;">
                            <div class="pdc-row">
                                <div style="display: flex; align-items: center;">
                                    <div class="pdc-icon-box" style="background: #ebf4fa; color: #0b5ed7;">
                                        <i class="fas fa-sign-in-alt"></i>
                                    </div>
                                    <div>
                                        <h6 style="margin: 0; font-weight: 700; color: #1e293b; font-size: 13px;">In Time</h6>
                                        <span style="font-size: 11px; color: #64748b; font-weight: 600;">Punch In</span>
                                    </div>
                                </div>
                                <div style="font-weight: 800; color: #0f172a; font-size: 13px;">${inTime}</div>
                            </div>
                            <div class="pdc-row" style="margin-bottom: 0;">
                                <div style="display: flex; align-items: center;">
                                    <div class="pdc-icon-box" style="background: #fee2e2; color: #dc2626;">
                                        <i class="fas fa-sign-out-alt"></i>
                                    </div>
                                    <div>
                                        <h6 style="margin: 0; font-weight: 700; color: #1e293b; font-size: 13px;">Out Time</h6>
                                        <span style="font-size: 11px; color: #64748b; font-weight: 600;">Punch Out</span>
                                    </div>
                                </div>
                                <div style="font-weight: 800; color: #0f172a; font-size: 13px;">${outTime}</div>
                            </div>
                        </div>
                        ${actionFormHtml}
                    </div>
                `;

        Swal.fire({
            html: htmlContent,
            showConfirmButton: false,
            showCloseButton: true,
            customClass: {
                popup: 'swal-premium-popup'
            }
        });
    }
    function applyWeekoffs() {
        const rows = document.querySelectorAll('.table-calendar tbody tr');
        rows.forEach(row => {
            const sundayCell = row.cells[0];

            if (sundayCell &&
                !sundayCell.classList.contains('empty-cell') &&
                !sundayCell.classList.contains('present-approved-bg') &&
                !sundayCell.classList.contains('present-not-approved-bg') &&
                !sundayCell.classList.contains('absent-bg') &&
                !sundayCell.classList.contains('leave-bg') &&
                !sundayCell.classList.contains('working-leave-bg')) {

                sundayCell.classList.add('weekend-bg');

                const timeSpan = sundayCell.querySelector('.attendance-time');
                if (!timeSpan) {
                    const span = document.createElement('span');
                    span.className = 'attendance-time';
                    span.innerText = 'Week Off';
                    sundayCell.appendChild(span);
                }
            }
        });
    }

    document.addEventListener("DOMContentLoaded", applyWeekoffs);

    function submitManualAttendance(dateStr) {
        let timeStr = document.getElementById("manualCheckInTime").value;
        if (!timeStr) {
            Swal.fire({
                title: 'Time Missing',
                text: 'Please select a valid time.',
                icon: 'warning'
            });
            return;
        }

        let dateTimeString = `${dateStr}T${timeStr}:00`;
        let pastDateTime = new Date(dateTimeString);
        let localISO = new Date(pastDateTime - (pastDateTime.getTimezoneOffset() * 60000)).toISOString().slice(0, 19);

        Swal.fire({
            title: 'Updating...',
            allowOutsideClick: false,
            didOpen: () => {
                Swal.showLoading();
            }
        });

        $.post("/Team/MarkAttendence", {
            Status: "Present",
            AttendenceDate: localISO,
            location: "Manual Entry",
            description: "Past Attendance Manual Entry"
        }, function () {
            Swal.fire({
                title: 'Updated!',
                text: 'Attendance has been recorded.',
                icon: 'success',
                timer: 2000,
                showConfirmButton: false
            }).then(() => {
                window.location.reload();
            });
        }).fail(function () {
            Swal.fire('Error', 'Failed to update attendance', 'error');
        });
    }

    function navigateMonth(offset) {

        let monthSelect = document.getElementById('selectedMonth');
        let yearInput = document.getElementById('selectedYear');

        let currentMonth = parseInt(monthSelect.value);
        let currentYear = parseInt(yearInput.value);

        let joinDateStr = '@ViewBag.JoinDate';
        let joinDate = new Date(joinDateStr);
        let joinMonth = joinDate.getMonth() + 1; // 1-12
        let joinYear = joinDate.getFullYear();

        currentMonth += offset;

       
        if (currentMonth > 12) {
            currentMonth = 1;
            currentYear++;
        }

        else if (currentMonth < 1) {
            currentMonth = 12;
            currentYear--;
        }

        if (currentYear < joinYear || (currentYear === joinYear && currentMonth < joinMonth)) {
            // Do not navigate before joining month
            return;
        }

        
        monthSelect.value = currentMonth;
        yearInput.value = currentYear;

        document.getElementById('filterForm').submit();
    }
</script>
