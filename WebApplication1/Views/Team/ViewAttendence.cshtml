@{
    ViewBag.Title = "Attendance Tracker";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
}

@{
    int selectedMonth;
    int selectedYear;

    if (!int.TryParse(Context.Request.Query["selectedMonth"], out selectedMonth) ||
        selectedMonth < 1 ||
        selectedMonth > 12)
    {
        selectedMonth = DateTime.Today.Month;
    }

    if (!int.TryParse(Context.Request.Query["year"], out selectedYear) ||
        selectedYear < 1)
    {
        selectedYear = DateTime.Today.Year;
    }

    var daysInMonth = DateTime.DaysInMonth(selectedYear, selectedMonth);
    var firstOfMonth = new DateTime(selectedYear, selectedMonth, 1);
    int startDayOfWeek = (int)firstOfMonth.DayOfWeek; 
    int totalRows = (int)Math.Ceiling((startDayOfWeek + daysInMonth) / 7.0);
}

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<link rel="stylesheet" href="/css/HRMS.css">
<link rel="stylesheet" href="/Attendance/Attendance.css">

<div class="attendance-dashboard attendance-tracker-page">

    <!-- =====================================================
         PAGE ACTIONS
         ===================================================== -->

    <div class="attendance-actions">

        <div class="attendance-action-left">

            <a href="/Team/Attendence"
               class="attendance-tab">

                <i class="fas fa-plus-circle"></i>

                <span>Mark Attendance</span>

            </a>

            <a href="/Team/ViewAttendence"
               class="attendance-tab active">

                <i class="fas fa-list-ul"></i>

                <span>Attendance History</span>

            </a>

        </div>

        <div class="attendance-page-status">

            <span class="attendance-status-dot"></span>

            <span>Attendance History</span>

        </div>

    </div>


    <!-- =====================================================
         MONTH / YEAR HEADER
         ===================================================== -->

    <section class="tracker-header-card">

        <div class="tracker-header-left">

            <div class="tracker-header-icon">

                <i class="fa-solid fa-calendar-days"></i>

            </div>

            <div class="tracker-header-content">

                <span class="tracker-overline">
                    ATTENDANCE OVERVIEW
                </span>

                <h1>
                    Attendance Tracker
                </h1>

                <p>
                    Review your attendance, leaves and working days.
                </p>

            </div>

        </div>


        <div class="tracker-month-control">

            <button type="button"
                    class="month-nav-btn"
                    onclick="navigateMonth(-1)"
                    aria-label="Previous month">

                <i class="fas fa-chevron-left"></i>

            </button>

            <div class="tracker-month-display">

                <span>
                    @firstOfMonth.ToString("MMMM")
                </span>

                <strong>
                    @selectedYear
                </strong>

            </div>

            <button type="button"
                    class="month-nav-btn"
                    onclick="navigateMonth(1)"
                    aria-label="Next month">

                <i class="fas fa-chevron-right"></i>

            </button>

        </div>

    </section>


    <!-- =====================================================
         HIDDEN FILTER FORM
         ===================================================== -->

    <form method="get"
          id="filterForm"
          class="tracker-hidden-form">

        <input type="hidden"
               name="selectedMonth"
               id="selectedMonth"
               value="@selectedMonth" />

        <input type="hidden"
               name="year"
               id="selectedYear"
               value="@selectedYear" />

    </form>


    <!-- =====================================================
         STATISTICS
         ===================================================== -->

    <section class="attendance-stats-grid">

        <!-- TOTAL DAYS -->

        <div class="attendance-stat-card">

            <div class="attendance-stat-icon total-icon">

                <i class="fas fa-calendar-day"></i>

            </div>

            <div class="attendance-stat-content">

                <span class="attendance-stat-label">
                    TOTAL DAYS
                </span>

                <h3 id="totalDaysCount">
                    @daysInMonth
                </h3>

                <p>
                    Days in selected month
                </p>

            </div>

        </div>


        <!-- PRESENT -->

        <div class="attendance-stat-card">

            <div class="attendance-stat-icon present-icon">

                <i class="fas fa-check"></i>

            </div>

            <div class="attendance-stat-content">

                <span class="attendance-stat-label">
                    PRESENT
                </span>

                <h3 id="presentCount">
                    0
                </h3>

                <p>
                    Days marked present
                </p>

            </div>

        </div>


        <!-- LEAVE -->

        <div class="attendance-stat-card">

            <div class="attendance-stat-icon leave-icon">

                <i class="fas fa-person-walking"></i>

            </div>

            <div class="attendance-stat-content">

                <span class="attendance-stat-label">
                    LEAVES
                </span>

                <h3 id="leaveCount">
                    0
                </h3>

                <p>
                    Approved or recorded leave
                </p>

            </div>

        </div>


        <!-- ABSENT -->

        <div class="attendance-stat-card">

            <div class="attendance-stat-icon absent-icon">

                <i class="fas fa-times"></i>

            </div>

            <div class="attendance-stat-content">

                <span class="attendance-stat-label">
                    ABSENT
                </span>

                <h3 id="absentCount">
                    0
                </h3>

                <p>
                    Days marked absent
                </p>

            </div>

        </div>


        <!-- WEEK OFF -->

        <div class="attendance-stat-card">

            <div class="attendance-stat-icon weekoff-icon">

                <i class="fas fa-bed"></i>

            </div>

            <div class="attendance-stat-content">

                <span class="attendance-stat-label">
                    WEEK OFF
                </span>

                <h3 id="weekoffCount">
                    0
                </h3>

                <p>
                    Scheduled Sundays
                </p>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CALENDAR CARD
         ===================================================== -->

    <section class="attendance-calendar-card tracker-calendar-card">

        <!-- CALENDAR HEADER -->

        <div class="calendar-top tracker-calendar-top">

            <div class="calendar-heading">

                <div class="calendar-heading-icon">

                    <i class="fa-solid fa-calendar-days"></i>

                </div>

                <div class="calendar-title">

                    <span class="calendar-overline">
                        ATTENDANCE RECORD
                    </span>

                    <h2>
                        @firstOfMonth.ToString("MMMM yyyy")
                    </h2>

                </div>

            </div>


            <!-- MONTH NAVIGATION -->

            <div class="tracker-header-navigation">

                <button type="button"
                        class="month-nav-btn"
                        onclick="navigateMonth(-1)"
                        aria-label="Previous month">

                    <i class="fas fa-chevron-left"></i>

                </button>

                <button type="button"
                        class="month-nav-btn"
                        onclick="navigateMonth(1)"
                        aria-label="Next month">

                    <i class="fas fa-chevron-right"></i>

                </button>

            </div>

        </div>


        <!-- =================================================
             CALENDAR
             ================================================= -->

        <div class="attendance-calendar-wrapper">

            <table class="table-calendar tracker-calendar"
                   id="calendar">

                <thead>

                    <tr>

                        <th>Sun</th>
                        <th>Mon</th>
                        <th>Tue</th>
                        <th>Wed</th>
                        <th>Thu</th>
                        <th>Fri</th>
                        <th>Sat</th>

                    </tr>

                </thead>

                <tbody>

                    @{
                        int currentDay = 1;

                        for (int r = 0; r < totalRows; r++)
                        {
                            <tr>

                                @for (int c = 0; c < 7; c++)
                                {
                                    if ((r == 0 && c < startDayOfWeek) ||
                                        currentDay > daysInMonth)
                                    {
                                        <td class="empty-cell"></td>
                                    }
                                    else
                                    {
                                        var loopDate =
                                            new DateTime(
                                                selectedYear,
                                                selectedMonth,
                                                currentDay
                                            );

                                        var loopDateOnly =
                                            DateOnly.FromDateTime(loopDate);

                                        var attendances =
                                            Model?.Attendances as System.Collections.IEnumerable;

                                        dynamic record = null;

                                        if (attendances != null)
                                        {
                                            foreach (dynamic a in attendances)
                                            {
                                                try
                                                {
                                                    DateOnly ad;

                                                    if (a.AttendanceDate is DateOnly)
                                                    {
                                                        ad = a.AttendanceDate;
                                                    }
                                                    else if (a.AttendanceDate is DateTime)
                                                    {
                                                        ad = DateOnly.FromDateTime(
                                                            a.AttendanceDate
                                                        );
                                                    }
                                                    else
                                                    {
                                                        continue;
                                                    }

                                                    if (ad == loopDateOnly)
                                                    {
                                                        record = a;
                                                        break;
                                                    }
                                                }
                                                catch
                                                {
                                                }
                                            }
                                        }


                                        string bgClass = "";
                                        string timeStr = "";
                                        string displayStatus = "";
                                        bool isSunday = (c == 0);
                                        bool showRedDot = false;


                                        var joinDateStr =
                                            ViewBag.JoinDate as string;

                                        var joinDate =
                                            string.IsNullOrEmpty(joinDateStr)
                                                ? DateTime.MinValue
                                                : DateTime.Parse(joinDateStr);


                                        if (loopDate.Date < joinDate.Date)
                                        {
                                            bgClass = "not-joined-bg";
                                            displayStatus = "Not Joined";
                                        }
                                        else if (record != null)
                                        {
                                            if (record.ManagerStatus == "Present")
                                            {
                                                bgClass = "present-approved-bg";
                                                timeStr = record.CheckinTime;
                                                displayStatus = "Present";
                                            }
                                            else if (record.ManagerStatus == "Pending")
                                            {
                                                bgClass = "present-not-approved-bg";
                                                timeStr = record.CheckinTime;
                                                displayStatus = "Pending";
                                            }
                                            else if (record.ManagerStatus == "Absent")
                                            {
                                                bgClass = "absent-bg";
                                                displayStatus = "Absent";
                                                showRedDot = true;
                                            }
                                            else if (record.ManagerStatus == "Leave")
                                            {
                                                bgClass = "leave-bg";
                                                displayStatus = "Leave";
                                            }
                                            else if (record.ManagerStatus == "Working on Leave")
                                            {
                                                bgClass = "working-leave-bg";
                                                timeStr = record.CheckinTime;
                                                displayStatus = "Working on Leave";
                                            }
                                        }
                                        else if (isSunday)
                                        {
                                            bgClass = "weekend-bg";
                                            displayStatus = "Week Off";
                                        }
                                        else if (loopDate.Date <= DateTime.Today)
                                        {
                                            bgClass = "absent-bg";
                                            displayStatus = "Absent";
                                            showRedDot = true;
                                        }


                                        bool isToday =
                                            loopDate.Date == DateTime.Today;

                                        string todayClass =
                                            isToday
                                                ? "today-highlight"
                                                : "";


                                        if (displayStatus == "Not Joined")
                                        {
                                            <td class="@bgClass @todayClass">

                                                <span class="c-day-num">
                                                    @currentDay
                                                </span>

                                                <span class="calendar-status-text">
                                                    Not Joined
                                                </span>

                                            </td>
                                        }
                                        else
                                        {
                                            <td class="@bgClass @todayClass"
                                                onclick="showDayDetails(
                                                '@loopDate.ToString("yyyy-MM-dd")',
                                                '@displayStatus',
                                                '@timeStr',
                                                '@(record?.CheckOutTime ?? "")'
                                                )">

                                                <span class="c-day-num">
                                                    @currentDay
                                                </span>


                                                @if (!string.IsNullOrEmpty(timeStr))
                                                {
                                                    <span class="attendance-time">
                                                        @timeStr
                                                    </span>
                                                }


                                                @if (displayStatus == "Week Off")
                                                {
                                                    <span class="calendar-status-text">
                                                        Week Off
                                                    </span>
                                                }


                                                @if (showRedDot &&
                                                     string.IsNullOrEmpty(timeStr) &&
                                                     !isSunday)
                                                {
                                                    <div class="red-dot-indicator"></div>
                                                }

                                            </td>
                                        }

                                        currentDay++;
                                    }
                                }

                            </tr>
                        }
                    }

                </tbody>

            </table>

        </div>


        <!-- =================================================
             LEGEND
             ================================================= -->

        <div class="attendance-legend tracker-legend">

            <div class="legend-item">

                <span class="legend-dot present-approved"></span>

                <span>Present / Approved</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot present-not-approved"></span>

                <span>Present / Not Approved</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot absent"></span>

                <span>Absent</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot weekend"></span>

                <span>Weekend</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot leave"></span>

                <span>Leave</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot working-leave"></span>

                <span>Working on Leave</span>

            </div>


            <div class="legend-item">

                <span class="legend-dot not-joined"></span>

                <span>Not Joined</span>

            </div>

        </div>

    </section>

</div>


<!-- =========================================================
     DAY DETAILS
     ========================================================= -->

<script>

    function showDayDetails(dateStr, status, inTime, outTime) {

        if (!status)
            status = "Not Marked";

        if (!inTime)
            inTime = "--:--";

        if (!outTime)
            outTime = "--:--";


        let headerBg =
            "linear-gradient(135deg, #378da6, #287e98)";

        let icon =
            "fa-calendar-day";


        if (status === "Present" || status === "Pending") {

            headerBg =
                "linear-gradient(135deg, #10b947, #35d86c)";

            icon =
                "fa-check-circle";


            if (status === "Pending") {

                headerBg =
                    "linear-gradient(135deg, #e29a2f, #f5c76a)";

            }

        }
        else if (status === "Absent") {

            headerBg =
                "linear-gradient(135deg, #ff4545, #ff7070)";

            icon =
                "fa-times-circle";

        }
        else if (status === "Leave" || status === "Week Off") {

            headerBg =
                "linear-gradient(135deg, #7186d8, #91a6ef)";

            icon =
                status === "Leave"
                    ? "fa-person-walking"
                    : "fa-bed";

        }
        else if (status === "Working on Leave") {

            headerBg =
                "linear-gradient(135deg, #8b5cf6, #b18af8)";

            icon =
                "fa-briefcase";

        }


        let d =
            new Date(dateStr);


        let displayDate =
            d.toLocaleDateString(
                'en-US',
                {
                    weekday: 'long',
                    year: 'numeric',
                    month: 'long',
                    day: 'numeric'
                }
            );


        let actionFormHtml = "";


        let today =
            new Date();

        today.setHours(
            0,
            0,
            0,
            0
        );


        let joinDateStr =
            '@ViewBag.JoinDate';

        let joinDate =
            new Date(joinDateStr);

        joinDate.setHours(
            0,
            0,
            0,
            0
        );


        if (
            (
                status === "Absent" ||
                status === "Not Marked" ||
                status === "Leave"
            ) &&
            d <= today &&
            d.getDay() !== 0 &&
            d >= joinDate
        ) {

            actionFormHtml = `

                    <div class="manual-attendance-section">

                        <div class="manual-section-divider"></div>

                        <label class="manual-label">
                            CHECK-IN TIME
                        </label>

                        <input
                            type="time"
                            id="manualCheckInTime"
                            value="09:30"
                            class="manual-time-input"
                        >

                        <button
                            onclick="submitManualAttendance('${dateStr}')"
                            class="manual-attendance-button">

                            <i class="fas fa-check-circle"></i>

                            MARK PRESENT

                        </button>

                    </div>

                `;

        }


        let htmlContent = `

                <div class="premium-day-card">

                    <div
                        class="pdc-header"
                        style="background:${headerBg};"
                    >

                        <div class="pdc-header-content">

                            <span class="pdc-date">
                                ${displayDate}
                            </span>

                            <span class="pdc-status">

                                <i class="fas ${icon}"></i>

                                ${status}

                            </span>

                        </div>

                    </div>


                    <div class="pdc-body">

                        <div class="pdc-row">

                            <div class="pdc-row-left">

                                <div class="pdc-icon-box pdc-in-icon">

                                    <i class="fas fa-sign-in-alt"></i>

                                </div>

                                <div>

                                    <h6>
                                        In Time
                                    </h6>

                                    <span>
                                        Punch In
                                    </span>

                                </div>

                            </div>


                            <div class="pdc-time">
                                ${inTime}
                            </div>

                        </div>


                        <div class="pdc-row">

                            <div class="pdc-row-left">

                                <div class="pdc-icon-box pdc-out-icon">

                                    <i class="fas fa-sign-out-alt"></i>

                                </div>

                                <div>

                                    <h6>
                                        Out Time
                                    </h6>

                                    <span>
                                        Punch Out
                                    </span>

                                </div>

                            </div>


                            <div class="pdc-time">
                                ${outTime}
                            </div>

                        </div>

                    </div>


                    ${actionFormHtml}

                </div>

            `;


        Swal.fire({

            html: htmlContent,

            showConfirmButton: false,

            showCloseButton: true,

            customClass: {

                popup:
                    'swal-premium-popup'

            },

            buttonsStyling: false

        });

    }


    /* =====================================================
       MANUAL ATTENDANCE
       ===================================================== */

    function submitManualAttendance(dateStr) {

        let timeStr =
            document.getElementById(
                "manualCheckInTime"
            ).value;


        if (!timeStr) {

            Swal.fire({

                title: 'Time Missing',

                text:
                    'Please select a valid time.',

                icon: 'warning'

            });

            return;

        }


        let dateTimeString =
            `${dateStr}T${timeStr}:00`;


        let pastDateTime =
            new Date(dateTimeString);


        let localISO =
            new Date(
                pastDateTime -
                (
                    pastDateTime.getTimezoneOffset() *
                    60000
                )
            )
                .toISOString()
                .slice(0, 19);


        Swal.fire({

            title: 'Updating...',

            allowOutsideClick: false,

            didOpen: () => {

                Swal.showLoading();

            }

        });


        $.post(
            "/Team/MarkAttendence",
            {

                Status: "Present",

                AttendenceDate: localISO,

                location: "Manual Entry",

                description:
                    "Past Attendance Manual Entry"

            },

            function() {

                Swal.fire({

                    title: 'Updated!',

                    text:
                        'Attendance has been recorded.',

                    icon: 'success',

                    timer: 2000,

                    showConfirmButton: false

                }).then(() => {

                    window.location.reload();

                });

            }

        ).fail(function() {

            Swal.fire(
                'Error',
                'Failed to update attendance',
                'error'
            );

        });

    }


    /* =====================================================
       MONTH NAVIGATION
       ===================================================== */

    function navigateMonth(offset) {

        let monthSelect =
            document.getElementById(
                'selectedMonth'
            );


        let yearInput =
            document.getElementById(
                'selectedYear'
            );


        let currentMonth =
            parseInt(
                monthSelect.value
            );


        let currentYear =
            parseInt(
                yearInput.value
            );


        let joinDateStr =
            '@ViewBag.JoinDate';


        let joinDate =
            new Date(joinDateStr);


        let joinMonth =
            joinDate.getMonth() + 1;


        let joinYear =
            joinDate.getFullYear();


        currentMonth += offset;


        if (currentMonth > 12) {

            currentMonth = 1;

            currentYear++;

        }
        else if (currentMonth < 1) {

            currentMonth = 12;

            currentYear--;

        }


        if (
            currentYear < joinYear ||
            (
                currentYear === joinYear &&
                currentMonth < joinMonth
            )
        ) {

            return;

        }


        monthSelect.value =
            currentMonth;


        yearInput.value =
            currentYear;


        document
            .getElementById(
                'filterForm'
            )
            .submit();

    }


    /* =====================================================
       CALENDAR STATISTICS
       ===================================================== */

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            calculateAttendanceStats();

        }
    );


    function calculateAttendanceStats() {

        const calendar =
            document.getElementById(
                "calendar"
            );


        if (!calendar)
            return;


        let present = 0;
        let leaves = 0;
        let absent = 0;
        let weekoffs = 0;


        const cells =
            calendar.querySelectorAll(
                "tbody td"
            );


        cells.forEach(function(cell) {

            if (
                cell.classList.contains(
                    "empty-cell"
                )
            ) {
                return;
            }


            if (
                cell.classList.contains(
                    "not-joined-bg"
                )
            ) {
                return;
            }


            if (
                cell.classList.contains(
                    "present-approved-bg"
                ) ||
                cell.classList.contains(
                    "present-not-approved-bg"
                ) ||
                cell.classList.contains(
                    "working-leave-bg"
                )
            ) {

                present++;

            }
            else if (
                cell.classList.contains(
                    "leave-bg"
                )
            ) {

                leaves++;

            }
            else if (
                cell.classList.contains(
                    "absent-bg"
                )
            ) {

                absent++;

            }
            else if (
                cell.classList.contains(
                    "weekend-bg"
                )
            ) {

                weekoffs++;

            }

        });


        const presentElement =
            document.getElementById(
                "presentCount"
            );


        const leaveElement =
            document.getElementById(
                "leaveCount"
            );


        const absentElement =
            document.getElementById(
                "absentCount"
            );


        const weekoffElement =
            document.getElementById(
                "weekoffCount"
            );


        if (presentElement)
            presentElement.textContent = present;


        if (leaveElement)
            leaveElement.textContent = leaves;


        if (absentElement)
            absentElement.textContent = absent;


        if (weekoffElement)
            weekoffElement.textContent = weekoffs;

    }

</script>