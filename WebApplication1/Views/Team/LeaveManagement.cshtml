            <div class="form-row-custom">
                <div class="input-group-custom">
                    <label>Type of Leave</label>
                    <select class="modern-input" id="LeaveType" name="LeaveType" required>
                        <option value="">Choose leave type...</option>
                        @* @foreach (var leave in Model.LeaveTypes)
                        {
                            <option value="@leave.LeaveId">@leave.Name (Remaining Days = @leave.RemainingDays)</option>
                        } *@
                    </select>
                </div>
                <div class="input-group-custom">
                    <label>Start Date</label>
                    <input type="date" name="StartDate" class="modern-input" required />
                </div>
                <div class="input-group-custom">
                    <label>End Date</label>
                    <input type="date" name="EndDate" class="modern-input" required />
                </div>
                <div class="input-group-custom">
                    <label>Attachment (image/document)</label>
                    <input type="file" name="Lmg" accept="image/*,.pdf,.doc,.docx" class="modern-input" />
                </div>
            </div>
            <div class="submit-btn-wrap">
                <button type="submit" class="btn-grad">
                    Submit Request
                </button>
            </div>
        </form>
    </div>

