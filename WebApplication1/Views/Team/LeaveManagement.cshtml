@* @await Html.PartialAsync("_PremiumAlerts")
@await Html.PartialAsync("_PremiumConfirm") *@

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const currentPath = window.location.pathname.toLowerCase();
        document.querySelectorAll(".navbarmid .tab").forEach(tab => {
            if (currentPath.includes(tab.getAttribute("href").toLowerCase())) {
                tab.classList.add("active");
            }
        });

        const leaveForm = document.getElementById("registerForm");
        const startDateInput = document.querySelector('input[name="StartDate"]');
        const endDateInput = document.querySelector('input[name="EndDate"]');
        
        // Dynamically set minimum dates to today
        const todayStr = new Date().toLocaleDateString('en-CA'); // Gets YYYY-MM-DD
        startDateInput.setAttribute('min', todayStr);
        endDateInput.setAttribute('min', todayStr);

        startDateInput.addEventListener('change', function() {
            endDateInput.setAttribute('min', this.value);
        });

        leaveForm.addEventListener("submit", function (e) {
            e.preventDefault();

            // Date validation client-side
            let startDateVal = $('input[name="StartDate"]').val();
            let endDateVal = $('input[name="EndDate"]').val();
            
            const todayDate = new Date();
            todayDate.setHours(0, 0, 0, 0);
            const selectedStartDate = new Date(startDateVal);
            selectedStartDate.setHours(0, 0, 0, 0);

            if (selectedStartDate < todayDate) {
                showPremiumAlert('Invalid Dates', 'Start Date cannot be a past date.', 'error');
                return;
            }

            if (selectedStartDate > new Date(endDateVal)) {
                showPremiumAlert('Invalid Dates', 'Start Date cannot be after End Date.', 'error');
                return;
            }

            showPremiumConfirm(
                'Submit Leave Request?',
                'Are you sure you want to submit this leave request?',
                'fa-solid fa-plane-departure',
                function() {
                    // Use FormData so file inputs are sent
                    var formData = new FormData(leaveForm);
                    var fileInput = leaveForm.querySelector('input[name="Lmg"]');
                    if (fileInput && fileInput.files.length > 0) {
                        formData.set('Lmg', fileInput.files[0]);
                    }

                    $.ajax({
                        url: '/Team/AddLeaves',
                        type: 'POST',
                        data: formData,
                        processData: false,
                        contentType: false,
                        success: function (response) {
                            if (response.success !== false) {
                                showPremiumAlert('Submitted!', response.message || 'Your leave request has been sent to your manager.', 'add', function() {
                                    window.location.reload();
                                });
                            } else {
                                showPremiumAlert('Failed', response.message || 'Failed to submit leave request.', 'error');
                            }
                        },
                        error: function() {
                            showPremiumAlert('Error', 'Failed to submit leave request.', 'error');
                        }
                    });
                }
            );
        });
    });

    document.addEventListener("DOMContentLoaded", function () {
        const leaveDropdown = document.getElementById("LeaveType");
        const leaveOptionsCount = leaveDropdown.options.length;

        if (leaveOptionsCount <= 1) {
            setTimeout(() => {
                showPremiumAlert('Leaves Not Assigned!', 'It looks like your leave quota isn\'t set yet. Please ask your <b>Higher Authorities</b> to add leave types for you.', 'alert');
            }, 500); 
        }
    });
</script>

