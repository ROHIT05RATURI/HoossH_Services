</div>

@section Scripts {




    <script>
        function calculateProgress() {
            let totalFields = 0;
            let filledFields = 0;

            $('.s-prf-check-val').each(function() {
                totalFields++;

                // Extract exact text without breaking child elements
                let val = $(this).text().trim();

                // Ignore dashes, empty strings, and "Add..." placeholders
                if (val &&
                    val !== '-' &&
                    val !== 'Not Provided' &&
                    !val.toLowerCase().startsWith('add ')) {
                    filledFields++;
                }
            });

            let ppercentage = totalFields === 0 ? 0 : Math.round((filledFields / totalFields) * 100);

            // ID (#) ki jagah class (.) selector use karein
            let progressBar = $('.s-prf-progress-fill');

            // Smooth width update dono bars par apply hoga
            progressBar.css('width', ppercentage + '%');
            $('.s-prf-badge-percent').text(ppercentage + '%');

            // Color Logic based on ppercentage
            if (ppercentage === 0) {
                progressBar.css('background-color', 'transparent');
            } else if (ppercentage < 50) {
                progressBar.css('background-color', '#f59e0b'); // Orange
            } else if (ppercentage < 80) {
                progressBar.css('background-color', '#3b82f6'); // Blue
            } else {
                progressBar.css('background-color', '#10b981'); // Green
            }
        }
        $(document).ready(function() {
            calculateProgress();


            let correctImgSrc = $('#mainProfileImg').attr('src');
            if (correctImgSrc) {
                $('#editProfileImg').attr('src', correctImgSrc);
            }

            $('#topModal').on('show.bs.modal', function() {
                let freshImgSrc = $('#mainProfileImg').attr('src');
                $('#editProfileImg').attr('src', freshImgSrc);
            });
        });

        document.addEventListener('hidden.bs.modal', function() {
            if (document.querySelectorAll('.modal.show').length === 0) {
                document.body.classList.remove('modal-open');
                document.body.style = '';
            }
        });

        function closeModal(id, callback) {
            const el = document.getElementById(id);
            const modal = bootstrap.Modal.getInstance(el) || new bootstrap.Modal(el);

            if (callback) {
                el.addEventListener('hidden.bs.modal', function handler() {
                    el.removeEventListener('hidden.bs.modal', handler);
                    callback();
                });
            }
            modal.hide();
        }

        function previewProfileImage(input) {
            if (input.files && input.files[0]) {
                const file = input.files[0];
                if (!file.type.startsWith('image/')) {
                    if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Invalid File!', 'Please upload only images (JPG/PNG).', 'alert');
                    input.value = "";
                    return;
                }
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.src = e.target.result;
                    img.onload = function() {
                        const MAX_WIDTH = 500;
                        const MAX_HEIGHT = 500;
                        let width = img.width;
                        let height = img.height;
                        if (width > height) {
                            if (width > MAX_WIDTH) { height *= MAX_WIDTH / width; width = MAX_WIDTH; }
                        } else {
                            if (height > MAX_HEIGHT) { width *= MAX_HEIGHT / height; height = MAX_HEIGHT; }
                        }
                        const canvas = document.createElement('canvas');
                        canvas.width = width; canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.8);
                        $('#editProfileImg').attr('src', compressedDataUrl);
                        input.value = "";
                    }
                };
                reader.readAsDataURL(file);
            }
        }

        function dataURLtoFile(dataurl, filename) {
            var arr = dataurl.split(','), mime = arr[0].match(/:(.*?);/)[1],
                bstr = atob(arr[1]), n = bstr.length, u8arr = new Uint8Array(n);
            while (n--) { u8arr[n] = bstr.charCodeAt(n); }
            return new File([u8arr], filename, { type: mime });
        }

        function updateProfile() {
            const form = document.getElementById("profileForm");
            if (!form.checkValidity()) { form.reportValidity(); return; }

            const formData = new FormData(form);
            const imgSrc = document.getElementById("editProfileImg").src;

            if (imgSrc && imgSrc.startsWith("data:image")) {
                const finalImageFile = dataURLtoFile(imgSrc, "profile_pic.jpg");
                formData.set("ProfileImage", finalImageFile);

            }

            $.ajax({
                url: '/SuperAdmin/UpdateProfile',
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function(response) {
                    if (response.success) {
                        // FIXED: Changed 'topMoProfileManagerdal' to 'topModal'
                        closeModal('topModal', () => {
                            if (typeof showPremiumAlert !== 'undefined') {
                                showPremiumAlert('Updated!', response.message, 'update');
                            }
                            setTimeout(() => window.location.reload(), 1500);
                        });
                    } else {
                        // FIXED: Ensured fallback also targets the correct modal
                        closeModal('topModal', () => {
                            if (typeof showPremiumAlert !== 'undefined') {
                                showPremiumAlert('Oops!', response.message || 'Profile update failed', 'error');
                            }
                        });
                    }
                },
                error: function() {
                    if (typeof showPremiumAlert !== 'undefined') {
                        showPremiumAlert('Error!', 'Server communication failed.', 'error');
                    }
                }
            });
        }

        function updateIdentity() {
            $.post('/SuperAdmin/UpdateIdentity', {
                PAN: $('#PAN').val(),
                AadharCard: $('#AadharCard').val()
            }).done((response) => {
                if (response.success) {

                    closeModal('identityModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Updated!', response.message, 'update');
                        setTimeout(() => window.location.reload(), 1500);
                    });
                } else {
                    closeModal('identityModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Oops!', response.message || 'Identity update failed', 'error');
                    });
                }
            }).fail(function() {
                if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Error!', 'Server communication failed.', 'error');
            });
        }

        function updateBank() {
            $.post('/SuperAdmin/UpdateBank', {
                AccountNo: $('#AccountNo').val(),
                IFSC: $('#IFSC').val(),
                AccountId: $('#AccountId').val(),
                BankName: $('#BankName').val(),
                Branch: $('#Branch').val(),
                AccountHolder: $('#AccountHolder').val()
            }).done((response) => {
                if (response.success) {

                    closeModal('bankModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Updated!', response.message, 'update');
                        setTimeout(() => window.location.reload(), 1500);
                    });
                } else {
                    closeModal('bankModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Oops!', response.message || 'Bank Details update failed', 'error');
                    });
                }
            }).fail(function() {
                if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Error!', 'Server communication failed.', 'error');
            });
        }

        function updateAddress() {
            $.post('/SuperAdmin/UpdateAddress', {
                Address: $('#Address').val(),
                district: $('#district').val(),
                AddressId: $('#AddressId').val(),
                State: $('#State').val(),
                PinCode: $('#PinCode').val(),
                Country: $('#Country').val()
            }).done((response) => {
                if (response.success) {

                    closeModal('addressModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Updated!', response.message, 'update');
                        setTimeout(() => window.location.reload(), 1500);
                    });
                } else {
                    closeModal('addressModal', () => {
                        if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Oops!', response.message || 'Address Details update failed', 'error');
                    });
                }
            }).fail(function() {
                if (typeof showPremiumAlert !== 'undefined') showPremiumAlert('Error!', 'Server communication failed.', 'error');
            });
        }
    </script>
}