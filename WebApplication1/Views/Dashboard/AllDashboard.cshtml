@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
}

<link rel="stylesheet" href="~/css/Dashboard/Dashboard.css" />

<div class="hooshh-dashboard">

    <!-- ===================== PROFILE + STATS (single big card) ===================== -->
    <section class="hd-profile-card">

        <div class="hd-profile-photo-wrap">
            <img src="~/images/service-man.jpg" alt="Rahul Kumar" class="hd-profile-photo" />
        </div>

        <div class="hd-profile-info">
            <h1 class="hd-profile-name">Rahul Kumar</h1>
            <div class="hd-profile-badges">
                <span class="hd-badge"><i class="fa-regular fa-calendar-check"></i> Since 1-Jan-2022</span>
                <span class="hd-badge">AC Service Technician</span>
            </div>
        </div>

        <div class="hd-profile-stats">

            <div class="hd-pstat hd-pstat-blue">
                <div class="hd-pstat-icon"><i class="fa-solid fa-screwdriver-wrench"></i></div>
                <div class="hd-pstat-value">128</div>
                <div class="hd-pstat-label">Total Services</div>
            </div>

            <div class="hd-pstat hd-pstat-amber">
                <div class="hd-pstat-icon"><i class="fa-regular fa-clock"></i></div>
                <div class="hd-pstat-value">18</div>
                <div class="hd-pstat-label">Pending</div>
            </div>

            <div class="hd-pstat hd-pstat-green">
                <div class="hd-pstat-icon"><i class="fa-solid fa-circle-check"></i></div>
                <div class="hd-pstat-value">94</div>
                <div class="hd-pstat-label">Completed</div>
            </div>

            <div class="hd-pstat hd-pstat-purple">
                <div class="hd-pstat-icon"><i class="fa-solid fa-users-gear"></i></div>
                <div class="hd-pstat-value">2</div>
                <div class="hd-pstat-label">Today's Jobs</div>
            </div>

        </div>

    </section>

    <!-- ===================== CHART + QUICK ACTIONS ===================== -->
    <div class="hd-middle-row">

        <section class="hd-card">
            <div class="hd-card-header">
                <div>
                    <h2>Service Activity</h2>
                    <p>Overview of service requests over the last 7 days</p>
                </div>
                <div class="hd-tabs"><span class="active">7D</span><span>30D</span><span>90D</span></div>
            </div>
            <div class="hd-chart-legend">
                <span><span class="dot" style="background:#16a34a"></span>Completed</span>
                <span><span class="dot" style="background:#d97706"></span>Pending</span>
                <span><span class="dot" style="background:#7c3aed"></span>New Requests</span>
            </div>
            <div class="hd-chart-wrap">
                <svg viewBox="0 0 720 220" width="100%" height="220" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="hdFillBlue" x1="0" y1="0" x2="0" y2="1">
                            <stop offset="0%" stop-color="#2563eb" stop-opacity="0.18" />
                            <stop offset="100%" stop-color="#2563eb" stop-opacity="0" />
                        </linearGradient>
                    </defs>
                    <line x1="0" y1="10" x2="720" y2="10" stroke="#edf0f3" stroke-width="1" />
                    <line x1="0" y1="60" x2="720" y2="60" stroke="#edf0f3" stroke-width="1" />
                    <line x1="0" y1="110" x2="720" y2="110" stroke="#edf0f3" stroke-width="1" />
                    <line x1="0" y1="160" x2="720" y2="160" stroke="#edf0f3" stroke-width="1" />
                    <line x1="0" y1="205" x2="720" y2="205" stroke="#edf0f3" stroke-width="1" />

                    <path d="M0,150 L720,150 L720,220 L0,220 Z" fill="url(#hdFillBlue)" />
                    <path d="M0,150 C90,120 130,95 210,105 C290,115 320,80 400,75 C480,70 520,95 600,60 C650,40 690,55 720,25"
                          fill="none" stroke="#2563eb" stroke-width="2.5" />
                    <path d="M0,180 C100,175 160,150 240,160 C320,170 360,150 440,155 C520,160 560,140 620,150 C660,157 690,150 720,135"
                          fill="none" stroke="#7c3aed" stroke-width="2.5" />
                    <path d="M0,195 C110,193 180,185 250,190 C330,196 380,185 450,188 C530,192 580,182 640,187 C670,190 700,186 720,183"
                          fill="none" stroke="#d97706" stroke-width="2.5" />
                </svg>
                <div class="hd-chart-xaxis">
                    <span>3 Jun</span><span>4 Jun</span><span>5 Jun</span><span>6 Jun</span><span>7 Jun</span><span>8 Jun</span><span>9 Jun</span>
                </div>
            </div>
        </section>

        <section class="hd-card">
            <div class="hd-card-header"><div><h2>Quick Actions</h2></div></div>
            <div class="hd-qa-grid">
                <a href="@Url.Action("VisitList", "UserVisit")" class="hd-qa-tile hd-qa-blue">
                    <i class="icon fa-solid fa-calendar-plus"></i>
                    <div class="label">Book a Service <i class="fa-solid fa-arrow-right arrow"></i></div>
                </a>
                <a href="#" class="hd-qa-tile hd-qa-green">
                    <i class="icon fa-regular fa-file-lines"></i>
                    <div class="label">Create Request <i class="fa-solid fa-arrow-right arrow"></i></div>
                </a>
                <a href="@Url.Action("VisitList", "UserVisit")" class="hd-qa-tile hd-qa-purple">
                    <i class="icon fa-regular fa-calendar"></i>
                    <div class="label">View Appointments <i class="fa-solid fa-arrow-right arrow"></i></div>
                </a>
                <a href="@Url.Action("ClientList", "UserClient")" class="hd-qa-tile hd-qa-amber">
                    <i class="icon fa-solid fa-user-gear"></i>
                    <div class="label">Find a Technician <i class="fa-solid fa-arrow-right arrow"></i></div>
                </a>
            </div>
        </section>
    </div>

    <!-- ===================== ACTIVITY + UPCOMING ===================== -->
    <div class="hd-bottom-row">

        <section class="hd-card">
            <div class="hd-card-header">
                <div><h2>Recent Activity</h2></div>
                <a href="#" class="hd-viewall">View all <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="hd-activity-list">
                <div class="hd-activity-item">
                    <div class="hd-activity-icon act-purple"><i class="fa-solid fa-wrench"></i></div>
                    <div class="hd-activity-body"><strong>AC Repair - Customer B</strong><span>Status updated to In Progress</span></div>
                    <span class="hd-pill progress">In Progress</span>
                    <span class="hd-activity-time">11:45 AM</span>
                </div>
                <div class="hd-activity-item">
                    <div class="hd-activity-icon act-green"><i class="fa-solid fa-plus"></i></div>
                    <div class="hd-activity-body"><strong>New request - SR-1024</strong><span>AC Installation – Customer A</span></div>
                    <span class="hd-pill new">New</span>
                    <span class="hd-activity-time">10:32 AM</span>
                </div>
                <div class="hd-activity-item">
                    <div class="hd-activity-icon act-check"><i class="fa-solid fa-check"></i></div>
                    <div class="hd-activity-body"><strong>Service completed - SR-1018</strong><span>AC Maintenance – Customer C</span></div>
                    <span class="hd-pill completed">Completed</span>
                    <span class="hd-activity-time">09:12 AM</span>
                </div>
                <div class="hd-activity-item">
                    <div class="hd-activity-icon act-blue"><i class="fa-solid fa-screwdriver-wrench"></i></div>
                    <div class="hd-activity-body"><strong>New request - SR-1023</strong><span>AC Repair – Customer B</span></div>
                    <span class="hd-pill new">New</span>
                    <span class="hd-activity-time">08:45 AM</span>
                </div>
            </div>
        </section>

        <section class="hd-card">
            <div class="hd-card-header">
                <div><h2>Upcoming Services</h2></div>
                <a href="#" class="hd-viewall">View all <i class="fa-solid fa-arrow-right"></i></a>
            </div>
            <div class="hd-upcoming-list">
                <div class="hd-upcoming-item">
                    <span class="time-col">10:00 AM</span>
                    <div class="hd-upcoming-icon" style="background:var(--blue-light);color:var(--blue)"><i class="fa-solid fa-snowflake"></i></div>
                    <div class="hd-upcoming-body"><strong>AC Installation</strong><span>Customer A</span><span><i class="fa-solid fa-location-dot"></i> Dehradun</span></div>
                    <span class="hd-pill scheduled">Scheduled</span>
                </div>
                <div class="hd-upcoming-item">
                    <span class="time-col">11:30 AM</span>
                    <div class="hd-upcoming-icon" style="background:var(--purple-light);color:var(--purple)"><i class="fa-solid fa-screwdriver-wrench"></i></div>
                    <div class="hd-upcoming-body"><strong>AC Repair</strong><span>Customer B</span><span><i class="fa-solid fa-location-dot"></i> Dehradun</span></div>
                    <span class="hd-pill progress">In Progress</span>
                </div>
                <div class="hd-upcoming-item">
                    <span class="time-col">01:00 PM</span>
                    <div class="hd-upcoming-icon" style="background:var(--amber-light);color:var(--amber)"><i class="fa-solid fa-gears"></i></div>
                    <div class="hd-upcoming-body"><strong>AC Maintenance</strong><span>Customer C</span><span><i class="fa-solid fa-location-dot"></i> Dehradun</span></div>
                    <span class="hd-pill scheduled">Scheduled</span>
                </div>
                <div class="hd-upcoming-item">
                    <span class="time-col">03:30 PM</span>
                    <div class="hd-upcoming-icon" style="background:var(--green-light);color:var(--green)"><i class="fa-solid fa-magnifying-glass"></i></div>
                    <div class="hd-upcoming-body"><strong>AC Inspection</strong><span>Customer D</span><span><i class="fa-solid fa-location-dot"></i> Dehradun</span></div>
                    <span class="hd-pill pending">Pending</span>
                </div>
            </div>
        </section>
    </div>

</div>

@section Scripts {
    <!-- No JavaScript required for the current dashboard -->
}