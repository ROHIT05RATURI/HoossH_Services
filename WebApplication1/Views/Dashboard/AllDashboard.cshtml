        if(!fillBar || !percentText) return;

        let safeValue = Math.max(0, Math.min(100, percent));

        percentText.innerText = safeValue.toFixed(1) + '%';
        fillBar.style.width = safeValue + '%';

        if (safeValue < 30) {
            fillBar.style.backgroundColor = '#ef4444';
            fillBar.style.boxShadow = '0 0 10px rgba(239, 68, 68, 0.5)';
