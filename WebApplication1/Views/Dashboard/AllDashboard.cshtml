<div id="checked" class="fixed-bottom-actions">
    <button type="button" class="action-btn" onclick="alert('General clicked')"><i class="fas fa-handshake"></i>General</button>
    <button type="button" class="action-btn" onclick="alert('FollowUp clicked')"><i class="fas fa-headset"></i>FollowUp</button>
    <button type="button" class="action-btn" onclick="alert('Payment clicked')"><i class="fas fa-money-bill-wave"></i>Payment</button>
    <button type="button" class="action-btn" onclick="alert('Feedback clicked')"><i class="fas fa-star"></i>Feedback</button>
</div>

<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    // ==========================================
    // 1. GLOBAL VARIABLES & DATA REPOSITORY
    // ==========================================
    const salesDataList = @salesJson;
    const paymentDataList = @paymentJson;
    const incentiveDataList = @incentiveJson;
    const clientConvDataList = @clientConvJson;
    const enquiryfunnelData = @funnelJson;
    let activeMonth = enquiryfunnelData.length > 0 ? enquiryfunnelData[0] : null;

    const rawLabels = @rawLabelsJson;
    const rawSales = @rawSalesJson;
    const rawSalesValue = @rawSalesValueJson;
    const rawEnq = @rawEnqJson;
    const rawEnqValue = @rawEnqValueJson;
    const rawQual = @rawQualJson;
    const rawQualValue = @rawQualValueJson;

    // 🔥 Incentive Graph Mapping Logic
    const incRawDbList = @incRawDbListJson;
    const rawInc = rawLabels.map(month => {
        let sum = 0;
        if (month && incRawDbList) {
            let mStr = month.substring(0, 3).toLowerCase();
            let matches = incRawDbList.filter(x => x.MonthName && x.MonthName.substring(0, 3).toLowerCase() === mStr);
            matches.forEach(m => sum += m.TotalAmount);
        }
        return sum;
    });

    const rawPayRec = @rawPayRecJson;
    const rawPayPend = @rawPayPendJson;
    const rawConversion = @clientConvJson;

    // Helper for UI trends
    function updateTrendUI(elementId, value, isPercentage = false, formatCombined = false, valPct = 0) {
        const el = document.getElementById(elementId);
        if (!el) return;
        const isPositive = value >= 0;
        const colorClass = isPositive ? '#10b981' : '#ef4444';
        const iconClass = isPositive ? 'fa-arrow-up' : 'fa-arrow-down';
        const sign = isPositive ? '+' : '';

        let displayVal = Math.abs(value).toLocaleString('en-IN');

        if (formatCombined) {
            let pctDisplay = Math.abs(valPct).toFixed(2);
            el.innerHTML = `<span style="color: ${colorClass}; font-weight: 700;">${sign} ₹ ${displayVal} (${sign}${pctDisplay}%) <i class="fas ${iconClass}"></i></span>`;
        } else if (isPercentage) {
            el.innerHTML = `<span style="color: ${colorClass}; font-weight: 700;">${sign}${Math.abs(value).toFixed(2)}% <i class="fas ${iconClass}"></i></span>`;
        } else {
            el.innerHTML = `<span style="color: ${colorClass}; font-weight: 700;">${sign} ₹ ${displayVal} <i class="fas ${iconClass}"></i></span>`;
        }
    }

    window.updateSalesCard = function(month) {
        const data = salesDataList.find(x => x.MonthLabel === month);
        if (!data) return;
        document.getElementById('salesCurrentVal').innerText = formatCurrency(data.TotalOrdersValue);
        document.getElementById('salesPrevVal').innerText = formatCurrency(data.PreviousMonthOrderValue);
        updateTrendUI('salesVarAmt', data.Vairance, false);
        updateTrendUI('salesVarPct', data.ChangePercentage, true);
    };

    window.updateClientCard = function(month) {
        const data = clientConvDataList.find(x => x.MonthLabel === month);
        if (!data) return;
        document.getElementById('clientNewAdded').innerHTML = `${data.Clientsthismonth} <span style="color:#10b981; font-size:12px;"><i class="fas fa-arrow-up"></i></span>`;
        document.getElementById('clientProsAdded').innerText = data.NewProspectsAdded;
        document.getElementById('clientProsRem').innerText = data.RemainingProspects;
    };

    window.updatePaymentCard = function(month) {
        const data = paymentDataList.find(x => x.MonthLabel === month);
        if (!data) return;
        document.getElementById('payCurrentVal').innerText = formatCurrency(data.CurrentMonthPayment);
        document.getElementById('payPrevVal').innerText = formatCurrency(data.PreviousMonthPayment);
        updateTrendUI('payVarAmt', data.VarianceAmount, false, true, data.VariancePercentage);
        document.getElementById('payPending').innerText = formatCurrency(data.PendingPayments);
    };

    window.updateIncentiveCard = function(month) {
        const data = incentiveDataList.find(x => x.MonthLabel === month);
        if (!data) return;
        document.getElementById('incCurrentVal').innerText = formatCurrency(data.CurrentMonthIncentive);
        document.getElementById('incPrevVal').innerText = formatCurrency(data.PreviousMonthIncentive);
        updateTrendUI('incVarAmt', data.VarianceAmount, false, true, data.VariancePercentage);
    };

    document.addEventListener("DOMContentLoaded", function() {
        if (salesDataList.length > 0) updateSalesCard(salesDataList[0].MonthLabel);
        if (clientConvDataList.length > 0) updateClientCard(clientConvDataList[0].MonthLabel);
        if (paymentDataList.length > 0) updatePaymentCard(paymentDataList[0].MonthLabel);
        if (incentiveDataList.length > 0) updateIncentiveCard(incentiveDataList[0].MonthLabel);
    });

    const fyMonths = ['Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec', 'Jan', 'Feb', 'Mar'];
    const normalizedConversion = fyMonths.map(month => {
        const found = rawConversion.find(x => x.MonthLabel.startsWith(month));
        return found || { MonthLabel: month, TotalProspects: 0, RemainingProspects: 0, Clientsthismonth: 0, TotalClients: 0, ConversionRate: 0 };
    });

    const totalProspects = normalizedConversion.map(x => x.TotalProspects);
    const remainingProspects = normalizedConversion.map(x => x.RemainingProspects);
    const clientsThisMonth = normalizedConversion.map(x => x.Clientsthismonth);
    const totalClients = normalizedConversion.map(x => x.TotalClients);
    const conversionRate = normalizedConversion.map(x => x.ConversionRate);

    const allLabels = rawLabels.length > 0 ? rawLabels : ['M1', 'M2', 'M3', 'M4', 'M5', 'M6'];
    const currentMonth = new Date().getMonth() + 1;
    const currentIndex = (currentMonth - 4 + 12) % 12;

    const getLast6Months = (arr, cIndex) => {
        if (!arr || arr.length === 0) return [];
        const result = [];
        for (let i = 5; i >= 0; i--) {
            const index = (cIndex - i + 12) % 12;
            result.push(arr[index] || 0);
        }
        return result;
    };

    const chartDataRepo = {
        labels: { all: allLabels, '6m': getLast6Months(allLabels, currentIndex) },
        conversionLabels: { all: normalizedConversion.map(x => x.MonthLabel), '6m': getLast6Months(normalizedConversion.map(x => x.MonthLabel), currentIndex) },
        monthlySalesGridChart: {
            count: { all: rawSales, '6m': getLast6Months(rawSales, currentIndex) },
            value: { all: rawSalesValue, '6m': getLast6Months(rawSalesValue, currentIndex) }
        },
        chart1: {
            enquiries: { count: { all: rawEnq, '6m': getLast6Months(rawEnq, currentIndex) }, value: { all: rawEnqValue, '6m': getLast6Months(rawEnqValue, currentIndex) } },
            qualified: { count: { all: rawQual, '6m': getLast6Months(rawQual, currentIndex) }, value: { all: rawQualValue, '6m': getLast6Months(rawQualValue, currentIndex) } },
            Orders: { count: { all: rawSales, '6m': getLast6Months(rawSales, currentIndex) }, value: { all: rawSalesValue, '6m': getLast6Months(rawSalesValue, currentIndex) } }
        },
        chart2: {
            totalClients: { all: totalClients, '6m': getLast6Months(totalClients, currentIndex) },
            remainingProspects: { all: remainingProspects, '6m': getLast6Months(remainingProspects, currentIndex) },
            conversionRate: { all: conversionRate, '6m': getLast6Months(conversionRate, currentIndex) }
        },
        chart3: { all: rawInc, '6m': getLast6Months(rawInc, currentIndex) },
        paymentChart: {
            received: { all: rawPayRec, '6m': getLast6Months(rawPayRec, currentIndex) },
            pending: { all: rawPayPend, '6m': getLast6Months(rawPayPend, currentIndex) }
        },
        chart4: {
            repeat: @(Model != null ? Model.repeatCustomers : 0),
            newCust: @(Model != null ? Model.uniqueCustomers - Model.repeatCustomers : 0),
            repeatPercent: @(Model != null ? Model.RepeatCustomerPercentage : 0)
            }
    };

    let myCharts = {};
    let funnelTanks = [];
    window.activeChartFilters = { chart2: '6m' };

    function renderDashboard() {
        if (!activeMonth) return;
        renderMonthComparison();
        renderFYBlock();
        renderMiniKPIs();
    }

    function formatCurrency(value) { return '₹ ' + Number(value || 0).toLocaleString('en-IN'); }
