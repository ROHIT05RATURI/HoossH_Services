@using System.Text.Json
@using HoossH_Services.Models
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor

@model Kundali

@{
    ViewBag.Title = "Dashboard";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";

    var user = HttpContextAccessor.HttpContext?.User;
    var role = user?.FindFirst(ClaimTypes.Role)?.Value;

    var funnelEnqPct = Model?.FunnelVisits > 0 ? (int)((Model.FunnelEnquiries * 100.0) / Model.FunnelVisits) : 0;
    var funnelQualPct = Model?.FunnelEnquiries > 0 ? (int)((Model.FunnelQualified * 100.0) / Model.FunnelEnquiries) : 0;
    var funnelOrdPct = Model?.FunnelQualified > 0 ? (int)((Model.FunnelOrders * 100.0) / Model.FunnelQualified) : 0;
    var funnelRepPct = Model?.FunnelOrders > 0 ? (int)((Model.FunnelRepeat * 100.0) / Model.FunnelOrders) : 0;
    var salesJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlySalesSummary ?? new List<MonthlySalesSummaryData>()));
    var paymentJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyPaymentSummary ?? new List<MonthlyPaymentSummaryData>()));
    var incentiveJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyIncentiveSummary ?? new List<MonthlyIncentiveSummaryData>()));
    var clientConvJson = Html.Raw(JsonSerializer.Serialize(Model?.ProspectToClientMonthly ?? new List<MonthlyConversionData>()));
    var funnelJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyFunnelSummary ?? new List<MonthlyFunnelSummaryData>()));

    var rawLabelsJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthLabels ?? new List<string>()));
    var rawSalesJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlySales ?? new List<long>()));
    var rawSalesValueJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlySalesValues ?? new List<decimal>()));
    var rawEnqJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyEnquiries ?? new List<long>()));
    var rawEnqValueJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyEnquiriesVlaues ?? new List<decimal>()));
    var rawQualJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyQualifiedLeads ?? new List<long>()));
    var rawQualValueJson = Html.Raw(JsonSerializer.Serialize(Model?.MonthlyQualifiedLeadsValues ?? new List<decimal>()));
    var incRawDbListJson = Html.Raw(JsonSerializer.Serialize(Model?.IncentiveMonthly ?? new List<IncentiveDataModel>()));

    var rawPayRecJson = Html.Raw(JsonSerializer.Serialize(Model?.PaymentsReceived ?? new List<long>()));
    var rawPayPendJson = Html.Raw(JsonSerializer.Serialize(Model?.PaymentsPending ?? new List<long>()));
}

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<partial name="_BottomNavigation" />
<link rel="stylesheet" href="/css/Kundali.css" />

@{
    var imgBytes = Model?.Avatar;
    var base64 = imgBytes != null && imgBytes.Length > 0 ? Convert.ToBase64String(imgBytes) : null;
    string mime = "image/jpeg";

    if (imgBytes != null && imgBytes.Length > 4)
    {
        if (imgBytes[0] == 137 && imgBytes[1] == 80) mime = "image/png";
        else if (imgBytes[0] == 255 && imgBytes[1] == 216) mime = "image/jpeg";
        else if (imgBytes[0] == 71 && imgBytes[1] == 73) mime = "image/gif";
    }
}

@if (role == "SalesManager" || role == "Owner")
{
    <div class="action-top-bar mt-2">
        <a href="/Flow/TeamKundali" class="btn-classic-modern">
            <i class="fas fa-users"></i> View Team
        </a>
    </div>
}

<div class="Content-Wrapper p-0 p-md-3">
    <div class="profile-card-container">
        <div class="profile-left">
            <div class="profile-avatar-wrap">
                <img id="editProfileImg" class="agent-avatar" src="~/images/service-man.jpg">
            </div>
            <div class="profile-info">
                <h2 class="agent-name">@(Model != null && !string.IsNullOrEmpty(Model.AgentName) ? Model.AgentName : "Agent Name")</h2>
                <div class="profile-badges">
                    <div class="badge-pill"><i class="fas fa-calendar-check"></i> Since @(Model != null ? Model.JoinDate : "")</div>
                    <div class="badge-pill"><text>@(Model != null ? Model.DaysTogether : 0) days</text></div>
                </div>
            </div>
        </div>

        <div class="agent-kpis">
            <a asp-controller="Flow" asp-action="VisitReports" asp-route-loginId="@(Model != null ? Model.KundliLoginID : "")" style="text-decoration:none; color:inherit;">
                <div class="kpi-box"><div class="kpi-icon-circle icon-visits"><i class="fas fa-walking"></i></div><strong>@(Model != null ? Model.TotalVisits : 0)</strong><span>Total Visits</span></div>
            </a>

            <a asp-controller="Customer" asp-action="ViewClient" asp-route-loginId="@(Model != null ? Model.KundliLoginID : "")" style="text-decoration:none; color:inherit;">
                <div class="kpi-box"><div class="kpi-icon-circle" style="background:var(--blue-bg); color:var(--blue-txt);"><i class="fas fa-users"></i></div><strong>@(Model != null ? Model.uniqueCustomers : 0)</strong><span>Total Clients</span></div>
            </a>

            <a asp-controller="Flow" asp-action="EnquiryReport" asp-route-loginId="@(Model != null ? Model.KundliLoginID : "")" style="text-decoration:none; color:inherit;">
                <div class="kpi-box"><div class="kpi-icon-circle icon-prospects"><i class="fas fa-comment-dots"></i></div><strong>₹ @(Model != null ? Model.LiveEnquiriesValue.ToString("N0", new System.Globalization.CultureInfo("en-IN")) : "0")</strong><span>Total Service (@(Model != null ? Model.LiveInquiry : 0))</span></div>
            </a>

            <a asp-controller="Flow" asp-action="LeadReports" asp-route-loginId="@(Model != null ? Model.KundliLoginID : "")" style="text-decoration:none; color:inherit;">
                <div class="kpi-box"><div class="kpi-icon-circle icon-clients"><i class="fas fa-bullseye"></i></div><strong>₹ @(Model != null ? Model.LiveQualifiedValue.ToString("N0", new System.Globalization.CultureInfo("en-IN")) : "0")</strong><span>Compliant Service (@(Model != null ? Model.LiveQualifiedLead : 0))</span></div>
            </a>

            <a asp-controller="Flow" asp-action="OrderReports" asp-route-loginId="@(Model != null ? Model.KundliLoginID : "")" style="text-decoration:none; color:inherit;">
                <div class="kpi-box"><div class="kpi-icon-circle icon-orders"><i class="fas fa-shopping-bag"></i></div><strong>₹ @(Model != null ? Model.LiveOrdersValue.ToString("N0", new System.Globalization.CultureInfo("en-IN")) : "0")</strong><span>Pending Service (@(Model != null ? Model.LiveOrdersCount : 0))</span></div>
            </a>
        </div>
    </div>

    <div class="collapsible-header" onclick="toggleSection('secFunnel', this, null, true)">
        <h3 class="header-title"><span class="header-icon" style="background: var(--orange-bg); color: var(--orange-txt);"><i class="fas fa-filter"></i></span> 1. Interactive Service Funnel</h3>
        <i class="fas fa-chevron-down chevron-icon"></i>
    </div>
    <div id="secFunnel" class="collapsible-content">
        <div class="section-split">
            <div style="width:100%; border-bottom: 1px solid var(--border-light); padding-bottom: 20px;">
                <div class="tubes-scroll-wrapper">
                    <div class="tubes-container">
                        <div class="tube-wrapper"><div class="tube-physics-holder" style="height: 280px;"><canvas class="liquid-canvas" id="canvasVisits"></canvas></div><div class="tube-label"><h5>Visits</h5><p>@(Model != null ? Model.FunnelVisits : 0)</p><span class="pct-badge">100%</span></div></div>
                        <div class="tube-wrapper"><div class="tube-physics-holder" style="height: 240px;"><canvas class="liquid-canvas" id="canvasEnquiries"></canvas></div><div class="tube-label"><h5>Total Service</h5><p>@(Model != null ? Model.FunnelEnquiries : 0)</p><span class="pct-badge">100%</span></div></div>
                        <div class="tube-wrapper"><div class="tube-physics-holder" style="height: 200px;"><canvas class="liquid-canvas" id="canvasQualified"></canvas></div><div class="tube-label"><h5>Compliant Service</h5><p>@(Model != null ? Model.FunnelQualified : 0)</p><span class="pct-badge">@(funnelQualPct)%</span></div></div>
                        <div class="tube-wrapper"><div class="tube-physics-holder" style="height: 160px;"><canvas class="liquid-canvas" id="canvasOrders"></canvas></div><div class="tube-label"><h5>Pending Service</h5><p>@(Model != null ? Model.FunnelOrders : 0)</p><span class="pct-badge">@(funnelOrdPct)%</span></div></div>
                        <div class="tube-wrapper"><div class="tube-physics-holder" style="height: 120px;"><canvas class="liquid-canvas" id="canvasRepeat"></canvas></div><div class="tube-label"><h5>Repeat</h5><p>@(Model != null ? Model.FunnelRepeat : 0)</p><span class="pct-badge">@(funnelRepPct)%</span></div></div>
                    </div>
                </div>
            </div>

            <div style="width: 100%;">
                <div class="clean-header"><h4 style="margin-bottom:0px; font-size: 0.9rem; color: var(--dark-txt); font-weight:600;">Funnel Breakdown Details</h4></div>
                <div class="clean-row"><span class="row-label">Total Field Visits <br><small>All Channels</small></span><div style="text-align: right;"><span class="row-value">@(Model != null ? Model.FunnelVisits : 0)</span><br><span style="font-size:0.7rem; color:var(--text-xs);">Leads Reached</span></div></div>
                <div class="clean-row"><span class="row-label">Total Service <br><small>Conversion from Visits</small></span><div style="text-align: right;"><span class="row-value" style="color:var(--blue-txt);">@(Model != null ? Model.FunnelEnquiries : 0)</span><br><span style="font-size:0.7rem; color:var(--text-xs);">@(funnelEnqPct)% Conv.</span></div></div>
                <div class="clean-row"><span class="row-label">Total Compliant Service <br><small>Conversion from Total Service</small></span><div style="text-align: right;"><span class="row-value" style="color:var(--orange-txt);">@(Model != null ? Model.FunnelQualified : 0)</span><br><span style="font-size:0.7rem; color:var(--text-xs);">@(funnelQualPct)% Conv.</span></div></div>
                <div class="clean-row"><span class="row-label">Total Pending Service <br><small>Conversion from Compliant Service</small></span><div style="text-align: right;"><span class="row-value" style="color:var(--green-txt);">@(Model != null ? Model.FunnelOrders : 0)</span><br><span style="font-size:0.7rem; color:var(--text-xs);">@(funnelOrdPct)% Conv.</span></div></div>
                <div class="clean-row"><span class="row-label">Repeat Client <br><small></small></span><div style="text-align: right;"><span class="row-value" style="color:var(--green-txt);">@(Model != null ? Model.FunnelRepeat : 0)</span><br><span style="font-size:0.7rem; color:var(--text-xs);">@(funnelRepPct)% Conv.</span></div></div>
            </div>
        </div>
    </div>

    <!-- 2. Monthly Order Book -->
    <div class="collapsible-header" onclick="toggleSection('secSales', this, 'monthlySalesGridChart')">
        <h3 class="header-title">
            <span class="header-icon" style="background: var(--green-bg); color: var(--green-txt);">
                <i class="fas fa-file-invoice"></i>
            </span>
            2. Monthly Order Book
        </h3>
        <i class="fas fa-chevron-down chevron-icon"></i>
    </div>
    <div id="secSales" class="collapsible-content">
        <div class="dashboard-grid-layout">
            <div class="chart-main-panel">
                <div class="chart-panel-header">
                    <h4 class="chart-panel-title">Pending Service Value Over Time</h4>
                    <div class="capsule-toggle">
                        <button class="capsule-btn" onclick="updateChartFilter(this, 'monthlySalesGridChart', 'all')">1Y</button>
                        <button class="capsule-btn active" onclick="updateChartFilter(this, 'monthlySalesGridChart', '6m')">6M</button>
                    </div>
                </div>
                <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-bottom: 10px;">Amount (₹)</div>
                <div class="chart-container" style="height: 320px;">
                    <canvas id="monthlySalesGridChart"></canvas>
                </div>
            </div>
            <div class="side-metrics-panel">
                @if (Model?.MonthlySalesSummary != null && Model.MonthlySalesSummary.Any())
                {
                    <div class="data-card">
                        <div class="data-card-title" style="display: flex; justify-content: space-between; align-items: center;">
                            <span>Month-on-Month</span>
                            <select class="month-selector" onchange="updateSalesCard(this.value)" style="padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; outline: none; font-weight: 600;">
                                @foreach (var m in Model.MonthlySalesSummary)
                                {
                                    <option value="@m.MonthLabel">@m.MonthLabel</option>
                                }
                            </select>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Current Month Value</span>
                            <span class="data-value val-green" id="salesCurrentVal">₹ 0</span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Previous Month Value</span>
                            <span class="data-value" id="salesPrevVal">₹ 0</span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Variance (₹)</span>
                            <span class="data-value" id="salesVarAmt">₹ 0</span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Variance (%)</span>
                            <span class="data-value" id="salesVarPct">0.00%</span>
                        </div>
                    </div>
                }
                @if (Model?.yearlydata != null)
                {
                    <div class="data-card">
                        <div class="data-card-title">Current FY Snapshot </div>
                        <div class="data-row">
                            <span class="data-label">Total Pending Service Value</span>
                            <span class="data-value val-green">₹ @Model.yearlydata.TotalOrderValue.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Total Pending Service</span>
                            <span class="data-value val-green">@Model.yearlydata.TotalOrders </span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Average Value</span>
                            <span class="data-value val-green">₹ @Model.yearlydata.AverageOrderValue.ToString("N0", new System.Globalization.CultureInfo("en-IN"))</span>
                        </div>
                        <div class="data-row">
                            <span class="data-label">Best Month</span>
                            <span class="data-value val-green">@Model.yearlydata.BestMonth ( ₹ @Model.yearlydata.BestMonthValue.ToString("N0", new System.Globalization.CultureInfo("en-IN")) )</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- 3. Service Funnel -->
    <div class="collapsible-header" onclick="toggleSection('secLeadConv', this, 'chart1')">
        <h3 class="header-title"><span class="header-icon" style="background: var(--blue-bg); color: var(--blue-txt);"><i class="fas fa-exchange-alt"></i></span> 3. Service Funnel</h3>
        <i class="fas fa-chevron-down chevron-icon"></i>
    </div>
    <div id="secLeadConv" class="collapsible-content">
        <div class="section-split">
            <div style="width:100%;">
                <div class="graph-filter-container">
                    <div class="capsule-toggle">
                        <button class="capsule-btn" onclick="updateChartFilter(this, 'chart1', 'all')">1Y</button>
                        <button class="capsule-btn active" onclick="updateChartFilter(this, 'chart1', '6m')">6M</button>
                    </div>
                </div>
                <div class="chart-container"><canvas id="chart1"></canvas></div>
            </div>
            <div class="section-divider"></div>
            <div style="width:100%" class="scroll-area">
                <div class="funnel-topbar">
                    
                    <div class="mini-kpi-card">
                    <span>Month On Month</span>
                        <div class="kpi-header d-none">
                            <span class="kpi-title"><i class="fas fa-filter"></i> Pipeline Health</span>
                            <span class="kpi-percent" id="pipelineHealthText">0%</span>
                        </div>

                        <div class="pipeline-trackd-none">
                            <div class="pipeline-fill" id="pipelineHealthFill"></div>
                        </div>

                    </div>
                    <div class="month-selector-wrap">
                        <select id="monthSelector" class="month-selector">
                            @if (Model?.MonthlyFunnelSummary != null)
                            {
                                foreach (var item in Model.MonthlyFunnelSummary)
                                {
                                    <option value="@item.MonthLabel.Trim()">@item.MonthLabel</option>
                                }
                            }
                        </select>
                    </div>
                </div>
                <div class="funnel-dashboard-grid">
                    <div class="funnel-insight-panel">
                        <div class="executive-card">
                            <div class="exec-header">
                                <span style="font-size: 12px;font-weight: 600; font-family: 'Poppins';">Month-on-Month Comparison ( <span id="monthName"></span> )</span>
                            </div>
                            <div class="comparison-grid">
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Total Service( <span id="EnquiryCount" style="font-weight:700"></span>) </span></div>
                                    <div class="col-4 ValueDiv"><span id="enqValue" style="padding-left:10px;font-size:12px;  font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="enqVariance" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Compliant Service ( <span id="qualifiedCount" style="font-weight:700"></span>  ) </span></div>
                                    <div class="col-4 ValueDiv"><span id="qualifiedValue" style="padding-left:10px; font-size:12px; font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="qualifiedVariance" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700">Pending Service ( <span id="OrdersCount" style="font-weight:700"></span>  ) </span></div>
                                    <div class="col-4 ValueDiv"><span id="ordersValue" style="padding-left:10px; font-size:12px; font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="ordersVariance" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>
                            </div>
                        </div>
                        <!-- Current FY Snapshot Card -->
                        <div class="executive-card">
                            <div class="exec-header">
                                <span style="font-size: 12px;font-weight: 600; font-family: 'Poppins';">Current FY Snapshot</span>
                            </div>
                            <div class="comparison-grid">
                                <!-- 1. Enquiries -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Total Service( <span id="TotalEnquiryCount" style="font-weight:700"></span>) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyEnquiries" style="padding-left:10px; font-size:12px; font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyEnquiryConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>

                                <!-- 2. Cancelled Enquiries (New) -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Cancelled Service( <span id="TotalCancelEnquiryCount" style="font-weight:700"></span>) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyCancelEnquiries" style="padding-left:10px; font-size:12px; font-weight:700; color: #ef4444;"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyCancelEnquiryConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>

                                <!-- 3. Qualified -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Compliant Service( <span id="TotalqualifiedCount" style="font-weight:700"></span> ) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyQualified" style="padding-left:10px; font-size:12px; font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyQualifiedConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>

                                <!-- 4. Cancelled Qualified (New) -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Cancelled Compliant Service( <span id="TotalCancelQualifiedCount" style="font-weight:700"></span>) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyCancelQualified" style="padding-left:10px; font-size:12px; font-weight:700; color: #ef4444;"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyCancelQualifiedConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>

                                <!-- 5. Orders -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700">Pending Service( <span id="TotalOrdersCount" style="font-weight:700"></span> ) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyOrders" style="padding-left:10px; font-size:12px; font-weight:700"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyOrderConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>

                                <!-- 6. Cancelled Orders (New) -->
                                <div class="comparison-row">
                                    <div class="col-4 LabelDiv"><span class="metric-label" style="font-weight:700"> Cancelled Pending Service( <span id="TotalCancelOrdersCount" style="font-weight:700"></span>) </span></div>
                                    <div class="col-4 ValueDiv"><span id="fyCancelOrders" style="padding-left:10px; font-size:12px; font-weight:700; color: #ef4444;"></span></div>
                                    <div class="col-4 ChangeDiv" id="fyCancelOrderConv" style="padding-left:10px; font-size:12px; font-weight:700"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- 4. Client -->
    <div class="collapsible-header" onclick="toggleSection('secClientConv', this, 'chart2')">
        <h3 class="header-title"><span class="header-icon" style="background: var(--purple-bg); color: var(--purple-txt);"><i class="fas fa-users"></i></span> 4. Client</h3>
        <i class="fas fa-chevron-down chevron-icon"></i>
    </div>
    <div id="secClientConv" class="collapsible-content">
        <div class="dashboard-grid-layout">
            <div class="chart-main-panel">
                <div class="chart-panel-header">
                    <h4 class="chart-panel-title">Total Clients Converted</h4>
                    <div class="capsule-toggle">
                        <button class="capsule-btn" onclick="updateChartFilter(this, 'chart2', 'all')">1Y</button>
                        <button class="capsule-btn active" onclick="updateChartFilter(this, 'chart2', '6m')">6M</button>
                    </div>
                </div>
                <div style="font-size: 11px; color: #64748b; font-weight: 600; margin-bottom: 10px;">Prospects</div>
                <div class="chart-container" style="height: 320px;">
                    <canvas id="chart2"></canvas>
                </div>
                <p style="font-size: 11px; color: #94a3b8; margin-top: 15px;">Note: Total Prospect Pool is fixed for this period.</p>
            </div>
            <div class="side-metrics-panel">
                <div class="data-card">
                    <div class="data-card-title" style="display: flex; justify-content: space-between; align-items: center;">
                        <span>Month-on-Month</span>
                        <select class="month-selector" onchange="updateClientCard(this.value)" style="padding: 2px 8px; border-radius: 6px; border: 1px solid #cbd5e1; outline: none; font-weight: 600;">
                            @if (Model?.ProspectToClientMonthly != null)
                            {
                                foreach (var m in Model.ProspectToClientMonthly)
                                {
                                    <option value="@m.MonthLabel">@m.MonthLabel</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="data-row">
                        <span class="data-label">New Clients Added</span>
                        <span class="data-value val-green" id="clientNewAdded">0</span>
                    </div>
