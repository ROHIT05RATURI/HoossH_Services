<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - HoossH Service</title>

    <!-- Favicon & Fonts -->
    <link rel="icon" href="~/Images/Icon.ico" type="image/x-icon" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Stylesheets -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/NewCss.css">
    <link rel="stylesheet" href="~/css/TableCreation.css">
    <link rel="stylesheet" href="~/css/sweetalert2.min.css">
    <link rel="stylesheet" href="~/css/OverlayScrollbars.min.css">
    <link rel="stylesheet" href="~/css/HoosshNV.css">
    <link rel="stylesheet" href="~/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/Userkundali.css">
    <link rel="stylesheet" href="~/css/site.css">

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <link rel="stylesheet" href="~/css/LayoutINV/LayoutINV.css" />
</head>

<body class="hold-transition sidebar-mini sidebar-collapse layout-navbar-fixed">

    @{
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        bool isDashboard = currentController.Equals("Dashboard", StringComparison.OrdinalIgnoreCase);
        bool isAttendance = currentController.Equals("Team", StringComparison.OrdinalIgnoreCase)
            && (currentAction.Equals("Attendence", StringComparison.OrdinalIgnoreCase)
                || currentAction.Equals("ViewAttendence", StringComparison.OrdinalIgnoreCase));
        bool isLeaves = currentController.Equals("Team", StringComparison.OrdinalIgnoreCase)
            && (currentAction.Equals("LeaveManagement", StringComparison.OrdinalIgnoreCase)
                || currentAction.Equals("ViewApprovedHistory", StringComparison.OrdinalIgnoreCase));
        bool isHrmsSection = isAttendance || isLeaves;
        bool isVisits = currentController.Equals("Visit", StringComparison.OrdinalIgnoreCase);
        bool isClients = currentController.Equals("Client", StringComparison.OrdinalIgnoreCase);
        bool isProducts = currentController.Equals("UserProduct", StringComparison.OrdinalIgnoreCase);
    }

    <div id="global-loader" class="loader-overlay" style="display: none;">
        <div class="spinner"></div>
    </div>

    <div class="wrapper w-100">
        <!-- Top Navbar -->
        <nav class="main-header navbar navbar-expand navbar-light shadow-sm fixed-top">
            <div class="container-fluid">
                <ul class="navbar-nav align-items-center">
                    <li class="nav-item">
                        <a class="nav-link text-secondary" data-widget="pushmenu" href="#" role="button">
                            <i class="fas fa-bars fs-5"></i>
                        </a>
                    </li>
                </ul>

                <div class="navbar-title-center">
                    <h6 class="m-0">@ViewBag.Title</h6>
                </div>

                <ul class="navbar-nav align-items-center ms-auto">
                    <li class="nav-item me-3">
                        <a href="javascript:history.back()" class="nav-link text-secondary" title="Go Back">
                            <i class="fas fa-arrow-left fs-5"></i>
                        </a>
                    </li>
                    <li class="nav-item position-relative">
                        <img src="~/images/service-man.jpg" alt="Rahul Kumar" class="profile-icon-img cursor-pointer" id="profileMenuTrigger" />
                        <div id="profileDropdown" class="profile-dropdown shadow-sm">
                            <a href="" class="dropdown-item"><i class="fas fa-user me-2"></i> Profile</a>
                            <a href="/Dashboard/AllDashboard" class="dropdown-item"><i class="fas fa-scroll me-2"></i> Kundali</a>
                            <a href="/Login/Logout" class="dropdown-item text-danger"><i class="fas fa-sign-out-alt me-2"></i> Logout</a>
                        </div>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Sidebar Navigation -->
        <aside class="main-sidebar">
            <div class="sidebar" style="height: 100vh;">
                <div class="grow-nav-header">
                    <a class="nav-link text-secondary p-0 d-flex justify-content-between" data-widget="pushmenu" href="#" role="button">
                        <i class="fas fa-bars fs-5"></i>
                        <span class="bee-wrapper">
                            <span class="bee-fly-anim">
                                <img src="~/images/Icon.png" alt="HoossH Service" class="bee-img bee-flutter" style="height: 28px;" />
                            </span>
                        </span>
                    </a>
                </div>

                <div class="fb-menu-container">

                    <div class="fb-menu-heading">
                        <a href="@Url.Action("AllDashboard", "Dashboard")" class="text-decoration-none w-100 d-flex align-items-center text-dark url-link @(isDashboard ? "active" : "")">
                            <i class="fas fa-home grow-nav-icon"></i>
                            <span class="ms-2">Dashboard</span>
                        </a>
                    </div>

                    <div class="fb-menu-heading @(isHrmsSection ? "active" : "")" data-target="sec-hrms">
                        <div class="d-flex align-items-center">
                            <i class="fas fa-users grow-nav-icon"></i>
                            <span>HRMS</span>
                        </div>
                        <i class="fas fa-chevron-down fb-chevron"></i>
                    </div>
                    <div id="sec-hrms" class="fb-collapsible-content" style="display:@(isHrmsSection ? "block" : "none");">
                        <div class="fb-grid-row">
                            <a href="@Url.Action("Attendence", "Team")" class="fb-card url-link @(isAttendance ? "active" : "")">
                                <i class="fas fa-clock fb-card-icon"></i>
                                <span class="fb-card-title">Attendance</span>
                            </a>
                            <a href="@Url.Action("LeaveManagement", "Team")" class="fb-card url-link @(isLeaves ? "active" : "")">
                                <i class="fas fa-calendar-minus fb-card-icon"></i>
                                <span class="fb-card-title">Leaves</span>
                            </a>
                        </div>
                    </div>

                    <div class="fb-menu-heading">
                        <a href="@Url.Action("ViewRoutes", "Visit")" class="text-decoration-none w-100 d-flex align-items-center text-dark url-link @(isVisits ? "active" : "")">
                            <i class="fa-solid fa-clipboard-list grow-nav-icon"></i>
                            <span class="ms-2">Visits</span>
                        </a>
                    </div>

                    <div class="fb-menu-heading">
                        <a href="@Url.Action("AddClient", "Client")" class="text-decoration-none w-100 d-flex align-items-center text-dark url-link @(isClients ? "active" : "")">
                            <i class="fas fa-user-tie grow-nav-icon"></i>
                            <span class="ms-2">Clients</span>
                        </a>
                    </div>

                    <div class="fb-menu-heading">
                        <a href="@Url.Action("ProductList", "UserProduct")" class="text-decoration-none w-100 d-flex align-items-center text-dark url-link @(isProducts ? "active" : "")">
                            <i class="fa-solid fa-box-open grow-nav-icon"></i>
                            <span class="ms-2">Products Catalogue</span>
                        </a>
                    </div>

                    <div class="fb-menu-heading mt-3 border-top pt-2">
                        <a href="/Login/Logout" class="text-decoration-none w-100 d-flex align-items-center text-danger url-link">
                            <i class="fas fa-sign-out-alt grow-nav-icon text-danger"></i>
                            <span class="ms-2">Logout</span>
                        </a>
                    </div>
                </div>
            </div>
        </aside>
        <partial name="_BottomNavigation" />
        <!-- Main Content Area -->
        <div class="content-wrapper" style="background-color: var(--bg-light); min-height: 100vh; ">
            <section class="content px-3 py-4">
                <div class="container-fluid">
                    @RenderBody()
                </div>
            </section>
        </div>

        <footer class="main-footer text-muted text-center py-3 border-top bg-white">
            <small>&copy; @DateTime.Now.Year HoossH Service. All rights reserved.</small>
        </footer>
    </div>

    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adminlte.min.js">    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    <script>
            // Profile dropdown toggle
            const trigger = document.getElementById('profileMenuTrigger');
            const dropdown = document.getElementById('profileDropdown');

            if (trigger && dropdown) {
                trigger.addEventListener('click', function(e) {
                    e.stopPropagation();
                    dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
                });
                window.addEventListener('click', function() {
                    dropdown.style.display = 'none';
                });
            }

            // Collapsible sidebar menu handling
            document.querySelectorAll(".fb-menu-heading[data-target]").forEach(header => {
                header.addEventListener("click", function() {
                    const targetId = this.dataset.target;
                    const targetContent = document.getElementById(targetId);
                    if (targetContent) {
                        const isVisible = targetContent.style.display === "block";
                        targetContent.style.display = isVisible ? "none" : "block";
                        this.classList.toggle("active", !isVisible);
                    }
                });
            });

            // Close sidebar on navigation for mobile view
            function closeSidebar() {
                document.body.classList.add('sidebar-collapse');
            }
    </script>

    @if (isDashboard)
    {
        <script>
                document.querySelectorAll('[data-widget="pushmenu"]').forEach(function(btn) {
                    btn.addEventListener('click', function() {
                        setTimeout(function() {
                            if (!document.body.classList.contains('sidebar-collapse')) {
                                var beeAnim = document.querySelector('.bee-fly-anim');
                                if (beeAnim) {
                                    beeAnim.classList.remove('bee-fly-in');
                                    void beeAnim.offsetWidth; // forces reflow so animation replays every time
                                    beeAnim.classList.add('bee-fly-in');
                                }
                            }
                        }, 50);
                    });
                });
        </script>
    }

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>