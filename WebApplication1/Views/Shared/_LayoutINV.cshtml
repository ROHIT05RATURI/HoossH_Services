<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>@ViewBag.Title - HoossH Service</title>

    <!-- Favicon & Fonts -->
    <link rel="icon" href="~/images/logo.png" type="image/x-icon" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <!-- Bootstrap 5 & AdminLTE Styles -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="~/css/adminlte.min.css">
    <link rel="stylesheet" href="~/css/site.css">

    <link rel="stylesheet" href="~/css/Shared/LayoutINV.css" />
</head>
<body class="hold-transition sidebar-mini layout-fixed">
    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-light fixed-top">
            <div class="container-fluid">
                <ul class="navbar-nav">
                    <li class="nav-item">
                        <a class="nav-link" data-widget="pushmenu" href="#" role="button"><i class="fas fa-bars text-secondary"></i></a>
                    </li>
                    <li class="nav-item d-none d-sm-inline-block">
                        <span class="nav-link font-weight-bold text-dark">@ViewBag.Title</span>
                    </li>
                </ul>

                <!-- Right Navbar Links -->
                <ul class="navbar-nav ms-auto align-items-center">
                    <li class="nav-item dropdown">
                        <a class="nav-link dropdown-toggle d-flex align-items-center" href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fas fa-user-circle fs-5 text-primary me-2"></i>
                            <span></span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0" aria-labelledby="userDropdown">
                            <li><a class="dropdown-item" href="/User/Profile"><i class="fas fa-user me-2"></i> Profile</a></li>
                            <li><a class="dropdown-item" href="/User/ChangePassword"><i class="fas fa-key me-2"></i> Change Password</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item text-danger" href="/Auth/Login"><i class="fas fa-sign-out-alt me-2"></i> Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </nav>

        <!-- Main Sidebar Container based on Project Structure -->
        <aside class="main-sidebar sidebar-light-primary elevation-1">
            <a href="/" class="brand-link text-decoration-none">
                <img src="~/images/logo.png" alt="HoossH Logo" style="height: 32px;" class="me-2">
                <span class="font-weight-bold text-dark" style="font-size: 18px;">HoossH</span>
            </a>

            <div class="sidebar-menu-container">

                <!-- STANDARD USER / EMPLOYEE MENU -->
                <div class="text-muted small fw-bold px-3 mb-2 text-uppercase">Workspace</div>
                <a href="/User/Dashboard" class="menu-item @(ViewContext.RouteData.Values["action"]?.ToString() == "Dashboard" ? "active" : "")">
                    <i class="fas fa-tachometer-alt"></i> Dashboard
                </a>

                <!-- HRMS Dropdown -->
                <div class="menu-dropdown-toggle" onclick="toggleMenu('hrmsSub')">
                    <span><i class="fas fa-users-cog"></i> HRMS</span>
                    <i class="fas fa-chevron-down small"></i>
                </div>
                <div id="hrmsSub" class="menu-dropdown-container">
                    <a href="/Team/Attendence" class="menu-item"><i class="fas fa-clock"></i> Attendance</a>
                    <a href="/User/HRMS/Leave" class="menu-item"><i class="fas fa-calendar-minus"></i> Leaves</a>
                </div>

                <!-- Client Management -->
                <div class="menu-dropdown-toggle" onclick="toggleMenu('clientSub')">
                    <span><i class="fas fa-user-tie"></i> Clients</span>
                    <i class="fas fa-chevron-down small"></i>
                </div>
                <div id="clientSub" class="menu-dropdown-container">
                    <a href="/User/Client/ClientList" class="menu-item"><i class="fas fa-list"></i> Client List</a>
                    <a href="/User/Client/AddClient" class="menu-item"><i class="fas fa-user-plus"></i> Add Client</a>
                </div>

                <!-- Visit Management -->
                <div class="menu-dropdown-toggle" onclick="toggleMenu('visitSub')">
                    <span><i class="fas fa-map-marked-alt"></i> Visits</span>
                    <i class="fas fa-chevron-down small"></i>
                </div>
                <div id="visitSub" class="menu-dropdown-container">
                    <a href="/User/Visit/VisitList" class="menu-item"><i class="fas fa-route"></i> Visit List</a>
                    <a href="/User/Visit/AddVisit" class="menu-item"><i class="fas fa-plus-circle"></i> Add Visit</a>
                </div>

                <!-- Product Catalogue -->
                <div class="menu-dropdown-toggle" onclick="toggleMenu('productSub')">
                    <span><i class="fas fa-box-open"></i> Products</span>
                    <i class="fas fa-chevron-down small"></i>
                </div>
                <div id="productSub" class="menu-dropdown-container">
                    <a href="/User/Product/ProductList" class="menu-item"><i class="fas fa-boxes"></i> Catalogue</a>
                    <a href="/User/Product/AddProduct" class="menu-item"><i class="fas fa-folder-plus"></i> Add Product</a>
                </div>

                
                <hr class="my-3 text-muted">

                <div class="text-muted small fw-bold px-3 mb-2 text-uppercase">System</div>
                <a href="/User/Notifications" class="menu-item">
                    <i class="fas fa-bell"></i> Notifications
                </a>
                <a href="/Auth/Login" class="menu-item text-danger">
                    <i class="fas fa-sign-out-alt text-danger"></i> Logout
                </a>
            </div>
        </aside>

        <!-- Content Wrapper -->
        <div class="content-wrapper" style="margin-top: 56px;">
            <section class="content">
                <div class="container-fluid px-2">
                    @RenderBody()
                </div>
            </section>
        </div>

        <!-- Footer -->
        <footer class="main-footer text-center text-muted small py-3 bg-white border-top">
            <strong>Copyright &copy; @DateTime.Now.Year <span class="text-primary">HoossH Service</span>.</strong> All rights reserved.
        </footer>

    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.6/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/adminlte.min.js"></script>
    <script>
            function toggleMenu(id) {
                const element = document.getElementById(id);
                if (element.style.display === "block") {
                    element.style.display = "none";
                } else {
                    element.style.display = "block";
                }
            }
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
