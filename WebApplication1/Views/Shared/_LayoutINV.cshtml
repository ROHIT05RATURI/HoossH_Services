    <script>
        const trigger = document.getElementById('profileMenuTrigger');
        const dropdown = document.getElementById('profileDropdown');

        trigger.addEventListener('click', function(e) {
            e.stopPropagation();
            dropdown.style.display = dropdown.style.display === 'block' ? 'none' : 'block';
        });

        window.addEventListener('click', function() {
            dropdown.style.display = 'none';
        });

        function closeSidebar() {
            document.body.classList.add('sidebar-collapse');
            document.body.classList.remove('sidebar-open');
        }

        function closeSidebarAndNavigate(url) {
            closeSidebar();
            location.href = url;
        }

        document.addEventListener('click', function(event) {
            var sidebar = document.querySelector('.main-sidebar');
            var sidebarButton = document.querySelector('[data-widget="pushmenu"]');
            var body = document.body;
            var isOpen = !body.classList.contains('sidebar-collapse') || body.classList.contains('sidebar-open');

            if (isOpen) {
                if (sidebar && !sidebar.contains(event.target) && sidebarButton && !sidebarButton.contains(event.target)) {
                    closeSidebar();
                }
            }
        });
    </script>
    
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            var currentPath = window.location.pathname.toLowerCase();
            var navLinks = document.querySelectorAll('.url-link');
            var exactMatchFound = false;

            function activateMenu(link) {
                link.classList.add('active');

                var collapseParent = link.closest('.fb-collapsible-content');
                if (collapseParent) {
                    collapseParent.style.display = 'block';
                    var targetId = collapseParent.getAttribute('id');
                    var heading = document.querySelector('[data-target="' + targetId + '"]');
                    if (heading) {
                        heading.classList.add('active');
                        var chevron = heading.querySelector('.fb-chevron');
                        if (chevron) {
                            chevron.style.transform = 'rotate(180deg)';
                        }
                    }
                } else {
                    var directHeading = link.closest('.fb-menu-heading');
                    if(directHeading) {
                        directHeading.classList.add('active');
                    }
                }
            }

            navLinks.forEach(function (link) {
                var linkUrl = link.getAttribute('href');
                if (linkUrl && linkUrl !== '#') {
                    var anchor = document.createElement('a');
                    anchor.href = linkUrl;
                    var linkPath = anchor.pathname.toLowerCase();

                    if (currentPath === linkPath) {
                        exactMatchFound = true;
                        localStorage.setItem('activeSidebarMenu', linkUrl);
                        activateMenu(link);
                    }
                }
            });

            if (!exactMatchFound) {
                var savedMenuUrl = localStorage.getItem('activeSidebarMenu');
                if (savedMenuUrl) {
                    navLinks.forEach(function (link) {
                        var linkUrl = link.getAttribute('href');
                        if (linkUrl && linkUrl === savedMenuUrl) {
                            activateMenu(link);
                        }
                    });
                }
            }

            navLinks.forEach(function(link) {
                link.addEventListener('click', function() {
                    var href = this.getAttribute('href');
                    if(href && href !== '#') {
                        localStorage.setItem('activeSidebarMenu', href);
                    }
                });
            });
        });
    </script>

    <script>
        function showOfflinePopup() { document.getElementById("offlineModal").style.display = "block"; }
        function hideOfflinePopup() { document.getElementById("offlineModal").style.display = "none"; }
        window.addEventListener('offline', showOfflinePopup);
        window.addEventListener('online', hideOfflinePopup);
        if (!navigator.onLine) { showOfflinePopup(); }
    </script>
    
    <script>
        function toggleFbSection(sectionId, headerElement) {
            const targetContent = document.getElementById(sectionId);
            if (!targetContent) return;

            if (headerElement.classList.contains('active')) {
                targetContent.style.display = "none";
                headerElement.classList.remove("active");
                headerElement.querySelector('.fb-chevron').style.transform = 'rotate(0deg)';
            } else {
                document.querySelectorAll('.fb-collapsible-content').forEach(function(div) {
                    div.style.display = "none";
                });
                document.querySelectorAll('.fb-menu-heading').forEach(function(header) {
                    header.classList.remove("active");
                    let chevron = header.querySelector('.fb-chevron');
                    if(chevron) chevron.style.transform = 'rotate(0deg)';
                });
                targetContent.style.display = "block";
                headerElement.classList.add("active");
                headerElement.querySelector('.fb-chevron').style.transform = 'rotate(180deg)';
            }
        }

        document.addEventListener("DOMContentLoaded", () => {
            document.querySelectorAll(".fb-menu-heading[data-target]").forEach(el => {
                el.addEventListener("click", function () {
                    const targetId = this.dataset.target;
                    if(targetId) {
                        toggleFbSection(targetId, this);
                    }
                });
            });

            document.querySelectorAll(".url-link").forEach(link => {
                link.addEventListener("click", function (e) {
                    if(this.getAttribute('href') && this.getAttribute('href') !== '#') {
                        // Let browser navigate
                    } else {
                        e.preventDefault();
                    }
                });
            });
        });
    </script>

    @await Html.PartialAsync("_PremiumAlerts")
    @await Html.PartialAsync("_PremiumConfirm")

</body>
