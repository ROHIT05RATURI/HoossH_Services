

<style>
    :root {
        --footer-primary: #3f6791;
        --footer-primary-light: #eef4ff;
        --footer-text: #94a3b8;
        --footer-border: #dce6f2;
    }

    /* Space for the fixed bottom navigation */
    body {
        padding-bottom: 82px !important;
    }

    /* =====================================================
           BOTTOM APP BAR
           ===================================================== */

    .bottom-app-bar {
        position: fixed;
        left: 15px;
        right: 15px;
        bottom: 0;
        width: auto;
        height: 80px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 8px 12px 6px;
        background: #ffffff;
        border-radius: 26px 26px 0 0;
        box-shadow: 0 -4px 18px rgba(49, 79, 110, 0.08), 0 -1px 4px rgba(49, 79, 110, 0.04);
        z-index: 9999;
    }


        /* =====================================================
           NAV ITEM
           ===================================================== */

        .bottom-app-bar .nav-item {
            position: relative;
            height: 100%;
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 3px;
            text-decoration: none;
            color: var(--footer-text);
            font-size: 10px;
            font-weight: 600;
            line-height: 1.2;
            transition: color 0.2s ease, transform 0.2s ease;
        }


            /* =====================================================
           ICON
           ===================================================== */

            .bottom-app-bar .nav-item i {
                width: 38px;
                height: 32px;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 0;
                border-radius: 10px;
                color: var(--footer-primary);
                font-size: 18px;
                transition: background-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
            }


            /* =====================================================
           LABEL
           ===================================================== */

            .bottom-app-bar .nav-item span {
                display: block;
                max-width: 150px;
                color: inherit;
                font-size: 10px;
                font-weight: 600;
                white-space: nowrap;
                overflow: hidden;
                text-overflow: ellipsis;
                text-align: center;
            }


            /* =====================================================
           ACTIVE / HOVER
           ===================================================== */

            .bottom-app-bar .nav-item:hover {
                color: var(--footer-primary);
                transform: translateY(-1px);
            }

                .bottom-app-bar .nav-item:hover i {
                    background: var(--footer-primary-light);
                }

            .bottom-app-bar .nav-item.active {
                color: var(--footer-primary);
            }

                .bottom-app-bar .nav-item.active i {
                    background: var(--footer-primary-light);
                    color: var(--footer-primary);
                }


            /* =====================================================
           VERTICAL SEPARATORS
           ===================================================== */

            .bottom-app-bar .nav-item:not(:last-child)::after {
                content: "";
                position: absolute;
                right: 0;
                top: 50%;
                width: 1px;
                height: 32px;
                transform: translateY(-50%);
                background: var(--footer-border);
            }


        /* =====================================================
           REMOVE DEFAULT LINK EFFECTS
           ===================================================== */

        .bottom-app-bar a,
        .bottom-app-bar a:hover,
        .bottom-app-bar a:focus,
        .bottom-app-bar a:active {
            text-decoration: none;
        }


    /* =====================================================
           TABLET
           ===================================================== */

    @@media (max-width: 900px) {

        .bottom-app-bar {
            left: 10px;
            right: 10px;
            height: 74px;
            padding: 7px 8px 5px;
            border-radius: 23px 23px 0 0;
        }

            .bottom-app-bar .nav-item i {
                width: 36px;
                height: 30px;
                font-size: 17px;
            }

            .bottom-app-bar .nav-item span {
                font-size: 9px;
            }

        body {
            padding-bottom: 76px !important;
        }
    }


    /* =====================================================
           MOBILE
           ===================================================== */

    @@media (max-width: 600px) {

        .bottom-app-bar {
            left: 0;
            right: 0;
            height: 70px;
            padding: 6px 5px calc(5px + env(safe-area-inset-bottom));
            border-radius: 21px 21px 0 0;
        }

            .bottom-app-bar .nav-item {
                gap: 2px;
            }

                .bottom-app-bar .nav-item i {
                    width: 34px;
                    height: 28px;
                    font-size: 16px;
                    border-radius: 9px;
                }

                .bottom-app-bar .nav-item span {
                    max-width: 90px;
                    font-size: 8px;
                }

                .bottom-app-bar .nav-item:not(:last-child)::after {
                    height: 27px;
                }

        body {
            padding-bottom: 72px !important;
        }
    }


    /* =====================================================
           VERY SMALL MOBILE
           ===================================================== */

    @@media (max-width: 380px) {

        .bottom-app-bar {
            height: 66px;
        }

            .bottom-app-bar .nav-item i {
                width: 31px;
                height: 26px;
                font-size: 15px;
            }

            .bottom-app-bar .nav-item span {
                font-size: 7px;
            }

        body {
            padding-bottom: 68px !important;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .bottom-app-bar .nav-item,
        .bottom-app-bar .nav-item i {
            transition: none;
        }
    }
</style>

<nav class="bottom-app-bar">
    <a href="@Url.Action("AllDashboard","Dashboard")" class="nav-item">
        <i class="fas fa-home"></i>
        <span>Home</span>
    </a>

    <a href="@Url.Action("Addproduct", "Visit")" class="nav-item">
        <i class="fas fa-handshake"></i>
        <span>Add Product</span>
    </a>

    
    <a href="@Url.Action("Pricing", "Visit")" class="nav-item">
        <i class="fas fa-tags"></i> 
        <span>Pricing</span>
    </a>

    <a href="@Url.Action("Attendence", "Team")" class="nav-item">
        <i class="fas fa-comment-dots"></i> 
        <span>Feedback</span>
    </a>
</nav>   

<script>
    function handleMeetingClick(event) {
        event.preventDefault();
        $.ajax({
            url: '/Flow/CheckOngoingMeeting',
            type: 'GET',
            dataType: 'json',
            success: function(response) {
                if (response.success && response.hasMeeting) {
                    window.location.href = '/Flow/CustomerReport?id=' + response.customerId;
                } else {
                    Swal.fire({
                        title: "No Active Meeting",
                        text: "There is no ongoing meeting at the moment.",
                        icon: "warning",
                        confirmButtonColor: "#3f6791",
                        confirmButtonText: "OK"
                    });
                }
            },
            error: function() {
                window.location.href = '/Flow/CustomerReport';
            }
        });
    }
</script>
