    <a href="/Visit/Pricing" class="action-btn text-decoration-none">
        <i class="fas fa-tags"></i>
        <span>Pricing</span>
    </a>

    <!-- 4. Feedback -->
    <a href="/Visit/Feedback" class="action-btn text-decoration-none">
