<style>
    /* FIXED BOTTOM ACTIONS */
    .fixed-bottom-actions {
        position: fixed;
        bottom: 0;
        left: 0;
        width: 100%;
        background: #ffffff;
        padding: 10px 15px;
        box-shadow: 0 -5px 20px rgba(0,0,0,0.05);
        display: flex;
        gap: 8px;
        justify-content: center;
        z-index: 1055;
        height: 70px;
        border-top-left-radius: 20px;
        border-top-right-radius: 20px;
        border-top: 1px solid #e2e8f0;
    }

    .action-btn {
        flex: 1;
        max-width: 100px;
        padding: 8px;
        border-radius: 12px;
        font-weight: 600;
        font-size: 0.75rem;
        border: none;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        background: #eef2f7;
        color: #3f6791;
        cursor: pointer;
        transition: all 0.2s;
        text-decoration: none;
    }

        .action-btn i {
            font-size: 1.2rem;
        }

        .action-btn:active, .action-btn:hover {
            background: #3f6791;
            color: white;
        }
</style>

<!-- Adds bottom padding so content doesn't hide behind the navbar -->
<div style="padding-bottom: 80px;"></div>

<div id="checked" class="fixed-bottom-actions">
