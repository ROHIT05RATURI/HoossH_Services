@using HoossH_Services.Models
@using System.Security.Claims
@inject IHttpContextAccessor HttpContextAccessor
@model ResetPasswordViewModel

@{
    ViewBag.Title = "Update Credentials";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
    var user = HttpContextAccessor.HttpContext?.User;
    // Current logged-in user ka naam pre-fill karne ke liye
    var currentUsername = user?.FindFirst("UserName")?.Value;
}

<link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />

<style>
    :root {
        --app-bg: transparent;
        --panel-bg: #ffffff;
        --sidebar-bg: #7aa0c4;
        --accent-color: #3f6791;
        --text-main: #334155;
        --text-light: #94a3b8;
    }

    .page-centered-wrapper {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: calc(100vh - 120px);
        width: 100%;
        padding: 20px;
        box-sizing: border-box;
    }

    .settings-container {
        display: flex;
        flex-direction: row;
        width: 100%;
        max-width: 850px;
        background: var(--panel-bg);
        border-radius: 12px;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        min-height: 450px;
        border: 1px solid #e2e8f0;
    }

    .info-sidebar {
        width: 40%;
        background-color: var(--sidebar-bg);
        color: #ffffff;
        padding: 40px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

        .info-sidebar h2 {
            font-size: 26px;
            margin-bottom: 10px;
            font-weight: 600;
        }

        .info-sidebar p {
            color: #f8fafc;
            font-size: 14px;
            line-height: 1.6;
            margin-bottom: 30px;
        }

    .guidelines-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .guidelines-list li {
            margin-bottom: 15px;
            font-size: 14px;
            color: #f1f5f9;
            display: flex;
            align-items: center;
        }

            .guidelines-list li i {
                color: #ffffff;
                margin-right: 10px;
                font-size: 16px;
                width: 20px;
            }

    .form-area {
        width: 60%;
        padding: 30px 50px;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .form-header {
        margin-bottom: 20px;
        border-bottom: 1px solid #e2e8f0;
        padding-bottom: 10px;
    }

        .form-header h3 {
            color: var(--text-main);
            font-size: 22px;
            margin: 0;
        }

    .section-title {
        font-size: 15px;
        color: var(--accent-color);
        font-weight: 700;
        margin-bottom: 15px;
        margin-top: 10px;
        border-bottom: 1px dashed #cbd5e1;
        padding-bottom: 5px;
    }

    /* Radio Button Styles */
    .radio-group-container {
        display: flex;
        gap: 15px;
        margin-bottom: 20px;
        background: #f8fafc;
        padding: 12px 15px;
        border-radius: 8px;
        border: 1px solid #cbd5e1;
        flex-wrap: wrap;
    }

    .radio-option {
        display: flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        font-size: 14px;
        color: var(--text-main);
        font-weight: 600;
    }

        .radio-option input[type="radio"] {
            accent-color: var(--accent-color);
            width: 16px;
            height: 16px;
            cursor: pointer;
        }

    .form-group {
        margin-bottom: 15px;
    }

    .form-label {
        display: block;
        font-size: 13px;
        font-weight: 600;
        color: var(--text-main);
        margin-bottom: 5px;
    }

    .input-wrapper {
        position: relative;
    }

        .input-wrapper input {
            width: 100%;
            height: 40px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            padding: 0 40px 0 15px;
            font-size: 14px;
            color: var(--text-main);
            background: #f8fafc;
            transition: all 0.3s ease;
            box-sizing: border-box;
        }

            .input-wrapper input:focus {
                border-color: var(--accent-color);
                background: #fff;
                outline: none;
                box-shadow: 0 0 0 3px rgba(63, 103, 145, 0.15);
            }

    .input-icon, .toggle-password {
        position: absolute;
        right: 15px;
        top: 12px;
        color: var(--text-light);
    }

    .toggle-password {
        cursor: pointer;
    }

    .btn-update {
        width: 100%;
        height: 45px;
        background: var(--accent-color);
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        margin-top: 15px;
        transition: background 0.3s;
    }

        .btn-update:hover {
            background: #2c4d6d;
        }

        .btn-update:disabled {
            background: #94a3b8;
            cursor: not-allowed;
        }

    .password-error {
        color: #ef4444;
        font-size: 13px;
        margin-top: 5px;
        display: none;
    }

    @@media (max-width: 768px) {
        .settings-container {
            flex-direction: column;
        }

        .info-sidebar, .form-area {
            width: 100%;
            padding: 30px;
        }
    }
</style>

<div class="page-centered-wrapper">
    <div class="settings-container">

        <div class="info-sidebar">
            <h2>Account Security</h2>
            <p>Verify your current identity before updating your credentials.</p>

            <ul class="guidelines-list">
                <li><i class="fa fa-shield-halved"></i> Identity Verification Required</li>
                <li><i class="fa fa-user"></i> Choose a unique new username</li>
                <li><i class="fa fa-lock"></i> New Password must be 8+ characters</li>
            </ul>
        </div>

        <div class="form-area">
            <div class="form-header">
                <h3>Update Credentials</h3>
            </div>

            <form id="ajaxResetForm">
                @Html.AntiForgeryToken()
                <input type="hidden" id="Token" value="@Model?.Token" />

                <!-- Verification Section (Always Visible) -->
                <div class="section-title">Step 1: Verify Current Identity</div>
                <div class="form-group">
                    <label class="form-label">Old Username</label>
                    <div class="input-wrapper">
                        <input type="text" id="OldUsername" name="OldUsername" value="@currentUsername" placeholder="Enter current username" required />
                        <i class="fa fa-user input-icon"></i>
                    </div>
                </div>
                <div class="form-group">
                    <label class="form-label">Old Password</label>
                    <div class="input-wrapper">
                        <input type="password" id="OldPassword" name="OldPassword" placeholder="Enter current password" required />
                        <i class="fa fa-eye toggle-password" onclick="togglePassword('OldPassword', this)"></i>
                    </div>
                </div>

                <div class="section-title" style="margin-top: 25px;">Step 2: Choose What to Change</div>
                <!-- Radio Buttons -->
                <div class="radio-group-container">
                    <label class="radio-option">
                        <input type="radio" name="UpdateSelection" value="password" checked />
                        Password
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="UpdateSelection" value="username" />
                        Username
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="UpdateSelection" value="both" />
                        Both
                    </label>
                </div>

                <!-- New Username Section (Hidden initially) -->
                <div id="sectionNewUsername" style="display: none;">
                    <div class="form-group">
                        <label class="form-label">New Username</label>
                        <div class="input-wrapper">
                            <input type="text" id="NewUsername" name="NewUsername" placeholder="Enter new username" />
                            <i class="fa fa-user-pen input-icon"></i>
                        </div>
                    </div>
                </div>

                <!-- New Password Section -->
                <div id="sectionNewPassword">
                    <div class="form-group">
                        <label class="form-label">New Password</label>
                        <div class="input-wrapper">
                            <input type="password" id="NewPassword" name="NewPassword" placeholder="Enter new password" required />
                            <i class="fa fa-eye toggle-password" onclick="togglePassword('NewPassword', this)"></i>
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">Confirm New Password</label>
                        <div class="input-wrapper">
                            <input type="password" id="ConfirmPassword" name="ConfirmPassword" placeholder="Re-enter new password" required />
                            <i class="fa fa-eye toggle-password" onclick="togglePassword('ConfirmPassword', this)"></i>
                        </div>
                        <div id="passwordError" class="password-error">
                            <i class="fa fa-circle-exclamation"></i> New passwords do not match.
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn-update" id="submitBtn">
                    Verify & Save Changes
                </button>
            </form>
        </div>

    </div>
</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    function togglePassword(inputId, icon) {
        const input = document.getElementById(inputId);
        if (input.type === "password") {
            input.type = "text";
            icon.classList.replace("fa-eye", "fa-eye-slash");
        } else {
            input.type = "password";
            icon.classList.replace("fa-eye-slash", "fa-eye");
        }
    }

    $(document).ready(function() {

        // Radio Button Toggle Logic
        $('input[name="UpdateSelection"]').on('change', function() {
            const selection = $(this).val();

            if (selection === 'password') {
                $('#sectionNewUsername').slideUp();
                $('#sectionNewPassword').slideDown();

                $('#NewUsername').removeAttr('required').val(''); // clear and unrequire
                $('#NewPassword, #ConfirmPassword').attr('required', 'required');
            }
            else if (selection === 'username') {
                $('#sectionNewPassword').slideUp();
                $('#sectionNewUsername').slideDown();

                $('#NewPassword, #ConfirmPassword').removeAttr('required').val(''); // clear and unrequire
                $('#NewUsername').attr('required', 'required');
            }
            else if (selection === 'both') {
                $('#sectionNewUsername').slideDown();
                $('#sectionNewPassword').slideDown();

                $('#NewUsername, #NewPassword, #ConfirmPassword').attr('required', 'required');
            }
        });

        // Form Submit hone par
        $("#ajaxResetForm").on("submit", function(e) {
            e.preventDefault();

            // Puraane credentials collect karna
            const oldUsername = $("#OldUsername").val().trim();
            const oldPassword = $("#OldPassword").val();

            if (!oldUsername || !oldPassword) {
                Swal.fire({ icon: 'warning', title: 'Required', text: 'Please enter your Current Username and Password to verify your identity.' });
                return;
            }

            const selection = $('input[name="UpdateSelection"]:checked').val();
            let newUsername = "";
            let newPassword = "";
            let confirm = "";

            // Naye credentials collect karna validation ke saath
            if (selection === 'username' || selection === 'both') {
                newUsername = $("#NewUsername").val().trim();
                if (!newUsername) {
                    Swal.fire({ icon: 'warning', title: 'Required', text: 'New Username cannot be empty!' });
                    return;
                }
            }

            if (selection === 'password' || selection === 'both') {
                newPassword = $("#NewPassword").val();
                confirm = $("#ConfirmPassword").val();

                if (newPassword !== confirm) {
                    $("#passwordError").fadeIn();
                    return;
                } else {
                    $("#passwordError").fadeOut();
                }
            }

            const token = $("#Token").val();
            const antiForgeryToken = $('input[name="__RequestVerificationToken"]').val();

            const $btn = $("#submitBtn");
            const originalText = $btn.html();
            $btn.html('<i class="fa fa-spinner fa-spin"></i> Verifying...').prop('disabled', true);

            // AJAX Call
            $.ajax({
                url: '/Home/ResetCredentials', // Zaroorat padne par apna Controller Name yaha dalein
                type: 'POST',
                data: {
                    OldUsername: oldUsername,
                    OldPassword: oldPassword,
                    NewUsername: newUsername,
                    NewPassword: newPassword,
                    Token: token,
                    __RequestVerificationToken: antiForgeryToken
                },
                success: function(response) {
                    if (response.success) {
                        Swal.fire({
                            icon: 'success',
                            title: 'Verified & Updated!',
                            text: response.message || 'Credentials updated successfully.',
                            confirmButtonColor: '#3f6791'
                        }).then(() => {
                            window.location.href = '/Login/Index'; // Update hone ke baad kahan redirect karna hai
                        });
                    } else {
                        Swal.fire({
                            icon: 'error',
                            title: 'Verification Failed',
                            text: response.message || 'Failed to update credentials. Please check your old username/password.',
                            confirmButtonColor: '#3f6791'
                        });
                    }
                },
                error: function() {
                    Swal.fire({
                        icon: 'error',
                        title: 'Error!',
                        text: 'Something went wrong. Please try again later.',
                        confirmButtonColor: '#3f6791'
                    });
                },
                complete: function() {
                    $btn.html(originalText).prop('disabled', false);
                }
            });
        });
    });
</script>