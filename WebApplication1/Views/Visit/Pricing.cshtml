                price: 1800
            }
        ]

    };


    /* =========================================================
       CURRENT PRODUCT

       For now this is a sample product.

       Later you can populate this from:
       - Route parameter
       - ViewModel
       - TempData
       - Session
       - Database
       - API
    ========================================================= */

    const currentProduct = "Split AC 1.5 Ton";


    /* =========================================================
       DOM ELEMENTS
    ========================================================= */

    const partsContainer =
        document.getElementById("partsContainer");

    const addPartBtn =
        document.getElementById("addPartBtn");

    const serviceChargeInput =
        document.getElementById("serviceCharge");

    const gstPercentage =
        document.getElementById("gstPercentage");


    /* =========================================================
       CURRENCY FORMAT
    ========================================================= */

    function formatCurrency(value) {

        return new Intl.NumberFormat("en-IN", {

            style: "currency",

            currency: "INR",

            minimumFractionDigits: 2,

            maximumFractionDigits: 2

        }).format(value || 0);

    }


    /* =========================================================
       CREATE PART OPTIONS
    ========================================================= */

    function createPartOptions() {

        const parts =
            productParts[currentProduct] || [];

        let html =
            `<option value="">Choose part...</option>`;

        parts.forEach(function(part) {

            html += `
                    <option
                        value="${part.id}"
                        data-price="${part.price}">
                        ${part.name}
                    </option>
                `;

        });

        return html;
    }


    /* =========================================================
       ADD PART ROW
    ========================================================= */

    function addPartRow() {

        const row =
            document.createElement("tr");

        row.className = "part-row";

        row.innerHTML = `

                <td class="part-number">
                    1
                </td>

                <td>

                    <select
                        class="part-select"
                        name="Parts[0].PartId">

                        ${createPartOptions()}

                    </select>

                </td>

                <td>

                    <input
                        type="number"
                        class="quantity-input"
                        name="Parts[0].Quantity"
                        value="1"
                        min="1"
                        step="1">

                </td>

                <td>

                    <input
                        type="number"
                        class="price-input"
                        name="Parts[0].UnitPrice"
                        value="0"
                        min="0"
                        step="0.01"
                        placeholder="0.00">

                </td>

                <td class="amount-cell">
                    ₹0.00
                </td>

                <td>

                    <button
                        type="button"
                        class="remove-part"
                        title="Remove Part">

                        <i class="fas fa-trash"></i>

                    </button>

                </td>

            `;


        partsContainer.appendChild(row);


        attachRowEvents(row);

        updateIndexes();

        updateTotals();

    }


    /* =========================================================
       ATTACH EVENTS TO ROW
    ========================================================= */

    function attachRowEvents(row) {

        const partSelect =
            row.querySelector(".part-select");

        const quantityInput =
            row.querySelector(".quantity-input");

        const priceInput =
            row.querySelector(".price-input");

        const removeButton =
            row.querySelector(".remove-part");


        /* ---------------------------------------------
           PART SELECT
        --------------------------------------------- */

        partSelect.addEventListener("change", function() {

            const selectedOption =
                this.options[this.selectedIndex];

            const price =
                selectedOption.dataset.price;

            if (price) {

                priceInput.value = price;

            }

            updateTotals();

        });


        /* ---------------------------------------------
           QUANTITY
        --------------------------------------------- */

        quantityInput.addEventListener("input", function() {

            if (this.value < 1) {

                this.value = 1;

            }

            updateTotals();

        });


        /* ---------------------------------------------
           PRICE
        --------------------------------------------- */

        priceInput.addEventListener("input", function() {

            if (this.value < 0) {

                this.value = 0;

            }

            updateTotals();

        });


        /* ---------------------------------------------
           REMOVE
        --------------------------------------------- */

        removeButton.addEventListener("click", function() {

            row.remove();

            updateIndexes();

            updateTotals();

        });

    }


    /* =========================================================
       UPDATE ROW INDEXES

       Required for ASP.NET MVC model binding.
    ========================================================= */

    function updateIndexes() {

        const rows =
            document.querySelectorAll(".part-row");


        rows.forEach(function(row, index) {

            row.querySelector(".part-number").textContent =
                index + 1;


            row.querySelector(".part-select").name =
                `Parts[${index}].PartId`;


            row.querySelector(".quantity-input").name =
                `Parts[${index}].Quantity`;


            row.querySelector(".price-input").name =
                `Parts[${index}].UnitPrice`;

        });

    }


    /* =========================================================
       CALCULATE TOTALS
    ========================================================= */

    function updateTotals() {

        const rows =
            document.querySelectorAll(".part-row");

        let partsSubtotal = 0;


        rows.forEach(function(row) {

            const quantity =
                parseFloat(
                    row.querySelector(".quantity-input").value
                ) || 0;


            const unitPrice =
                parseFloat(
                    row.querySelector(".price-input").value
                ) || 0;


            const amount =
                quantity * unitPrice;


            row.querySelector(".amount-cell").textContent =
                formatCurrency(amount);


            partsSubtotal += amount;

        });


        const serviceCharge =
            parseFloat(serviceChargeInput.value) || 0;


        const subtotal =
            partsSubtotal + serviceCharge;


        const gstRate =
            parseFloat(gstPercentage.value) || 0;


        const gstAmount =
            subtotal * gstRate / 100;


        const grandTotal =
            subtotal + gstAmount;


        document.getElementById("partsSubtotal")
            .textContent =
            formatCurrency(partsSubtotal);


        document.getElementById("serviceChargeDisplay")
            .textContent =
            formatCurrency(serviceCharge);


        document.getElementById("subtotal")
            .textContent =
            formatCurrency(subtotal);


        document.getElementById("gstAmount")
            .textContent =
            formatCurrency(gstAmount);


        document.getElementById("grandTotal")
            .textContent =
            formatCurrency(grandTotal);

    }


    /* =========================================================
       SERVICE CHARGE EVENT
    ========================================================= */

    serviceChargeInput.addEventListener(
        "input",
        function() {

            if (this.value < 0) {

                this.value = 0;

            }

            updateTotals();

        }
    );


    /* =========================================================
       GST EVENT
    ========================================================= */

    gstPercentage.addEventListener(
        "change",
        updateTotals
    );


    /* =========================================================
       ADD PART
    ========================================================= */

    addPartBtn.addEventListener(
        "click",
        addPartRow
    );


    /* =========================================================
       INITIAL ROW
    ========================================================= */

    addPartRow();


    /* =========================================================
       INITIAL TOTAL
    ========================================================= */

    updateTotals();


    /* =========================================================
       SAVE DRAFT
    ========================================================= */

    document.getElementById("saveDraftBtn")
        .addEventListener("click", function() {

            /*
             * Connect this button to your controller later.
             *
             * Example:
             *
             * form.submit();
             *
             */

            console.log("Save Draft clicked.");

        });


    /* =========================================================
       COMPLETE
    ========================================================= */

    document.getElementById("completeBtn")
        .addEventListener("click", function() {

            /*
             * Connect this button to your controller later.
             *
             * Before submitting, you can validate:
             *
             * - Product
             * - Parts
             * - Quantity
             * - Prices
             * - Service charge
             * - GST
             */

            console.log("Complete Service Pricing clicked.");

        });

</script>