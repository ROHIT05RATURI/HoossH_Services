                price: 450
            },
            {
                id: 407,
                name: "Bearing",
                price: 900
            }
        ],


        "Microwave Oven 32L": [
            {
                id: 501,
                name: "Magnetron",
                price: 2200
            },
            {
                id: 502,
                name: "High Voltage Capacitor",
                price: 850
            },
            {
                id: 503,
                name: "Diode",
                price: 350
