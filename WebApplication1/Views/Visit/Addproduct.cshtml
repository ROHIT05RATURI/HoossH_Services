                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label asp-for="CategoryId"
                                           class="ap-field-label">
                                        Category
                                    </label>

                                    <span class="ap-field-req">
                                        Required
                                    </span>

                                </div>

                                <select asp-for="CategoryId"
                                        id="CategoryId"
                                        class="ap-input">

                                    <option value="">
                                        Choose category...
                                    </option>

                                    <option value="1">
                                        Electronics
                                    </option>

                                    <option value="2">
                                        Home Appliances
                                    </option>

                                    <option value="3">
                                        HVAC
                                    </option>

                                    <option value="4">
                                        Kitchen Appliances
                                    </option>

                                    <option value="5">
                                        Furniture
                                    </option>

                                    <option value="6">
                                        Fashion
                                    </option>

                                    <option value="7">
                                        Electrical &amp; Wiring
                                    </option>

                                    <option value="8">
                                        Plumbing &amp; Fittings
                                    </option>

                                    <option value="9">
                                        Security &amp; Surveillance
                                    </option>

                                    <option value="10">
                                        Computers &amp; Networking
                                    </option>

                                </select>

                                <span asp-validation-for="CategoryId"
                                      class="text-danger">
                                </span>

                            </div>


                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label asp-for="SubCategoryId"
                                           class="ap-field-label">
                                        Subcategory
                                    </label>

                                    <span class="ap-field-req">
                                        Required
                                    </span>

                                </div>

                                <select asp-for="SubCategoryId"
                                        id="SubCategoryId"
                                        class="ap-input">

                                    <option value="">
                                        Choose category first...
                                    </option>

                                    <!-- Electronics -->

                                    <option value="101" data-cat="1">
                                        Television &amp; Video
                                    </option>

                                    <option value="102" data-cat="1">
                                        Audio &amp; Home Theatre
                                    </option>

                                    <option value="103" data-cat="1">
                                        Mobile Accessories
                                    </option>

                                    <option value="104" data-cat="1">
                                        Cameras &amp; Drones
                                    </option>


                                    <!-- Home Appliances -->

                                    <option value="201" data-cat="2">
                                        Refrigerator
                                    </option>

                                    <option value="202" data-cat="2">
                                        Washing Machine
                                    </option>

                                    <option value="203" data-cat="2">
                                        Water Purifier
                                    </option>

                                    <option value="204" data-cat="2">
                                        Vacuum Cleaner
                                    </option>


                                    <!-- HVAC -->

                                    <option value="301" data-cat="3">
                                        Split AC
                                    </option>

                                    <option value="302" data-cat="3">
                                        Window AC
                                    </option>

                                    <option value="303" data-cat="3">
                                        Air Cooler
                                    </option>

                                    <option value="304" data-cat="3">
                                        Room Heater
                                    </option>

                                    <option value="305" data-cat="3">
                                        Exhaust &amp; Ventilation
                                    </option>


                                    <!-- Kitchen Appliances -->

                                    <option value="401" data-cat="4">
                                        Microwave &amp; OTG
                                    </option>

                                    <option value="402" data-cat="4">
                                        Mixer Grinder &amp; Blender
                                    </option>

                                    <option value="403" data-cat="4">
                                        Chimney &amp; Hob
                                    </option>

                                    <option value="404" data-cat="4">
                                        Gas Stove &amp; Induction
                                    </option>


                                    <!-- Furniture -->

                                    <option value="501" data-cat="5">
                                        Sofas &amp; Recliners
                                    </option>

                                    <option value="502" data-cat="5">
                                        Chairs &amp; Seating
                                    </option>

                                    <option value="503" data-cat="5">
                                        Tables &amp; Desks
                                    </option>

                                    <option value="504" data-cat="5">
                                        Wardrobes &amp; Storage
                                    </option>


                                    <!-- Fashion -->

                                    <option value="601" data-cat="6">
                                        Men's Clothing
                                    </option>

                                    <option value="602" data-cat="6">
                                        Women's Clothing
                                    </option>

                                    <option value="603" data-cat="6">
                                        Footwear
                                    </option>

                                    <option value="604" data-cat="6">
                                        Accessories
                                    </option>


                                    <!-- Electrical -->

                                    <option value="701" data-cat="7">
                                        Switches &amp; Sockets
                                    </option>

                                    <option value="702" data-cat="7">
                                        Inverters &amp; Stabilizers
                                    </option>

                                    <option value="703" data-cat="7">
                                        Wiring &amp; Cables
                                    </option>

                                    <option value="704" data-cat="7">
                                        Lighting &amp; Fixtures
                                    </option>


                                    <!-- Plumbing -->

                                    <option value="801" data-cat="8">
                                        Taps &amp; Faucets
                                    </option>

                                    <option value="802" data-cat="8">
                                        Pipes &amp; Fittings
                                    </option>

                                    <option value="803" data-cat="8">
                                        Water Tanks &amp; Pumps
                                    </option>

                                    <option value="804" data-cat="8">
                                        Bathroom Fittings
                                    </option>


                                    <!-- Security -->

                                    <option value="901" data-cat="9">
                                        CCTV Cameras
                                    </option>

                                    <option value="902" data-cat="9">
                                        Video Door Phones
                                    </option>

                                    <option value="903" data-cat="9">
                                        Smart Locks
                                    </option>

                                    <option value="904" data-cat="9">
                                        Alarm Systems
                                    </option>


                                    <!-- Computers -->

                                    <option value="1001" data-cat="10">
                                        Laptops &amp; Desktops
                                    </option>

                                    <option value="1002" data-cat="10">
                                        Printers &amp; Scanners
                                    </option>

                                    <option value="1003" data-cat="10">
                                        Routers &amp; Networking
