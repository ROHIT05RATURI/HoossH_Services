                    </div>


                    <!-- =================================================
                     SERVICE DETAILS
                ================================================== -->

                    <div class="ap-section">

                        <div class="ap-section-heading">

                            <i class="fas fa-screwdriver-wrench"></i>

                            <span>Service Details</span>

                        </div>


                        <!-- Service Type / Priority -->

                        <div class="ap-field-grid">

                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label for="ServiceType"
                                           class="ap-field-label">
                                        Service Type
                                    </label>

                                </div>

                                <select id="ServiceType"
                                        name="ServiceType"
                                        class="ap-input">

                                    <option value="">
                                        Choose service type...
                                    </option>

                                    <option value="Repair">
                                        Repair
                                    </option>

                                    <option value="Maintenance">
                                        Maintenance
                                    </option>

                                    <option value="Installation">
                                        Installation
                                    </option>

                                    <option value="Inspection">
                                        Inspection
                                    </option>

                                </select>

                            </div>


                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label for="Priority"
                                           class="ap-field-label">
                                        Priority
                                    </label>

                                </div>

                                <select id="Priority"
                                        name="Priority"
                                        class="ap-input">

                                    <option value="">
                                        Choose priority...
                                    </option>

                                    <option value="Low">
                                        Low
                                    </option>

                                    <option value="Medium">
                                        Medium
                                    </option>

                                    <option value="High">
                                        High
                                    </option>

                                    <option value="Urgent">
                                        Urgent
                                    </option>

                                </select>

                            </div>

                        </div>


                        <!-- Problem / Complaint -->

                        <div class="ap-field-grid full">

                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label for="Problem"
                                           class="ap-field-label">
                                        Problem / Complaint
                                    </label>

                                </div>

                                <textarea id="Problem"
                                          name="Problem"
                                          class="ap-input"
                                          rows="4"
                                          placeholder="Describe the issue reported by the customer..."></textarea>

                            </div>

                        </div>

                    </div>


                    <!-- =================================================
                     DESCRIPTION
                ================================================== -->

                    <div class="ap-section">

                        <div class="ap-section-heading">

                            <i class="fas fa-align-left"></i>

                            <span>Additional Information</span>

                        </div>


                        <div class="ap-field-grid full">

                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label asp-for="Description"
                                           class="ap-field-label">
                                        Description
                                    </label>

                                </div>

                                <textarea asp-for="Description"
                                          class="ap-input"
                                          rows="4"
                                          placeholder="Add any additional product or service information..."></textarea>

                                <span asp-validation-for="Description"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                 FOOTER
            ================================================== -->

                <div class="ap-form-footer">

                    <a href="javascript:history.back()"
                       class="ap-btn ap-btn-ghost">

                        Cancel

                    </a>

                    <button type="submit"
                            class="ap-btn ap-btn-primary">

                        <i class="fas fa-plus"></i>

                        Add Service Product

                    </button>

                </div>

            </div>

        </form>

    </div>
    

</div>

<script>

    document.addEventListener("DOMContentLoaded", function() {

        const categorySelect =
            document.getElementById("CategoryId");

        const subCategorySelect =
            document.getElementById("SubCategoryId");

        if (!categorySelect || !subCategorySelect) {
            return;
        }


        /*
         * Store the original subcategory options.
         */

        const allSubOptions =
            Array.from(subCategorySelect.options)
                .filter(function(option) {
                    return option.value !== "";
                });


        /*
         * Filter subcategories whenever
         * the category changes.
         */

        function filterSubcategories() {

            const selectedCategory =
                categorySelect.value;


            /*
             * Clear existing options.
             */

            subCategorySelect.innerHTML = "";


            /*
             * Add correct placeholder.
             */

            const placeholder =
                document.createElement("option");

            placeholder.value = "";

            placeholder.textContent =
                selectedCategory
                    ? "Choose subcategory..."
                    : "Choose category first...";

            subCategorySelect.appendChild(placeholder);


            /*
             * Add only subcategories
             * belonging to selected category.
             */

            allSubOptions.forEach(function(option) {

                if (option.dataset.cat === selectedCategory) {

                    subCategorySelect.appendChild(
                        option.cloneNode(true)
                    );

                }

            });

        }


        /*
         * Category change event.
         */

        categorySelect.addEventListener(
            "change",
            filterSubcategories
        );


        /*
         * Handle edit/postback scenarios.
         */

        if (categorySelect.value) {

            filterSubcategories();

        }

    });

</script>
