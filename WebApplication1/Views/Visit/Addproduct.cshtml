                                       placeholder="e.g. 1.5 Ton Inverter AC" />

                                <span asp-validation-for="Name"
                                      class="text-danger">
                                </span>

                            </div>

                        </div>


                        <!-- Model / Serial -->

                        <div class="ap-field-grid">

                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label for="ModelNo"
                                           class="ap-field-label">
                                        Model Number
                                    </label>

                                    <span class="ap-field-req">
                                        Required
                                    </span>

                                </div>

                                <input type="text"
                                       name="ModelNo"
                                       id="ModelNo"
                                       class="ap-input"
                                       placeholder="e.g. LS-Q18YNZA"
