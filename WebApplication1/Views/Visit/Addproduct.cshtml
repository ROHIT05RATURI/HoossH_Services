                            </div>


                            <div class="ap-field">

                                <div class="ap-field-label-row">

                                    <label for="SerialNo"
                                           class="ap-field-label">
                                        Serial Number
                                    </label>

                                    <span class="ap-field-req">
                                        Required
                                    </span>

                                </div>

                                <input type="text"
                                       name="SerialNo"
                                       id="SerialNo"
                                       class="ap-input"
                                       placeholder="e.g. 053HHCW400123P"
