@using HoossH_Services.Models
@model AddProductViewModel

@{
    ViewBag.Title = "Add Service Product";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
}


<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<style>
    :root {
        --teal-900: #0d4a52;
        --teal-800: #0f5c66;
        --teal-700: #14707c;
        --teal-600: #1a8a97;
        --teal-50: #eef8f8;
        --ink: #152028;
        --ink-soft: #5b6b76;
        --line: #e2e7ec;
        --card: #ffffff;
        --bg: #f4f6f8;
    }

    /* =====================================================
           PAGE
        ===================================================== */

    .ap-page {
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        color: var(--ink);
        background: var(--bg);
        min-height: 100vh;
        padding: 32px 20px 60px;
    }

    .ap-container {
        max-width: 820px;
        margin: 0 auto;
    }

    /* =====================================================
           FORM CARD
        ===================================================== */

    
    .ap-form-card {
        background: var(--card);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: rgba(0, 0, 0, 0.4) 0px 2px 4px, rgba(0, 0, 0, 0.3) 0px 7px 13px -3px, rgba(0, 0, 0, 0.2) 0px -3px 0px inset;
    }
    /* =====================================================
           HEADER
        ===================================================== */

    .ap-form-header {
        padding: 28px 34px 24px;
        
        background: linear-gradient( 180deg, var(--teal-50) 0%, #ffffff 100% );
    }

    .ap-form-title {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0 0 5px;
        font-size: 22px;
        font-weight: 800;
        letter-spacing: -0.35px;
    }

        .ap-form-title i {
            color: var(--teal-700);
            font-size: 19px;
        }

    .ap-form-sub {
        margin: 0;
        color: var(--ink-soft);
        font-size: 13.5px;
        line-height: 1.5;
    }

    /* =====================================================
           BODY
        ===================================================== */

    .ap-form-body {
        padding: 30px 34px 8px;
    }

    /* =====================================================
           SECTION
        ===================================================== */

    .ap-section {
        margin-bottom: 30px;
    }

        .ap-section:last-child {
            margin-bottom: 10px;
        }

    .ap-section-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 18px;
        padding-bottom: 11px;
        border-bottom: 1px solid var(--line);
    }

        .ap-section-heading i {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 8px;
            background: var(--teal-50);
            color: var(--teal-700);
            font-size: 12px;
        }

        .ap-section-heading span {
            font-size: 13px;
            font-weight: 800;
            color: var(--ink);
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

    /* =====================================================
           GRID
        ===================================================== */

    .ap-field-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px 22px;
        margin-bottom: 20px;
    }

        .ap-field-grid:last-child {
            margin-bottom: 0;
        }

        .ap-field-grid.full {
            grid-template-columns: 1fr;
        }

    /* =====================================================
           FIELD
        ===================================================== */

    .ap-field {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

    .ap-field-label-row {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
    }

    .ap-field-label {
        font-size: 12.5px;
        font-weight: 800;
        color: var(--ink);
    }

    .ap-field-req {
        font-size: 10px;
        font-weight: 700;
        color: #9aa7b0;
        text-transform: uppercase;
        letter-spacing: 0.35px;
    }

    /* =====================================================
           INPUTS
        ===================================================== */

    .ap-input,
    select.ap-input,
    textarea.ap-input {
        width: 100%;
        box-sizing: border-box;
        border: 1.5px solid var(--line);
        border-radius: 10px;
        padding: 11px 13px;
        font-family: inherit;
        font-size: 13.5px;
        color: var(--ink);
        background: #fbfcfd;
        transition: border-color 0.15s ease, background 0.15s ease, box-shadow 0.15s ease;
    }

        .ap-input::placeholder {
            color: #a4afb6;
        }

        .ap-input:hover {
            border-color: #c5d2d6;
        }

        .ap-input:focus {
            outline: none;
            border-color: var(--teal-600);
            background: #ffffff;
            box-shadow: 0 0 0 3px rgba(26, 138, 151, 0.11);
        }

    /* =====================================================
           SELECT
        ===================================================== */

    select.ap-input {
        appearance: none;
        -webkit-appearance: none;
        background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 24 24' fill='none' stroke='%235b6b76' stroke-width='2.5'><path d='M6 9l6 6 6-6'/></svg>");
        background-repeat: no-repeat;
        background-position: right 13px center;
        padding-right: 38px;
        cursor: pointer;
    }

    /* =====================================================
           TEXTAREA
        ===================================================== */

    textarea.ap-input {
        min-height: 120px;
        resize: vertical;
        line-height: 1.6;
    }

    /* =====================================================
           VALIDATION
        ===================================================== */

    .text-danger {
        display: block;
        margin-top: 2px;
        color: #dc3545;
        font-size: 11.5px;
    }

    /* =====================================================
           FOOTER
        ===================================================== */

    .ap-form-footer {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        gap: 10px;
        padding: 22px 34px 28px;
        border-top: 1px solid var(--line);
        background: #fcfdfd;
    }

    /* =====================================================
           BUTTONS
        ===================================================== */

    .ap-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 42px;
        padding: 0 19px;
        border-radius: 9px;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: background 0.15s ease, border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
    }

    .ap-btn-ghost {
        background: #ffffff;
        border: 1.5px solid var(--line);
        color: var(--ink);
    }

        .ap-btn-ghost:hover {
            background: #f7f9fa;
            border-color: #ccd5da;
            color: var(--ink);
        }

    .ap-btn-primary {
        border: 1.5px solid var(--teal-700);
        background: var(--teal-700);
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(15, 92, 102, 0.20);
    }

        .ap-btn-primary:hover {
            background: var(--teal-800);
            border-color: var(--teal-800);
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(15, 92, 102, 0.24);
        }

    /* =====================================================
           RESPONSIVE
        ===================================================== */

    @@media (max-width: 700px) {

        .ap-page {
            padding: 20px 12px 40px;
        }

        .ap-form-header,
        .ap-form-body,
        .ap-form-footer {
            padding-left: 20px;
            padding-right: 20px;
        }

        .ap-field-grid {
            grid-template-columns: 1fr;
            gap: 18px;
        }

        .ap-form-footer {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .ap-btn {
            width: 100%;
        }
    }

    
</style>

<div class="ap-page">

  
    <div class="ap-container">

        <form asp-action="AddProduct"
              method="post"
              enctype="multipart/form-data">

            <div class="ap-form-card">

                <!-- =================================================
                 HEADER
            ================================================== -->

                <div class="ap-form-header">

                    <h1 class="ap-form-title">
                        <i class="fas fa-screwdriver-wrench"></i>
                        Add Service Product
                    </h1>

                    <p class="ap-form-sub">
                        Enter the product details and service information for the product you are going to service.
                    </p>

                </div>


                <!-- =================================================
                 BODY
            ================================================== -->

                <div class="ap-form-body">


                    <!-- =================================================
                     PRODUCT INFORMATION
                ================================================== -->

                    <div class="ap-section">

                        <div class="ap-section-heading">

                            <i class="fas fa-box"></i>

                            <span>Product Information</span>

                        </div>


                        <!-- Category / Subcategory -->

