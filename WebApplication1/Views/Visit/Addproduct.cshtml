@using HoossH_Services.Models
@model AddProductViewModel
@{
    ViewBag.Title = "Add Product";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
}

<style>
    .bg-light-gray {
        background-color: #f8f9fa;
    }

    .card {
        border: none;
        box-shadow: 0 0.125rem 0.25rem rgba(0,0,0,0.075);
        border-radius: 0.5rem;
    }

    .border-dashed {
        border: 2px dashed #dee2e6;
        border-radius: 0.5rem;
        background-color: #f8f9fa;
        cursor: pointer;
    }

    .editor-toolbar {
        border: 1px solid #ced4da;
        border-bottom: none;
        border-radius: 0.375rem 0.375rem 0 0;
        background-color: #fff;
        padding: 0.5rem;
    }

    .editor-textarea {
        border-radius: 0 0 0.375rem 0.375rem;
    }

    .form-label {
        font-weight: 600;
        color: #495057;
        font-size: 0.9rem;
    }

    .card-header-title {
        font-weight: 700;
        color: #343a40;
        font-size: 1.1rem;
    }
</style>

<script>
    window.showPremiumAlert = function(message) {
        message = message || 'This feature requires premium';
        try {
            if (typeof Swal !== 'undefined' && typeof Swal.fire === 'function') {
                Swal.fire({
                    icon: 'info',
                    title: 'Premium Feature',
                    text: message
                });
                return;
            }
        } catch (e) { }
        alert(message);
    };
</script>

<div class="container-fluid bg-light-gray py-4">
    <form asp-action="AddProduct" method="post" enctype="multipart/form-data">

        <div class="row">
            <!-- LEFT COLUMN -->
            <div class="col-lg-8">
                <div class="card mb-4 p-4">
                    <div class="mb-4">
                        <label asp-for="Name" class="form-label">Product Title</label>
                        <input asp-for="Name" class="form-control" value="Urban Ladder Pashe Chair" />
                        <span asp-validation-for="Name" class="text-danger"></span>
                    </div>

                    <div>
                        <label asp-for="Description" class="form-label">Product Description</label>
                        <div class="editor-toolbar d-flex align-items-center gap-2">
                            <select class="form-select form-select-sm w-auto border-0 bg-light"><option>Normal text</option></select>
                            <div class="vr mx-1"></div>
                            <button type="button" class="btn btn-sm btn-light fw-bold">B</button>
                            <button type="button" class="btn btn-sm btn-light fst-italic">I</button>
                            <button type="button" class="btn btn-sm btn-light text-decoration-underline">U</button>
                        </div>
                        <textarea asp-for="Description" class="form-control editor-textarea" rows="6">Tommy Hilfiger men striped pink sweatshirt... (Dummy text)</textarea>
                        <span asp-validation-for="Description" class="text-danger"></span>
                    </div>
                </div>

                <div class="card mb-4 p-4">
                    <h5 class="card-header-title mb-4">Product Images <i class="bi bi-info-circle text-muted fs-6"></i></h5>

                    <div class="row">
                        <div class="col-md-4">
                            <label class="form-label">Product Image</label>
                            <div class="border rounded p-2 text-center bg-light" style="height: 150px; display: flex; align-items: center; justify-content: center;">
                                <input asp-for="MainImage" type="file" class="form-control d-none" id="mainImageUpload" />
                                <label for="mainImageUpload" class="btn btn-light btn-sm"><i class="bi bi-image"></i> Upload</label>
                            </div>
                        </div>

                        <div class="col-md-8">
                            <label class="form-label">Product Gallery</label>
                            <div class="border-dashed p-4 text-center h-100 d-flex flex-column justify-content-center">
                                <i class="bi bi-cloud-upload fs-3 text-primary mb-2"></i>
                                <input asp-for="GalleryImages" type="file" multiple class="form-control d-none" id="galleryUpload" />
                                <label for="galleryUpload" style="cursor:pointer;" class="mb-0">
                                    <span class="text-primary fw-semibold">Click to upload</span> or drag and drop
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-lg-4">
                <div class="card mb-4 p-4">
                    <h5 class="card-header-title mb-4">Product Categories</h5>

                    <div class="mb-3">
                        <label class="form-label mb-0">Product Categories</label>
                        <select asp-for="CategoryId" class="form-select">
                            <option value="1" selected>Fashion</option>
                            <option value="2">Furniture</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label mb-0">Product SubCategories</label>
                        <select asp-for="SubCategoryId" class="form-select">
                            <option value="1" selected>Men's Clothing</option>
                            <option value="2">Women's Clothing</option>
                        </select>
                    </div>
                </div>

                <div class="card mb-4 p-4">
                    <h5 class="card-header-title mb-4">Product Short Description</h5>
                    <!-- ✅ FIXED: Added asp-for="ShortDescription" -->
                    <textarea asp-for="ShortDescription" class="form-control" rows="4">This stylish chair is the perfect addition...</textarea>
                </div>

                <div class="card mb-4 p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <label class="form-label mb-0">Is it Refundable</label>
                        <div class="form-check form-switch">
                            <input asp-for="IsRefundable" class="form-check-input" type="checkbox" role="switch" checked>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <div class="d-flex justify-content-end gap-2 mb-5">
            <button type="submit" class="btn btn-primary px-4">Save Product</button>
        </div>

    </form>
</div>