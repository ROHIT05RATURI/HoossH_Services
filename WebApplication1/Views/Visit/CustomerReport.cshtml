    window.toggleSection = function(contentId, headerElement, chartId, isFunnel = false) {
    var content = document.getElementById(contentId);
    var isActive = content.classList.contains('active');

    document.querySelectorAll('.collapsible-content').forEach(function(el) { el.classList.remove('active'); });
    document.querySelectorAll('.collapsible-header').forEach(function(el) {
    el.classList.remove('active');
    el.querySelector('.chevron-icon').style.transform = 'rotate(0deg)';
    });

    if (!isActive) {
    content.classList.add('active');
    headerElement.classList.add('active');
    headerElement.querySelector('.chevron-icon').style.transform = 'rotate(180deg)';

    setTimeout(() => {
    const navOffset = -80;
    const y = headerElement.getBoundingClientRect().top + window.scrollY + navOffset;
    window.scrollTo({top: y, behavior: 'smooth'});
    }, 150);

    if(chartId) {
    setTimeout(() => {
    if(!myCharts[chartId]) {
    initChart(chartId);
    } else {
    myCharts[chartId].resize();
    myCharts[chartId].update();
    }
    }, 200);
    }

    if(isFunnel && funnelTanks.length > 0) { setTimeout(() => { funnelTanks.forEach(tank => tank.resize()); }, 300); }
    }
    }

    // --- LIQUID PHYSICS ---
    class WaterTank {
    constructor(canvasId, fillPercent, colorConfig, isHorizontal = false) {
    this.canvas = document.getElementById(canvasId); if(!this.canvas) return;
    this.ctx = this.canvas.getContext('2d'); this.fillPercent = fillPercent; this.color = colorConfig; this.isHorizontal = isHorizontal;
    this.totalPoints = 30; this.points = []; this.baseHeight = 0; this.currentHeight = 0; this.tilt = 0; this.phase = Math.random() * Math.PI * 2; this.waveSpeed = 0.05; this.waveFrequency = 0.015; this.waveAmplitude = 3;
    window.addEventListener('resize', () => this.resize()); this.resize(); this.animate();
    }
    resize() {
    this.canvas.width = this.canvas.parentElement.offsetWidth; this.canvas.height = this.canvas.parentElement.offsetHeight;
    this.baseHeight = this.canvas.height * (1 - this.fillPercent / 100);
    if(this.points.length === 0 || this.currentHeight === 0) {
    this.currentHeight = this.canvas.height; this.points = [];
    for (let i = 0; i <= this.totalPoints; i++) this.points.push({ x: (this.canvas.width / this.totalPoints) * i, y: this.baseHeight, vy: 0 });
    } else { for (let i = 0; i <= this.totalPoints; i++) this.points[i].x = (this.canvas.width / this.totalPoints) * i; }
    }
    splash(force, clickX) {
    let closestIndex = Math.floor((clickX / this.canvas.width) * this.totalPoints);
    for (let i = 0; i <= this.totalPoints; i++) { let dist = Math.abs(i - closestIndex); if (dist < 6) this.points[i].vy += force * (1 - (dist * 0.15)); }
    }
    update() {
    this.currentHeight += (this.baseHeight - this.currentHeight) * 0.05; this.phase += this.waveSpeed; const spring = 0.03, damping = 0.95, spread = 0.15;
    for (let i = 0; i <= this.totalPoints; i++) { let p = this.points[i]; let targetY = this.currentHeight + ((i - this.totalPoints/2) * this.tilt) + Math.sin(p.x * this.waveFrequency + this.phase) * this.waveAmplitude; p.vy += (targetY - p.y) * spring; p.y += p.vy; p.vy *= damping; }
    let leftDeltas = new Array(this.totalPoints + 1).fill(0), rightDeltas = new Array(this.totalPoints + 1).fill(0);
    for (let j = 0; j < 3; j++) {
    for (let i = 0; i <= this.totalPoints; i++) { if (i > 0) { leftDeltas[i] = spread * (this.points[i].y - this.points[i-1].y); this.points[i-1].vy += leftDeltas[i] * 0.05; } if (i < this.totalPoints) { rightDeltas[i] = spread * (this.points[i].y - this.points[i+1].y); this.points[i+1].vy += rightDeltas[i] * 0.05; } }
    for (let i = 0; i <= this.totalPoints; i++) { if (i > 0) this.points[i-1].y += leftDeltas[i]; if (i < this.totalPoints) this.points[i+1].y += rightDeltas[i]; }
    }
    }
    drawPath(phaseShift, alpha) {
    this.ctx.globalAlpha = alpha; this.ctx.beginPath(); this.ctx.moveTo(0, this.canvas.height); this.ctx.lineTo(this.points[0].x, this.points[0].y + Math.sin(this.points[0].x * this.waveFrequency + this.phase + phaseShift) * (phaseShift ? 4 : 0));
    for (let i = 1; i <= this.totalPoints; i++) { let p0 = this.points[i-1], p1 = this.points[i]; let y0 = p0.y + Math.sin(p0.x * this.waveFrequency + this.phase + phaseShift) * (phaseShift ? 4 : 0); let y1 = p1.y + Math.sin(p1.x * this.waveFrequency + this.phase + phaseShift) * (phaseShift ? 4 : 0); this.ctx.quadraticCurveTo(p0.x, y0, (p0.x + p1.x) / 2, (y0 + y1) / 2); }
    this.ctx.lineTo(this.canvas.width, this.canvas.height); this.ctx.closePath(); this.ctx.fill(); this.ctx.globalAlpha = 1.0;
    }
    draw() {
    this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height); let gradient;
    if (this.isHorizontal) { gradient = this.ctx.createLinearGradient(0, 0, this.canvas.width, 0); } else { gradient = this.ctx.createLinearGradient(0, 0, 0, this.canvas.height); }
    gradient.addColorStop(0, this.color.start); gradient.addColorStop(1, this.color.end); this.ctx.fillStyle = gradient;
    this.drawPath(Math.PI, 0.4); this.drawPath(0, 1.0);
    }
    animate() { this.update(); this.draw(); requestAnimationFrame(() => this.animate()); }
    }

    function getTankColor(percent) {
    if (percent >= 80) { return { start: 'rgb(16 185 129)', end: 'rgb(16 185 129)' }; }
    else if (percent >= 60) { return { start: 'rgba(163, 230, 53, 0.6)', end: 'rgba(101, 163, 13, 0.4)' }; }
    else if (percent >= 40) { return { start: 'rgba(250, 204, 21, 0.6)', end: 'rgba(202, 138, 4, 0.4)' }; }
    else if (percent >= 20) { return { start: 'rgba(249, 115, 22, 0.6)', end: 'rgba(194, 65, 12, 0.4)' }; }
    else { return { start: 'rgba(239, 68, 68, 0.6)', end: 'rgba(185, 28, 28, 0.4)' }; }
    }



