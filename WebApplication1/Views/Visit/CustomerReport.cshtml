<script src="https://ajax.googleapis.com/ajax/libs/jquery/1.12.4/jquery.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chart.js@3.9.1/dist/chart.min.js"></script>

<script>
    // Checking visibility flag
    document.addEventListener("DOMContentLoaded", function () {
    let el = document.getElementById("checked");
    if (!el) return;

    let valueforhiddingdiv = "@(Model?.value ?? "False")";
    el.style.display = valueforhiddingdiv === "True" ? "none" : "flex";
    });

    const colorMainTheme = '#3f6791'; const colorAmber = '#f59e0b'; const colorBlue = '#3b82f6'; const colorOceanBlue = '#0284c7'; const colorLightBlue = '#38bdf8'; const colorEmerald = '#10b981'; const colorRose = '#e11d48';

    const rawLabels = @Html.Raw(JsonSerializer.Serialize(Model.MonthLabels ?? new List<string>()));
    const rawSales = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySales ?? new List<long>()));
    const rawSalesValue = @Html.Raw(JsonSerializer.Serialize(Model.MonthlySalesValues ?? new List<long>()));

    const rawEnq = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyEnquiries ?? new List<int>()));
    const rawEnqValue = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyEnquiriesVlaues ?? new List<long>()));

    const rawQual = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyQualifiedLeads ?? new List<int>()));
    const rawleadvalue = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyQualifiedLeadsValues ?? new List<long>()));

    const rawPros = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyProspects ?? new List<int>()));
    const rawClient = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyClients ?? new List<int>()));
    const rawInc = @Html.Raw(JsonSerializer.Serialize(Model.MonthlyIncentives ?? new List<long>()));
    const rawPayRec = @Html.Raw(JsonSerializer.Serialize(Model.PaymentsReceived ?? new List<long>()));
    const rawPayPend = @Html.Raw(JsonSerializer.Serialize(Model.PaymentsPending ?? new List<long>()));
    const funnelData = @Html.Raw(JsonSerializer.Serialize(Model.FunnelMetrics));

    const allLabels = rawLabels.length > 0 ? rawLabels : ['M1', 'M2', 'M3', 'M4', 'M5', 'M6'];

    const get6m = (arr) => arr ? arr.slice(-6) : [];

    const currentMonth = new Date().getMonth() + 1; // 1–12
    const currentIndex = (currentMonth - 4 + 12) % 12;

    // 🔥 FIXED: Safer Last 6 Months Logic
    const getLast6Months = (arr, currentIndex) => {
    if (!arr || arr.length === 0) return [];
    // Agar array choti hai (jaise abhi start hui hai), to normal slice karlo
    if(arr.length < 12) return arr.slice(-6);

    const result = [];
    for (let i = 5; i >= 0; i--) {
    const index = (currentIndex - i + 12) % 12;
    result.push(arr[index] !== undefined ? arr[index] : 0);
    }
    return result;
    };

    // 🔥 FIXED: Leads aur Enquiries ke Data Mappings yahan Swap the. Ab theek kar diya hai.
    const chartDataRepo = {
    labels: { all: allLabels, '6m': getLast6Months(allLabels, currentIndex) },
    monthlySalesGridChart: {
    count: { all: rawSales, '6m': getLast6Months(rawSales, currentIndex) },
    value: { all: rawSalesValue, '6m': getLast6Months(rawSalesValue, currentIndex) }
    },
    leadsChart : {
    count: { all: rawQual, '6m': getLast6Months(rawQual, currentIndex) },
    value: { all: rawleadvalue, '6m': getLast6Months(rawleadvalue, currentIndex) }
    },
    enquiriesChart :{
    count: { all: rawEnq, '6m': getLast6Months(rawEnq, currentIndex) },
    value: { all: rawEnqValue, '6m': getLast6Months(rawEnqValue, currentIndex) }
    },
    chart3: { all: rawInc, '6m': get6m(rawInc) },
    paymentChart: {
    received: { all: rawPayRec, '6m': getLast6Months(rawPayRec, currentIndex) },
    pending: { all: rawPayPend, '6m': getLast6Months(rawPayPend, currentIndex) }
    },
    };

    const basePolarColors = ['#f43f5e', '#f59e0b', '#10b981', '#3b82f6', '#8b5cf6', '#ec4899'];
    const polarColors = { all: [...basePolarColors, ...basePolarColors], '6m': basePolarColors };

    let myCharts = {};
    let funnelTanks = [];

    const customTooltip = {
    backgroundColor: 'rgba(255, 255, 255, 0.95)',
    titleColor: '#64748b',
    bodyColor: '#1e293b',
    padding: 12,
    cornerRadius: 8,
    borderColor: '#e2e8f0',
    borderWidth: 1,
    callbacks: {
    label: function (context) {
    const dataset = context.dataset;
    const index = context.dataIndex;

    if (dataset.extraData && dataset.extraData.prospect) {
    let client = dataset.extraData.client[index] || 0;
    let prospect = dataset.extraData.prospect[index] || 0;
    let conversion = prospect ? ((client / prospect) * 100).toFixed(1) : 0;
    return [`Clients: ${client}`, `Prospects: ${prospect}`, `Conversion: ${conversion}%`];
    }

    if (dataset.extraData) {
    let count = context.raw || 0;
    let value = dataset.extraData[index] || 0;
    return `${dataset.label}: ${count} | ₹ ${value.toLocaleString('en-IN')}`;
    }

    return `${dataset.label}: ${context.raw}`;
    }
    }
    };

