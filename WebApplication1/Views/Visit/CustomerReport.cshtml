    else if (chartId === 'monthlySalesGridChart') {
    myCharts[chartId] = new Chart(ctx, { type: 'bar', data: { labels: chartDataRepo.labels[filter], datasets: [{ label: 'Sales', data: chartDataRepo.monthlySalesGridChart.value[filter] , backgroundColor: colorEmerald, borderRadius: 4,  extraData: chartDataRepo.monthlySalesGridChart.count[filter] }] }, options: cOptions });
    }
    else if (chartId === 'leadsChart') {
    myCharts[chartId] = new Chart(ctx, { type: 'bar', data: { labels: chartDataRepo.labels[filter], datasets: [{ label: 'Leads', data: chartDataRepo.leadsChart.value[filter], backgroundColor: colorEmerald, borderRadius: 4,  extraData: chartDataRepo.leadsChart.count[filter]  }] }, options: cOptions });
    }
    else if (chartId === 'enquiriesChart') {
    myCharts[chartId] = new Chart(ctx, { type: 'bar', data: { labels: chartDataRepo.labels[filter], datasets: [{ label: 'Enquiries', data:chartDataRepo.enquiriesChart.value[filter]  , backgroundColor: colorEmerald, borderRadius: 4,  extraData: chartDataRepo.enquiriesChart.count[filter] }] }, options: cOptions });
    }
    else if (chartId === 'paymentChart') {
    myCharts[chartId] = new Chart(ctx, { type: 'bar', data: { labels: chartDataRepo.labels[filter], datasets: [ { label: 'Received', data: chartDataRepo.paymentChart.received[filter], backgroundColor: colorEmerald, borderRadius: { topLeft: 6, topRight: 6 } }, { label: 'Pending', data: chartDataRepo.paymentChart.pending[filter], backgroundColor: colorRose, borderRadius: { bottomLeft: 6, bottomRight: 6 } } ]}, options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false }, tooltip: customTooltip }, scales: { x: { stacked: true, grid: { display: false } }, y: { stacked: true, ...yAxisConfigWithValues } } } });
    }
    } catch(e) { console.error("Chart Init Error:", e); }
