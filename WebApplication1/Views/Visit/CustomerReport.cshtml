    function GotoMeetingPage(elementValue) {
    const selectedValue = elementValue.value;
    const role = '@role';
    const customerId = '@customerid';

    if (!selectedValue || selectedValue === "Back") return;

    const roleRoutes = routeConfig[role];

    if (!roleRoutes) {
    console.warn("Unknown role:", role);
    return;
    }

    const baseUrl = roleRoutes[selectedValue];

    if (!baseUrl) {
    console.warn("No route mapped for:", selectedValue);
    return;
    }

    window.location.href = `${baseUrl}?CustomerId=${customerId}`;
    }

