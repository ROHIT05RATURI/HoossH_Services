    .success-icon-wrapper {
        width: 85px;
        height: 85px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        margin: 0 auto 20px auto;
        position: relative;
        z-index: 1;
        animation: successPulse 2s infinite ease-in-out;
    }

        .success-icon-wrapper.checkin {
            background: linear-gradient(135deg, #10b981 0%, #059669 100%);
            color: white;
            box-shadow: 0 10px 25px -5px rgba(16, 185, 129, 0.4), 0 0 0 12px rgba(16, 185, 129, 0.1);
