<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/js/geolocation.js"></script>

<script>
  
    let vIsMenuOpen = false;

    $(document).ready(function() {
        vRenderTimeline(vBackendData);

        $(document).click(function(e) {
            if (!$(e.target).closest('#v-clientSelectWrapper').length) {
                $('#v-clientDropdown').hide();
            }
            if (!$(e.target).closest('.v-floating-action-menu').length && vIsMenuOpen) {
                vToggleFabMenu();
            }
        });
    });

    function vToggleFabMenu() {
        vIsMenuOpen = !vIsMenuOpen;
        if (vIsMenuOpen) {
            $('#v-fabMenu').addClass('v-open');
            $('#v-mainFabBtn').html('<i class="fas fa-times"></i>');
        } else {
            $('#v-fabMenu').removeClass('v-open');
            $('#v-mainFabBtn').html('<i class="fas fa-layer-group"></i>');
        }
    }

    function vRenderTimeline(routes) {
        const container = $("#v-routeListContainer");
        container.empty();

        if (!routes || routes.length === 0) {
            container.html(`
                            <div style="display: flex; flex-direction: column; justify-content: center; height: 100%; margin-top: 20px;">
                                <div class="v-card-route v-card-cta" style="margin: auto; width: 85%;">
                                    <div class="v-cta-text">No operations scheduled today.</div>
                                    <button class="v-btn-set-appointment" onclick="vOpenAppointmentModal('', '')">
                                        <i class="fas fa-plus"></i> Set Appointment
                                    </button>
                                </div>
                            </div>`);
            return;
        }

        routes.sort((a, b) => {
            const getWeight = (status) => {
                const s = (status || '').trim().toUpperCase();
                if (s === 'ONGOING') return 1;
                if (s === 'COMPLETED') return 3;
                return 2;
            };
            return getWeight(a.status) - getWeight(b.status);
        });

        const hasOngoing = routes.some(r => (r.status || '').trim().toUpperCase() === 'ONGOING');

        routes.forEach((x, i) => {
            const status = (x.status || '').trim().toUpperCase();
            const isVisited = status === 'COMPLETED';
            const isOngoing = status === 'ONGOING';

            const priority = (x.Priority || "COLD").toUpperCase();
            let badgeText = "COLD", badgeClass = "v-badge-cold", pColor = "var(--p-cold)", pIcon = "fa-snowflake";

            if (priority === "HOT") { badgeText = "HOT"; badgeClass = "v-badge-hot"; pColor = "var(--p-hot)"; pIcon = "fa-fire"; }
            else if (priority === "MODERATE") { badgeText = "MODERATE"; badgeClass = "v-badge-moderate"; pColor = "var(--p-mod)"; pIcon = "fa-bolt"; }

            const rawName = x.customerName || x.CustomerName || 'N/A';
            const indVal = x.industry || x.Industry || x.industryType || x.IndustryType || '';
            const displayCustName = (indVal && indVal.toString().trim() !== '') ? `${rawName} (${indVal})` : rawName;

            const safeName = displayCustName.replace(/'/g, "\\'");
            const safeArea = x.Area ? x.Area.replace(/'/g, "\\'") : '';
            const safeLat = x.Latitude || x.latitude || '';
            const safeLng = x.Longitude || x.longitude || '';

            let btnDisabled = false;
            let btnIcon = 'fa-location-arrow';
            let btnText = 'Check-In';
            let btnBg = 'var(--primary)';
            let btnOnClick = `onclick="event.stopPropagation(); vPerformCheckIn('${safeName}', ${i})"`;

            if (isVisited) {
                btnDisabled = true;
                btnIcon = 'fa-check';
                btnText = 'Checked-In';
                btnOnClick = '';
            } else if (isOngoing) {
                btnDisabled = true;
                btnIcon = 'fa-spinner fa-spin';
                btnText = 'Ongoing';
                btnBg = 'var(--p-mod)';
                btnOnClick = '';
            } else {
                if (hasOngoing) {
                    btnDisabled = true;
                    btnIcon = 'fa-lock';
                    btnText = 'Check-In';
                    btnBg = '#94a3b8';
                    btnOnClick = '';
                }
            }

            let cardOnClickAttr = '';
            let cardCursorStyle = 'cursor: default;';

            if (!isVisited && !isOngoing) {
                cardOnClickAttr = `onclick="vPromptNextVisit('${x.RouteID}', '${safeName}')"`;
                cardCursorStyle = 'cursor: pointer;';
            }

            const card = `
                            <div class="v-location-step animate__animated animate__fadeInUp" style="animation-delay: ${i * 0.1}s">
                                <div class="v-card-route ${isVisited ? 'v-card-visited' : ''}" style="${cardCursorStyle}" ${cardOnClickAttr}>
                                    <div class="v-card-floating-pin" style="color: ${pColor}; cursor: pointer;" onclick="event.stopPropagation(); vOpenDirections('${safeName}', '${safeArea}', '${safeLat}', '${safeLng}')">
                                        <i class="fa-solid fa-location-dot"></i>
                                    </div>
                                    <div class="v-priority-badge ${badgeClass}"><i class="fa-solid ${pIcon}"></i> ${badgeText}</div>

                                    <div class="v-loc-content-wrapper">
                                        <span class="v-loc-name">${displayCustName}</span>
                                        <div class="v-loc-meta">
                                            <span><i class="fas fa-clock text-primary"></i> ${x.AppointmentTime || '--:--'}</span>
                                            <span><i class="fas fa-user-tie"></i> ${x.ContactPerson || 'N/A'}</span>
                                        </div>
                                        <div class="v-loc-stats">
                                            <span><b>Visits:</b> ${x.TotalVisit || 0}</span>
                                            <span><b>Sales:</b> ₹${x.SalesAmount || 0}</span>
                                        </div>
                                    </div>

                                    <div class="v-btn-checkin-container">
                                        <input type="hidden" id="v-cid_${i}" value="${x.customerid}" />
                                        <input type="hidden" id="v-prio_${i}" value="${x.Priority}" />
                                        <input type="hidden" id="v-route_${i}" value="${x.RouteID}" />
                                        <button
                                            type="button"
                                            id="v-btn_${i}"
                                            class="v-btnaction"
                                            style="background: ${btnBg}"
                                            ${btnDisabled ? 'disabled' : btnOnClick}>
                                            <i class="fa-solid ${btnIcon}"></i>
                                            ${btnText}
                                        </button>
                                    </div>
                                </div>
                                <svg class="v-connector" viewBox="0 0 100 100" preserveAspectRatio="none">
                                    <path class="v-snake-path" d="${i % 2 === 0 ? 'M 25,0 C 25,50 75,50 75,100' : 'M 75,0 C 75,50 25,50 25,100'}" />
                                </svg>
                            </div>`;
            container.append(card);
        });

        container.append(`
                        <div class="v-location-step animate__animated animate__fadeInUp" style="animation-delay: ${routes.length * 0.1}s">
                            <div class="v-card-route v-card-cta">
                                <div class="v-cta-text">Grow your route trail!</div>
                                <button class="v-btn-set-appointment" onclick="vOpenAppointmentModal('', '')">
                                    <i class="fas fa-plus"></i> Add More
                                </button>
                            </div>
                        </div>`);
    }
    let activeCheckIn = { custName: '', id: '', cid: '', prio: '', routeid: '' };

    function openCustomPopup(action, custName) {
        const now = new Date();
        const currentTime = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const popup = document.getElementById("customPopupModal");
        const card = popup.querySelector(".popup-content-card");
        const dynamicIcon = document.getElementById("dynamicIcon");
        const badge = document.getElementById("popupBadge");
        const title = document.getElementById("popupTitle");
        const timeText = document.getElementById("popupTime");
        const subText = document.getElementById("popupSubText");
        const actionBtnText = popup.querySelector(".btn-3d-text");

        card.classList.remove("animate__bounceIn", "animate__bounceOut");
        timeText.innerHTML = `Time: <b>${currentTime}</b>`;
        popup.classList.add("active");
        card.classList.add("animate__bounceIn");

        title.innerText = 'Confirm Check-In';
        subText.innerText = `Start your visit at ${custName}`;
        dynamicIcon.innerHTML = `<i class="fas fa-location-dot" style="font-size: 65px; color: #3f6791; filter: drop-shadow(0 8px 10px rgba(63, 103, 145, 0.3));"></i>`;
        actionBtnText.innerText = 'Yes, Check-In';
        badge.style.display = "none";
    }

    function closeCustomPopup() {
        const popup = document.getElementById("customPopupModal");
        const card = popup.querySelector(".popup-content-card");

        card.classList.remove("animate__bounceIn");
        card.classList.add("animate__bounceOut");

        setTimeout(() => {
            popup.classList.remove("active");
        }, 400);
    }

    async function confirmPopupAction() {
        closeCustomPopup();

        const now = new Date();
        const currentTime = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });

        const id = activeCheckIn.id;
        const btn = $(`#v-btn_${id}`);
        btn.html('<i class="fa-solid fa-spinner fa-spin"></i>').prop('disabled', true);

        try {
            await vGetLocation();
            const loc = $('#v-CurrLoc').val();

            if (!loc) {
                btn.html('<i class="fa-solid fa-location-arrow"></i> Check-In').prop('disabled', false);
                return;
            }

            $.post("/Flow/SaveDailyDetails", {
                CustomerName: activeCheckIn.custName,
                customerid: activeCheckIn.cid,
                CurrentLocation: loc,
                Priority: activeCheckIn.prio,
                RouteId: activeCheckIn.routeid
            }, function(res) {
                if (res.status) {
                    const successModal = document.getElementById("customSuccessModal");
                    const successCard = document.getElementById("successCard");
                    const successIconWrapper = document.getElementById("successIconWrapper");
                    const successIcon = document.getElementById("successIcon");
                    const successTitle = document.getElementById("successTitle");
                    const successTime = document.getElementById("successTime");

                    successCard.classList.remove("animate__zoomIn", "animate__zoomOut");

                    successTitle.innerText = "Checked-In! 🌟";
                    successIconWrapper.className = "success-icon-wrapper checkin";
                    successIcon.className = "fas fa-check";
                    successTime.innerText = `Time: ${currentTime}`;

                    successModal.classList.add("active");
                    successCard.classList.add("animate__zoomIn");

                    btn.html('<i class="fa-solid fa-check"></i> Checked-In').css('background', '#94a3b8');

                    setTimeout(() => {
                        successCard.classList.remove("animate__zoomIn");
                        successCard.classList.add("animate__zoomOut");

                        setTimeout(() => {
                            window.location.href = "/Flow/CustomerReport?Id=" + encodeURIComponent(activeCheckIn.cid);
                        }, 400);

                    }, 2000);
                } else {
                    Swal.fire({ icon: 'error', text: res.message });
                    btn.html('<i class="fa-solid fa-location-arrow"></i> Check-In').prop('disabled', false);
                }
            }).fail(() => {
                Swal.fire({ icon: 'error', text: "Server Error" });
                btn.html('<i class="fa-solid fa-location-arrow"></i> Check-In').prop('disabled', false);
            });
        } catch (e) {
            btn.html('<i class="fa-solid fa-location-arrow"></i> Check-In').prop('disabled', false);
        }
    }

    async function vPerformCheckIn(custName, id) {
        activeCheckIn.custName = custName;
        activeCheckIn.id = id;
        activeCheckIn.cid = $(`#v-cid_${id}`).val();
        activeCheckIn.prio = $(`#v-prio_${id}`).val();
        activeCheckIn.routeid = $(`#v-route_${id}`).val();

        openCustomPopup('CheckIn', custName);
    }

    async function vGetLocation() {
        try {
            const location = await GeoService.getLocation();
            if (location && location.latitude) $('#v-CurrLoc').val(location.latitude + "," + location.longitude);
            else { $('#v-CurrLoc').val(""); alert("Location incomplete."); }
        } catch (e) {
            $('#v-CurrLoc').val(""); alert("Location access required.");
        }
    }

    function vOpenDirections(name, addr, lat, lng) {
        let dest = addr || name;
        if (lat && lng && lat.trim() !== '' && lng.trim() !== '') {
            dest = lat + "," + lng;
        }
        const origin = $('#v-CurrLoc').val();
        let url = "https://www.google.com/maps/dir/?api=1&destination=" + encodeURIComponent(dest);
        if (origin) url += "&origin=" + encodeURIComponent(origin);
        window.open(url, '_blank');
    }

    function vPromptNextVisit(id, name) {
        Swal.fire({
            title: `<span style="font-size: 16px; font-weight:800;">${name}</span>`,
            html: `
                        <div style="font-size: 13px; font-weight: 700; color: #64748b; margin-bottom: 12px;">Select Next Visit:</div>
                        <div style="position: relative; display: flex; align-items: center;">
                            <i class="fas fa-calendar-alt" style="position: absolute; left: 15px; color: var(--primary);"></i>
                            <input type="datetime-local" id="v-swalDate" style="width: 100%; padding: 12px 15px 12px 40px; border: 1px solid #cbd5e1; border-radius: 12px; font-size: 14px; font-weight: 600; color: #0f172a; outline: none; box-shadow: 0 4px 6px rgba(0,0,0,0.02); font-family: inherit;">
                        </div>
                    `,
            showCancelButton: true,
            confirmButtonColor: 'var(--primary)',
            confirmButtonText: 'Save',
            preConfirm: () => {
                const d = $('#v-swalDate').val();
                if (!d) Swal.showValidationMessage('Date is required!');
                return d;
            }
        }).then((res) => {
            if (res.isConfirmed) {
                $('#v-mainLoader').css('display', 'flex');
                $.post("/Flow/ChangeReappointmentDate", { routeId: id, nextVisitDate: res.value }, function(data) {
                    $('#v-mainLoader').hide();
                    if (data.success || data.status) {
                        Swal.fire('Saved!', '', 'success')
                            .then(() => {
                                window.location.reload();
                            });
                    } else Swal.fire('Error', data.message || 'Failed', 'error');
                }).fail(() => {
                    $('#v-mainLoader').hide();
                    Swal.fire('Error', 'Server failed', 'error');
                });
            }
        });
    }

    function vOpenDrawer(type) {
        vToggleFabMenu();
        const drawer = $('#v-dataDrawer');
        const overlay = $('#v-drawerOverlay');
        const body = $('#v-drawerBody');
        const title = $('#v-drawerTitle');
        const dateFilterWrapper = $('#v-drawerDateWrapper'); // New Wrapper Reference
        const dateFilter = $('#v-futureDateFilter');

        drawer.addClass('v-open');
        overlay.addClass('v-open');
        body.html(`<div class="v-list-card v-shimmer" style="height: 80px;"></div><div class="v-list-card v-shimmer" style="height: 80px;"></div>`);

        dateFilter.off('change');

        if (type === 'backlog') {
            dateFilterWrapper.hide(); // Hide wrapper for backlog
            title.html('<i class="fas fa-history text-danger"></i> Pending Backlogs');
            vFetchDrawerData('/Flow/GetBacklogData', 'backlog');
        } else {
            dateFilterWrapper.css('display', 'flex'); // Show wrapper with flex for future logs

            const defaultDate = $('#v-SelectedDate').val();
            dateFilter.val(defaultDate);

            title.html('<i class="fas fa-calendar-alt text-primary"></i> Future Logs');
            vFetchDrawerData('/Flow/GetFutureLogsData?searchDate=' + defaultDate, 'future');

            dateFilter.on('change', function() {
                const selectedDate = $(this).val();
                if (selectedDate) {
                    body.html(`<div class="v-list-card v-shimmer" style="height: 80px;"></div><div class="v-list-card v-shimmer" style="height: 80px;"></div>`);
                    vFetchDrawerData('/Flow/GetFutureLogsData?searchDate=' + selectedDate, 'future');
                }
            });
        }
    }

    function vCloseDrawer() {
        $('#v-dataDrawer').removeClass('v-open');
        $('#v-drawerOverlay').removeClass('v-open');
    }

    function formatDate(dateString) {
        if (!dateString) return "-";
        const date = new Date(dateString);
        return date.toLocaleDateString('en-IN', {
            day: '2-digit',
            month: 'short',
            year: 'numeric'
        });
    }

    function vFetchDrawerData(url, type) {
        $.get(url, function(res) {
            const body = $('#v-drawerBody');
            body.empty();
            let arr = res.data || res;
            if (typeof arr === 'string') arr = JSON.parse(arr);

            if (!arr || arr.length === 0) {
                body.html(`<div style="text-align:center; padding: 40px 20px; color: var(--txt-light); font-weight:700;">No records found.</div>`);
                return;
            }

            arr.forEach(item => {
                let rawName = item.CustomerName || item.customerName || item.organizationName || 'Unknown';
                let indVal = item.Industry || item.industry || item.IndustryType || item.industryType || '';
                let name = (indVal && indVal.toString().trim() !== '') ? `${rawName} (${indVal})` : rawName;
                let id = item.CustomerID || item.customerid || '';
                let safeName = name.replace(/'/g, "\\'");

                let detail = "";
                let pill = "";

                if (type === 'backlog') {
                    let days = item.DueDays || item.dueDays || 0;
                    let lastvisit = formatDate(item.reAppointmentDate) || 0;
                    detail = `<i class="fas fa-calendar-times"></i>Visiting Date: ${lastvisit}`;
                    let cls = days > 15 ? 'v-st-danger' : (days > 7 ? 'v-st-warn' : 'v-st-safe');
                    pill = `<div class="v-status-pill ${cls}">${days} Days</div>`;
                } else {
                    let dStr = formatDate(item.reAppointmentDate);
                    detail = `<i class="fas fa-calendar-day"></i> Scheduled: ${dStr}`;
                    let p = (item.Priority || '').toLowerCase();
                    let cls = (p === 'hot') ? 'v-st-danger' : ((p === 'moderate') ? 'v-st-warn' : 'v-st-safe');
                    pill = `<div class="v-status-pill ${cls}">${p.toUpperCase()}</div>`;
                }

                body.append(`
                                    <div class="v-list-card animate__animated animate__fadeInRight" onclick="vTransferFromDrawer('${id}', '${safeName}')">
                                        ${pill}
                                        <div class="v-list-org">${name}</div>
                                        <div class="v-list-detail">${detail}</div>
                                    </div>
                                `);
            });
        }).fail(() => {
            $('#v-drawerBody').html(`<div style="color:red; text-align:center; padding:20px;">Failed to load data.</div>`);
        });
    }

    function vTransferFromDrawer(id, name) {
        vCloseDrawer();
        setTimeout(() => vOpenAppointmentModal(id, name), 300);
    }

    function vOpenAppointmentModal(cid, cname) {
        if (vIsMenuOpen) vToggleFabMenu();
        $('#v-appointmentModal').css('display', 'flex');
        $('#v-scheduleForm')[0].reset();
        $('#v-formDate').val($('#v-SelectedDate').val());

        if (cid && cname) vSelectClient(cid, cname);
        else {
            $('#v-formCustomerId').val('');
            $('#v-clientDisplay').text('Select a Client...').css('color', 'var(--txt-light)');
        }
    }

    function vCloseAppointmentModal() {
        $('#v-appointmentModal').hide();
        $('#v-clientDropdown').hide();
    }

    function vToggleClientSelect() {
        $('#v-clientDropdown').toggle();
        if ($('#v-clientDropdown').is(':visible')) $('#v-clientSearch').focus();
    }

    function vFilterClients() {
        const val = $('#v-clientSearch').val().toLowerCase();
        $('.v-select-option').each(function() {
            $(this).toggle($(this).text().toLowerCase().includes(val));
        });
    }

    function vSelectClient(id, name) {
        $('#v-formCustomerId').val(id);
        $('#v-clientDisplay').text(name).css('color', 'var(--txt-dark)');
        $('#v-clientDropdown').hide();
    }

    function vSubmitAppointment() {
        const form = $('#v-scheduleForm');
        if (!form[0].checkValidity() || !$('#v-formCustomerId').val()) {
            Swal.fire('Required', 'Please select a client and time.', 'warning');
            return;
        }

        $('#v-mainLoader').css('display', 'flex');
        $.post("/Flow/AddRoute", form.serialize(), function(res) {
            $('#v-mainLoader').hide();
            vCloseAppointmentModal();
            Swal.fire({ icon: 'success', title: 'Scheduled!', showConfirmButton: false, timer: 1500 });

            setTimeout(() => location.reload(), 1500);
        }).fail(() => {
            $('#v-mainLoader').hide();
            Swal.fire('Error', 'Failed to save appointment.', 'error');
        });
    }
</script>