
@{
    ViewBag.Title = "Plan Visit";
    Layout = "~/Views/Shared/_LayoutINV.cshtml";
  
}


<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/animate.css/4.1.1/animate.min.css" />

<style>
    :root {
        --primary: #3f6791;
        --p-hot: #e11d48;
        --p-mod: #ffc107;
        --p-cold: #0077b6;
        --txt-dark: #0f172a;
        --txt-light: #64748b;
        --border-color: #e2e8f0;
        --bg-light: #f8fafc;
    }

    body {
        background-color: var(--bg-light);
        font-family: 'Plus Jakarta Sans', sans-serif;
        margin: 0;
    }

    .v-map-container {
        width: 100%;
        max-width: 450px;
        min-height: 100vh;
        padding: 20px 12px 100px 12px;
        margin: 0 auto;
        position: relative;
        background-image: radial-gradient(#e2e8f0 0.5px, transparent 0.5px);
        background-size: 15px 15px;
        display: flex;
        flex-direction: column;
    }

    .v-locations-list {
        display: flex;
        flex-direction: column;
        width: 100%;
        flex-grow: 1;
    }

    .v-location-step {
        width: 100%;
        display: flex;
        flex-direction: column;
        position: relative;
    }

        .v-location-step:nth-child(odd) {
            align-items: flex-start !important;
        }

        .v-location-step:nth-child(even) {
            align-items: flex-end !important;
        }

    .v-card-route {
        width: 78% !important;
        background: #ffffff;
        border-radius: 16px;
        padding: 12px;
        border: 1px solid #edf2f7;
        box-shadow: 0 10px 15px 4px rgba(0, 0, 0, 0.04);
        position: relative;
        z-index: 2;
        transition: all 0.3s ease;
    }

    .v-card-visited {
        background: #f1f5f9 !important;
        opacity: 0.8;
        filter: grayscale(0.5);
        border: 1px dashed #cbd5e1 !important;
        box-shadow: none !important;
    }

        .v-card-visited .v-btnaction {
            background: #94a3b8 !important;
            pointer-events: none;
        }

        .v-card-visited .v-card-floating-pin {
            animation: none !important;
            color: #94a3b8 !important;
        }

    .v-location-step:nth-child(even) .v-card-route {
        margin-left: auto !important;
    }

    .v-card-floating-pin {
        position: absolute;
        top: -15px;
        left: 15px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: white;
        box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        z-index: 3;
    }

        .v-card-floating-pin::after {
            content: "";
            position: absolute;
            width: 100%;
            height: 100%;
            border-radius: 50%;
            animation: vPinPulse 2s infinite ease-out;
        }

    @@keyframes vPinPulse {
        0% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(0, 0, 0, 0.1);
        }

        70% {
            transform: scale(1.1);
            box-shadow: 0 0 0 10px rgba(0, 0, 0, 0);
        }

        100% {
            transform: scale(1);
            box-shadow: 0 0 0 0 rgba(0, 0, 0, 0);
        }
    }

    .v-card-cta {
        background: #ffffff !important;
        border: 2px dashed #cbd5e1 !important;
        box-shadow: none !important;
        text-align: center;
        padding: 10px 0px !important;
    }

    .v-cta-text {
        font-size: 14px;
        color: #475569;
        font-weight: 700;
        margin-bottom: 15px;
        line-height: 1.4;
    }

    .v-btn-set-appointment {
        background: var(--primary);
        color: white;
        border: none;
        padding: 10px 24px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 4px 12px rgba(63, 103, 145, 0.3);
        transition: 0.2s;
    }

        .v-btn-set-appointment:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(63, 103, 145, 0.4);
        }

    .v-priority-badge {
        position: absolute;
        top: 12px;
        right: 12px;
        font-size: 8.5px;
        font-weight: 800;
        padding: 4px 10px;
        border-radius: 30px;
        display: flex;
        align-items: center;
        gap: 4px;
    }

    .v-badge-hot {
        background: #fff1f2;
        color: var(--p-hot);
        border: 1px solid #fecaca;
    }

    .v-badge-moderate {
        background: #eff6ff;
        color: var(--p-mod);
        border: 1px solid #dbeafe;
    }

    .v-badge-cold {
        background: #f0fdf4;
        color: var(--p-cold);
        border: 1px solid #d1fae5;
    }

    .v-loc-content-wrapper {
        padding-left: 5px;
        margin-top: 10px;
    }

    .v-loc-name {
        font-weight: 800;
        font-size: 11.5px;
        color: var(--txt-dark);
        display: block;
    }

    .v-loc-meta {
        font-size: 10px;
        color: #64748b;
        font-weight: 600;
        margin-top: 6px;
        display: flex;
        flex-direction: row;
        gap: 4px;
    }

    .v-loc-stats {
        font-size: 9px;
        color: #94a3b8;
        margin-top: 5px;
        display: flex;
        gap: 12px;
        border-top: 1px solid #f1f5f9;
        /* padding-top: 8px;*/
    }

    .v-btnaction {
        border: none;
        padding: 6px 14px;
        border-radius: 8px;
        font-size: 11px;
        font-weight: 800;
        color: white;
        cursor: pointer;
        transition: 0.2s;
    }

    .v-connector {
        width: 100%;
        height: 50px;
        margin: -5px 0;
        z-index: 1;
        opacity: 0.7;
    }

    .v-snake-path {
        fill: none;
        stroke: #cbd5e1;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-dasharray: 6 5;
        animation: vMarch 1s infinite linear;
    }

    @@keyframes vMarch {
        to {
            stroke-dashoffset: -11;
        }
    }

    .v-btn-checkin-container {
        display: flex;
        justify-content: end;
        margin-top: 10px;
    }

    /* =========================================
                   FAB MENU (Prefixed specifically)
                   ========================================= */
    .v-floating-action-menu {
        position: fixed;
        bottom: 100px;
        right: 30px;
        z-index: 9999;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 10px;
    }

    .v-fab-btn i {
        pointer-events: none;
    }

    .v-fab-btn {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        background: var(--primary);
        color: white;
        border: none;
        box-shadow: 0 4px 15px rgba(63, 103, 145, 0.4);
        font-size: 20px;
        cursor: pointer;
        transition: 0.3s;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .v-fab-btn:hover {
            transform: scale(1.05);
        }

    .v-fab-menu-items {
        display: none;
        flex-direction: column;
        gap: 10px;
        opacity: 0;
        visibility: hidden;
        transform: translateY(20px);
        transition: 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

        /* Changed from .active to .v-open to bypass Bootstrap */
        .v-fab-menu-items.v-open {
            opacity: 1;
            display: flex;
            visibility: visible;
            transform: translateY(0);
        }

    .v-fab-sub-btn {
        background: white;
        color: var(--txt-dark);
        border: 1px solid var(--border-color);
        padding: 10px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
        display: flex;
        align-items: center;
        gap: 8px;
        transition: 0.2s;
    }

        .v-fab-sub-btn:hover {
            background: var(--bg-light);
            color: var(--primary);
            border-color: var(--primary);
        }

    /* =========================================
                   RIGHT DRAWER (Prefixed specifically)
                   ========================================= */
    .v-right-drawer {
        position: fixed;
        top: 0;
        right: -400px;
        width: 100%;
        max-width: 400px;
        height: 100vh;
        background: white;
        z-index: 10000;
        box-shadow: -5px 0 25px rgba(0,0,0,0.1);
        transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
        display: flex;
        flex-direction: column;
    }

        .v-right-drawer.v-open {
            right: 0;
        }

    .v-drawer-header {
        padding: 20px;
        border-bottom: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--bg-light);
    }

    .v-drawer-title {
        font-size: 16px;
        font-weight: 800;
        color: var(--txt-dark);
        margin: 0;
    }

    .v-drawer-close {
        background: none;
        border: none;
        font-size: 20px;
        color: var(--txt-light);
        cursor: pointer;
    }

    .v-drawer-body {
        padding: 20px;
        overflow-y: auto;
        flex-grow: 1;
        background: #f8fafc;
    }

    .v-drawer-overlay {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(4px);
        z-index: 9999;
        display: none;
        opacity: 0;
        transition: opacity 0.3s;
    }

        .v-drawer-overlay.v-open {
            display: block;
            opacity: 1;
        }

    .v-list-card {
        background: white;
        border: 1px solid var(--border-color);
        border-radius: 12px;
        padding: 15px;
        margin-bottom: 12px;
        cursor: pointer;
        transition: 0.2s;
        position: relative;
        overflow: hidden;
    }

        .v-list-card:hover {
            border-color: var(--primary);
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(63, 103, 145, 0.1);
        }

    .v-list-org {
        font-weight: 800;
        font-size: 14px;
        color: var(--txt-dark);
        margin-bottom: 6px;
    }

    .v-list-detail {
        font-size: 12px;
        color: var(--txt-light);
        display: flex;
        align-items: center;
        gap: 6px;
    }

    .v-status-pill {
        position: absolute;
        top: 15px;
        right: 15px;
        font-size: 10px;
        font-weight: 800;
        padding: 4px 8px;
        border-radius: 6px;
    }

    .v-st-safe {
        background: #dcfce7;
        color: #166534;
    }

    .v-st-warn {
        background: #fef9c3;
        color: #854d0e;
    }

    .v-st-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    /* =========================================
                   PREMIUM MODAL (Prefixed specifically)
                   ========================================= */
    .v-premium-modal {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.6);
        backdrop-filter: blur(8px);
        z-index: 10001;
        justify-content: center;
        align-items: center;
        padding: 20px;
    }

    .v-modal-box {
        background: white;
        width: 100%;
        max-width: 450px;
        border-radius: 20px;
        padding: 30px;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
        animation: vModalPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
    }

    @@keyframes vModalPop {
        from {
            transform: scale(0.9) translateY(20px);
            opacity: 0;
        }

        to {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
    }

    .v-modal-close-btn {
        position: absolute;
        top: 20px;
        right: 20px;
        background: #f1f5f9;
        border: none;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        color: #64748b;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: 0.2s;
    }

        .v-modal-close-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }

    .v-form-group {
        margin-bottom: 20px;
    }

    .v-form-label {
        font-size: 12px;
        font-weight: 800;
        color: var(--txt-light);
        margin-bottom: 8px;
        display: block;
        text-transform: uppercase;
    }

    .v-custom-input {
        width: 100%;
        height: 45px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        padding: 10px 15px;
        font-size: 14px;
        font-weight: 500;
        outline: none;
        background: #fff;
        transition: 0.2s;
    }

        .v-custom-input:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(63, 103, 145, 0.1);
        }

    .v-priority-selector {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 10px;
    }

        .v-priority-selector input {
            display: none;
        }

    .v-p-box {
        text-align: center;
        padding: 12px;
        border-radius: 12px;
        border: 2px solid var(--border-color);
        background: var(--bg-light);
        cursor: pointer;
        transition: 0.2s;
    }

        .v-p-box i {
            font-size: 18px;
            margin-bottom: 6px;
            display: block;
        }

        .v-p-box span {
            font-size: 11px;
            font-weight: 700;
        }

    input[value="COLD"]:checked + .v-p-box {
        border-color: var(--p-cold);
        background: #f0fdf4;
        color: var(--p-cold);
    }

    input[value="MODERATE"]:checked + .v-p-box {
        border-color: var(--p-mod);
        background: #fffbeb;
        color: var(--p-mod);
    }

    input[value="HOT"]:checked + .v-p-box {
        border-color: var(--p-hot);
        background: #fff1f2;
        color: var(--p-hot);
    }

    .v-btn-submit-form {
        width: 100%;
        background: var(--primary);
        color: white;
        border: none;
        padding: 14px;
        border-radius: 12px;
        font-weight: 800;
        font-size: 14px;
        cursor: pointer;
        transition: 0.2s;
        margin-top: 10px;
    }

        .v-btn-submit-form:hover {
            background: #2c4a68;
        }

    .v-loader-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(255,255,255,0.8);
        z-index: 20000;
        justify-content: center;
        align-items: center;
        flex-direction: column;
    }

    .v-custom-select-wrapper {
        position: relative;
    }

    .v-select-display {
        height: 45px;
        border-radius: 12px;
        border: 1px solid var(--border-color);
        padding: 0 15px;
        font-size: 14px;
        font-weight: 600;
        background: #fff;
        display: flex;
        align-items: center;
        cursor: pointer;
        color: var(--txt-dark);
    }

    .v-select-dropdown {
        position: absolute;
        top: calc(100% + 5px);
        left: 0;
        width: 100%;
        background: white;
        border-radius: 12px;
        box-shadow: 0 10px 25px rgba(0,0,0,0.1);
        border: 1px solid var(--border-color);
        z-index: 100;
        display: none;
        max-height: 250px;
        overflow-y: auto;
    }

    .v-select-search {
        padding: 10px;
        position: sticky;
        top: 0;
        background: white;
        border-bottom: 1px solid var(--border-color);
    }

        .v-select-search input {
            width: 100%;
            padding: 8px 12px;
            border-radius: 8px;
            border: 1px solid var(--border-color);
            font-size: 13px;
            outline: none;
        }

    .v-select-option {
        padding: 12px 15px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        border-bottom: 1px solid #f1f5f9;
    }

        .v-select-option:hover {
            background: #f8fafc;
            color: var(--primary);
        }

    .v-shimmer {
        animation: vShimmer 2s infinite linear;
        background: linear-gradient(to right, #eff1f3 4%, #e2e8f0 25%, #eff1f3 36%);
        background-size: 1000px 100%;
    }

    @@keyframes vShimmer {
        0% {
            background-position: -1000px 0;
        }

        100% {
            background-position: 1000px 0;
        }
    }

    /* --- Custom Popup Layout (Matching Attendance) --- */
    .popup-modal-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.4);
        z-index: 10000;
        display: none;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(2px);
    }

        .popup-modal-overlay.active {
            display: flex;
        }

    .popup-content-card {
        background: #ffffff;
        width: 90%;
        max-width: 320px;
        border-radius: 30px;
        padding: 25px 20px;
        text-align: center;
        position: relative;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25);
    }

    .popup-close-btn {
        position: absolute;
        top: 15px;
        right: 15px;
        background: #f1f5f9;
        border: none;
        border-radius: 50%;
        width: 30px;
        height: 30px;
        display: flex;
        justify-content: center;
        align-items: center;
        cursor: pointer;
        transition: all 0.2s;
    }

        .popup-close-btn:hover {
            background: #eb5b3c20;
            transform: rotate(90deg);
        }

    .popup-icon-container {
        margin-top: 10px;
        margin-bottom: 20px;
        position: relative;
        display: inline-block;
    }

        .popup-icon-container img {
            width: 70px;
            height: 70px;
        }

    .popup-notif-badge {
        position: absolute;
        top: -5px;
        right: -10px;
        background: #ef4444;
        color: white;
        border-radius: 50%;
        width: 24px;
        height: 24px;
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 0.8rem;
        font-weight: 800;
        border: 3px solid white;
    }

    .premium-popup-title {
        font-size: 1.35rem;
        font-weight: 800;
        color: #1e293b;
        margin: 0;
    }

    .premium-popup-time-text {
        color: #3f6791;
        font-size: 1rem;
        margin: 8px 0;
        font-family: 'Courier New', monospace;
        background: #ebf2ff;
        display: inline-block;
        padding: 2px 10px;
        border-radius: 6px;
    }

    .premium-popup-subtext {
        color: #64748b;
        font-size: 0.85rem;
        margin: 0 0 25px 0;
    }

    .popup-action-area {
        display: flex;
        justify-content: center;
    }

    .button-3d-rendering {
        position: relative;
        background: #f1f5f9;
        border: 1.5px solid #00d09c30;
        border-radius: 50px;
        padding: 8px 18px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 15px;
        transition: all 0.2s;
        box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);
        min-width: 220px;
        justify-content: center;
    }

    .button-3d-confirm:hover {
        background: #00d09c20;
    }

    .btn-3d-text {
        color: #059669;
        font-size: 0.85rem;
        letter-spacing: 0.5px;
        text-transform: uppercase;
    }

    .btn-3d-icon-circle {
        background: #00d09c;
        border-radius: 50%;
        width: 38px;
        height: 38px;
        display: flex;
        justify-content: center;
        align-items: center;
        border: 1px solid white;
    }

    .button-3d-rendering:active {
        transform: scale(0.98);
        box-shadow: 0 2px 3px -1px rgba(0, 0, 0, 0.1);
    }

    @@media (max-width: 480px) {
        .popup-content-card {
            padding: 20px 15px;
            border-radius: 20px;
        }

        .premium-popup-title {
            font-size: 1.2rem;
        }

        .premium-popup-time-text {
            font-size: 0.9rem;
        }

        .popup-icon-container img {
            width: 60px;
            height: 60px;
        }
    }

    .custom-loader-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(4px);
        z-index: 10005;
        display: none;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

        .custom-loader-overlay.active {
            display: flex;
        }

    .spinner-circle {
        width: 50px;
        height: 50px;
        border: 4px solid #f1f5f9;
        border-top: 4px solid #00d09c;
        border-radius: 50%;
        animation: spin 1s linear infinite;
        margin-bottom: 15px;
    }

    .loader-text {
        font-family: 'Segoe UI', sans-serif;
        font-weight: 700;
        color: #1e293b;
        font-size: 1rem;
        letter-spacing: 0.5px;
        animation: pulseText 1.5s ease-in-out infinite;
    }

    @@keyframes spin {
        0% {
            transform: rotate(0deg);
        }

        100% {
            transform: rotate(360deg);
        }
    }

    @@keyframes pulseText {
        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: 0.5;
        }
    }

    .custom-success-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(15, 23, 42, 0.4);
        backdrop-filter: blur(8px);
        z-index: 10010;
        display: none;
        justify-content: center;
        align-items: center;
    }

        .custom-success-overlay.active {
            display: flex;
        }

    .success-content-card {
        background: #ffffff;
        width: 90%;
        max-width: 380px;
        border-radius: 28px;
        padding: 40px 30px;
        text-align: center;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08), 0 1px 3px rgba(0,0,0,0.05);
        border: 1px solid rgba(255, 255, 255, 0.8);
